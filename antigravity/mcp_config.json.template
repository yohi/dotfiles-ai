{
  "mcpServers": {
    "gateway": {
      "command": "docker",
      "args": [
        "mcp",
        "gateway",
        "run",
        "--enable-all-servers",
        "--catalog",
        "/home/y_ohi/.docker/mcp/catalogs/bootstrap.yaml",
        "--catalog",
        "/home/y_ohi/.docker/mcp/catalogs/custom.yaml"
      ]
    },
    "skillport": {
      "command": "uvx",
      "args": [
        "skillport-mcp"
      ],
      "env": {
        "SKILLPORT_SKILLS_DIR": "/home/y_ohi/.skillport/skills"
      }
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant"
      ]
    },
    "magic": {
      "command": "npx",
      "args": [
        "@21st-dev/magic"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  }
}
