{
  "mcpServers": {
    "gateway": {
      "command": "docker",
      "args": [
        "mcp",
        "gateway",
        "run",
        "--catalog",
        "__HOME__/.docker/mcp/catalogs/bootstrap.yaml",
        "--catalog",
        "__HOME__/.docker/mcp/catalogs/custom.yaml"
      ]
    },
    "skillport": {
      "command": "uvx",
      "args": [
        "skillport-mcp"
      ],
      "env": {
        "SKILLPORT_SKILLS_DIR": "__HOME__/.skillport/skills"
      }
    }
  }
}
