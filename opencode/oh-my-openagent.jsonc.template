{
  // Config Modernized: 2026-05-09, Target oh-my-openagent Version: v3.17.15
  // スキーマ定義：エディタでの補完とバリデーションを有効化
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/master/assets/oh-my-opencode.schema.json",
  // Team Mode: チーム開発・マルチエージェント連携 (v4.0.0 強化)
  // 【チーム開発の心臓部】
  // v4.0.0 では、複数のバックグラウンドエージェントが同一プロジェクトで動作する際の「状態の不一致」を極限まで減らすための同期メカニズムが強化されました。
  // エージェントたちが一つの Todo 計画を共有し、互いの作業を妨げずに並列走行するための設定です。
  "team_mode": {
    "enabled": false,
    // エージェント間の共有データ、Todoリスト、作業進捗の永続化先
    "base_dir": ".sisyphus/team",
    // 実行計画やタスク状態のリアルタイム同期。tmux ペイン間での情報共有を加速。
    "auto_sync": true
  },
  // Sisyphus Agent: オーケストレーションの中核
  // デフォルトのオーケストレーター。複雑なタスクの計画、委譲、実行を担当。
  // サブエージェントを活用した積極的な並列実行と、Todo駆動型ワークフロー(Atlas統合)が特徴。
  "sisyphus_agent": {
    "disabled": false,
    // Prometheus/Metis/Momus を使用した高度な計画立案を有効化
    "planner_enabled": true,
    // 実行中に計画を動的に修正・更新することを許可
    "replace_plan": true,
    // デフォルトのビルド/デプロイフローの有効化
    "default_builder_enabled": true
  },
  // Agents: 4大コア + 専門家エージェントの定義
  "agents": {
    "sisyphus": {
      // --- Core Agents ---
      // 【司令塔: Sisyphus】 全体の品質管理と最終意思決定
      // Ultrawork: 長時間自律駆動モード。リファクタリングや巨大なログ解析など、負荷の高いタスクに使用。
      "category": "ultrabrain",
      "ultrawork": {
        "model": "{env:ULTRA_WORK_MODEL}",
        "fallback_models": [
          "{env:ULTRA_WORK_FALLBACK_MODEL}"
        ],
        "variant": "max",
        "effort": "high"
      }
    },
    "hephaestus": {
      // 【製造担当: Hephaestus】 「正当な職人」。ロジックの実装、リファクタリング。
      // AmpCode of the deep mode にインスパイアされ、徹底的な調査の後に一気に書き上げます。
      "category": "deep",
      "permission": {
        "edit": "allow",
        "bash": {
          "git": "allow",
          "test": "allow",
          "npm": "allow"
        }
      }
    },
    "oracle": {
      // 【大規模解析・監査: Oracle】 読み取り専用のコンサルタント。
      // アーキテクチャ決定、深い論理的推論、コードレビュー、難解なバグのデバッグを担当。
      "category": "ultrabrain"
    },
    "librarian": {
      // 【超高速補助: Librarian】 証拠に基づいた調査の専門家。
      // マルチリポジトリ分析、ドキュメント検索、OSS実装例の調査を低コスト・高精度で行います。
      // v4.0.0 でプロンプトが刷新され、GitHubパーマリンクの発見能力が向上。
      "category": "quick",
      "description": "Ultra-fast background research with minimal token cost."
    },
    "explore": {
      // 【高速探索: Explore】 高速なコードベース探索とプロトタイピング。
      // 自律的なweb searchを組み合わせ、最新の技術仕様に基づいたスキャフォールディングを行います。
      "category": "quick",
      "description": "Rapid scaffolding using autonomous web search for latest technical specs."
    },
    "multimodal-looker": {
      // 【視覚アナリスト: Multimodal-Looker】 視覚コンテンツ・UI分析。
      // PDF、画像、図解、UIデザインを分析。ブラウザテストの失敗時のUIデバッグにも威力を発揮。
      "category": "ultrabrain",
      "description": "Visual Intelligence. Analyzes UI designs for API generation and debugs browser test failures."
    },
    "prometheus": {
      // --- Planning Agents ---
      // 【戦略家: Prometheus】 インタビューモードを備えたプランナー。
      // 対話を通じてタスクを分解し、並列実行可能な「Agent Swarm」用の作業計画を作成します。
      "category": "ultrabrain"
    },
    "metis": {
      // 【計画コンサル: Metis】 計画前の分析とリスク特定。
      // 隠れた意図や曖昧さ、AIが失敗しやすいポイントを事前に特定し、計画の精度を高めます。
      // v4.0.0 では意図の自動分類機能が大幅に強化されています。
      "category": "ultrabrain"
    },
    "momus": {
      // 【計画レビュアー: Momus】 計画の検証と品質保証。
      // 明確さ、検証可能性、完全性の基準に照らして、Prometheusが作成した計画を厳格にレビュー。
      "category": "ultrabrain"
    },
    "atlas": {
      // --- Orchestration Agents ---
      // 【現場監督: Atlas】 Todo駆動型実行エンジン。
      // Tmux, Playwrightなどの環境管理、Todo項目の体系的な管理・調整・維持を担当。
      "category": "ultrabrain",
      "description": "Orchestrates Tmux, Playwright, and server states. Ensures environment consistency."
    }
  },
  // Categories: タスクの性質に応じたモデルの自動ルーティング
  "categories": {
    "ultrabrain": {
      // ultrabrain: 最強の論理推論 (xhigh variant)
      "model": "{env:ULTRABRAIN_MODEL}",
      "variant": "xhigh",
      "fallback_models": [
        "{env:ULTRABRAIN_FALLBACK_MODEL}"
      ]
    },
    "deep": {
      // deep: 自律的解決・難解なタスク
      "model": "{env:DEEP_MODEL}",
      "variant": "medium",
      "fallback_models": [
        "{env:DEEP_FALLBACK_MODEL}"
      ]
    },
    "quick": {
      // quick: 些細な修正・高速レスポンス
      "model": "{env:QUICK_MODEL}",
      "fallback_models": [
        "{env:QUICK_FALLBACK_MODEL}"
      ]
    },
    "writing": {
      // writing: テクニカルライティング・散文
      "model": "{env:WRITING_MODEL}",
      "fallback_models": [
        "{env:WRITING_FALLBACK_MODEL}"
      ]
    },
    "unspecified-low": {
      "model": "{env:UNSPECIFIED_LOW_MODEL}",
      "fallback_models": [
        "{env:UNSPECIFIED_LOW_FALLBACK_MODEL}"
      ]
    },
    "unspecified-high": {
      "model": "{env:UNSPECIFIED_HIGH_MODEL}",
      "fallback_models": [
        "{env:UNSPECIFIED_HIGH_FALLBACK_MODEL}"
      ]
    },
    "visual-engineering": {
      // visual-engineering: UI/UX、デザイン、アニメーション
      "model": "{env:VISUAL_ENGINEERING_MODEL}",
      "fallback_models": [
        "{env:VISUAL_ENGINEERING_FALLBACK_MODEL}"
      ]
    },
    "artistry": {
      // artistry: アーティスト性・ジェネレーティブ
      "model": "{env:ARTISTRY_MODEL}",
      "fallback_models": [
        "{env:ARTISTRY_FALLBACK_MODEL}"
      ]
    }
  },
  // Experimental: 最新・実験的機能の最適化
  "experimental": {
    // Todo駆動タスク管理(blockedBy対応)。 .sisyphus/tasks/ に永続化
    "task_system": true,
    // LINE#ID形式のハッシュアンカー編集。行ずれエラーをゼロに
    "hashline_diff_enhancer": true,
    "aggressive_truncation": true,
    // セッション中断・失敗からの自動復旧
    "auto_resume": true,
    // トークン限界前のプロアクティブな圧縮 (85% で発動)
    "preemptive_compaction_threshold": 0.85
  },
  // TMUX統合: バックグラウンドエージェントを別ペインでリアルタイム監視
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 65
  },
  // ブラウザ自動化エンジン: スクリーンショット、フォーム入力、ネットワーク監視をサポート
  "browser_automation_engine": {
    // デフォルト: playwright-cli
    "provider": "playwright-cli"
  },
  // バックグラウンドタスクの並列実行制御
  "background_task": {
    "defaultConcurrency": 10,
    "providerConcurrency": {
      "openai": 5,
      "nvidia": 10,
      "minimax": 5,
      "google": 20,
      "opencode": 5,
      "sakura": 5
    }
  },
  // Ralph Loop: タスク完了まで自律的に試行を繰り返す自己参照型開発ループ。
  // v4.0.0 で実行時エラーのガードとリトライ戦略が強化。
  "ralph_loop": {
    "enabled": true,
    "default_max_iterations": 20
  },
  // Boulder State: セッションを跨いでエージェントの状態を維持する永続化機構
  "boulder_state": {
    "enabled": true,
    "storage_path": ".sisyphus/boulder_state.json"
  },
  // セッションリカバリ: エラーやコンテキスト上限からの透明な復旧
  "session_recovery": {
    "enabled": true,
    "max_age_minutes": 1440
  },
  // Interactive Bash: tmuxベースの永続ターミナル(vim/htopなどのTUI対応)
  "interactive_bash": {
    "enabled": true,
    "timeout_ms": 300000
  },
  // Git Master: コミット分割、スタイル自動検出を行うGit専門機能
  "git_master": {
    "commit_footer": false,
    "include_co_authored_by": false
  },
  // 過剰なコメントを削減・整理する提案機能
  "comment_checker": {
    "enabled": true
  },
  "disabled_hooks": [
    "auto-update-checker"
  ],
  // Rules Injector: .claude/rules/ 内のルールをglob条件で自動注入
  "rules_injector": {
    "enabled": true
  },
  // Auto Slash Command: プロンプトからのスラッシュコマンド自動実行
  "auto_slash_command": {
    "enabled": true
  },
  "commands": {
    "git-pr-flow": {
      "description": "Git PR Flow with full-skill access",
      "prompt": "./commands/git-pr-flow.md",
      "skills": {
        "git-master": {
          "enabled": true
        }
      }
    },
    "build-skill": {
      "description": "Agent Skill Builder",
      "prompt": "./commands/build-skill.md",
      "skills": {
        "agent-skill-architect": {
          "enabled": true
        }
      }
    }
  },
  "hashline_edit": true,
  "env": [
    "HOME",
    "MCP_GATEWAY_TOKEN",
    "CHRONOS_POSTGRES_HOST",
    "CHRONOS_POSTGRES_PASSWORD",
    "CHRONOS_NEO4J_URI",
    "CHRONOS_NEO4J_PASSWORD",
    "CHRONOS_REDIS_URL",
    "CHRONOS_POSTGRES_PORT",
    "CHRONOS_POSTGRES_DB",
    "CHRONOS_POSTGRES_USER",
    "CHRONOS_POSTGRES_SSL",
    "CHRONOS_GRAPH_ENABLED",
    "CHRONOS_NEO4J_USER",
    "CHRONOS_CACHE_BACKEND",
    "CHRONOS_REDIS_SSL",
    "CHRONOS_DECAY_HALF_LIFE_DAYS",
    "CHRONOS_SIMILARITY_THRESHOLD",
    "CHRONOS_DEDUP_THRESHOLD",
    "CHRONOS_EMBEDDING_PROVIDER",
    "CHRONOS_LOCAL_MODEL_NAME",
    "CHRONOS_EMBEDDING_DIMENSION"
  ]
}

