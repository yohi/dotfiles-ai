// =============================================================================
// OMO (Oh-My-OpenAgent) Configuration
// =============================================================================
// - omo native profiles (v4.19.4+) 対応設定ファイル
// - プロファイル構成: personal (個人開発 / コスト最適化) / work (業務 / AWS Bedrock)
// - プロファイル切り替え: OMO_PROFILE=personal|work (またはラッパー引数 "opencode personal")
// =============================================================================
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",

  // ===========================================================================
  // OpenCode 共通設定 (全プロファイルで共有されるコア機能・環境設定)
  // ===========================================================================
  "[opencode]": {
    // -------------------------------------------------------------------------
    // Team Mode (マルチエージェント協調・自律チーム実行)
    // -------------------------------------------------------------------------
    "team_mode": {
      "enabled": false,
      "base_dir": ".sisyphus/team",
      "tmux_visualization": false,
      "max_parallel_members": 4,
      "max_members": 8,
      "max_messages_per_run": 10000,
      "max_wall_clock_minutes": 120,
      "max_member_turns": 500,
      "message_payload_max_bytes": 32768,
      "recipient_unread_max_bytes": 262144,
      "mailbox_poll_interval_ms": 3000
    },

    // -------------------------------------------------------------------------
    // Sisyphus Agent コア設定
    // -------------------------------------------------------------------------
    "sisyphus_agent": {
      "disabled": false,
      "planner_enabled": true,
      "replace_plan": true,
      "default_builder_enabled": true
    },

    // -------------------------------------------------------------------------
    // 実験的機能 (コンテキスト圧縮・タスクシステム)
    // -------------------------------------------------------------------------
    "experimental": {
      "task_system": true,
      "aggressive_truncation": true,
      "preemptive_compaction": true
    },

    // -------------------------------------------------------------------------
    // Tmux ターミナル分割・ペイン制御
    // -------------------------------------------------------------------------
    "tmux": {
      "enabled": true,
      "layout": "main-vertical",
      "main_pane_size": 65,
      "main_pane_min_width": 120,
      "agent_pane_min_width": 40,
      "isolation": "inline"
    },

    // -------------------------------------------------------------------------
    // ブラウザ自動化エンジン
    // -------------------------------------------------------------------------
    "browser_automation_engine": {
      "provider": "playwright-cli"
    },

    // -------------------------------------------------------------------------
    // バックグラウンドタスクのプロバイダ別並行制御
    // -------------------------------------------------------------------------
    "background_task": {
      "defaultConcurrency": 10,
      "providerConcurrency": {
        "openai": 5,
        "nvidia": 10,
        "minimax": 5,
        "google": 20,
        "opencode": 5,
        "sakura": 5
      }
    },

    // -------------------------------------------------------------------------
    // ランタイム自動フォールバック (429 / 5xx エラー時に ordered model chain へ切り替え)
    // -------------------------------------------------------------------------
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [
        429,
        500,
        502,
        503,
        504
      ],
      "max_fallback_attempts": 3,
      "cooldown_seconds": 60,
      "timeout_seconds": 30,
      "notify_on_fallback": true,
      "restore_primary_after_cooldown": true
    },

    // -------------------------------------------------------------------------
    // Goal モード (自律ゴール達成ループ)
    // -------------------------------------------------------------------------
    "goal": {
      "enabled": false,
      "auto_start": false,
      "default_max_iterations": 20
    },

    // -------------------------------------------------------------------------
    // デフォルト実行モード
    // -------------------------------------------------------------------------
    "default_mode": {
      "ultrawork": false,
      "goal": false
    },

    // -------------------------------------------------------------------------
    // Git Master (Conventional Commits 自動生成ポリシー)
    // -------------------------------------------------------------------------
    "git_master": {
      "commit_footer": false,
      "include_co_authored_by": false,
      "git_env_prefix": "GIT_MASTER=1"
    },

    // -------------------------------------------------------------------------
    // 無効化フック
    // -------------------------------------------------------------------------
    "disabled_hooks": [
      "auto-update-checker"
    ],

    // -------------------------------------------------------------------------
    // 高速行番号編集 (Hashline Edit)
    // -------------------------------------------------------------------------
    "hashline_edit": true,

    // -------------------------------------------------------------------------
    // MCP サーバーへ転送を許可する環境変数ホワイトリスト
    // -------------------------------------------------------------------------
    "mcp_env_allowlist": [
      "HOME",
      "CHRONOS_POSTGRES_HOST",
      "CHRONOS_POSTGRES_PASSWORD",
      "CHRONOS_NEO4J_URI",
      "CHRONOS_NEO4J_PASSWORD",
      "CHRONOS_REDIS_URL",
      "CHRONOS_POSTGRES_PORT",
      "CHRONOS_POSTGRES_DB",
      "CHRONOS_POSTGRES_USER",
      "CHRONOS_POSTGRES_SSL",
      "CHRONOS_GRAPH_ENABLED",
      "CHRONOS_NEO4J_USER",
      "CHRONOS_CACHE_BACKEND",
      "CHRONOS_REDIS_SSL",
      "CHRONOS_DECAY_HALF_LIFE_DAYS",
      "CHRONOS_SIMILARITY_THRESHOLD",
      "CHRONOS_DEDUP_THRESHOLD",
      "CHRONOS_EMBEDDING_PROVIDER",
      "CHRONOS_LOCAL_MODEL_NAME",
      "CHRONOS_EMBEDDING_DIMENSION"
    ],

    // =========================================================================
    // Base Agents (デフォルト: personal 構成)
    // =========================================================================
    "agents": {
      "sisyphus": {
        "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code",
        "ultrawork": {
          "model": "openai/gpt-5.6-sol",
          "reasoning": "high"
        }
      },
      "hephaestus": {
        "disable": false,
        "model": "cloudflare-ai-gateway-octg/gpt-5.6-sol"
      },
      "oracle": {
        "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra"
      },
      "librarian": {
        "model": "openai/gpt-5.6-luna"
      },
      "explore": {
        "model": "openai/gpt-5.6-luna"
      },
      "multimodal-looker": {
        "model": "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro"
      },
      "prometheus": {
        "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
      },
      "metis": {
        "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
      },
      "momus": {
        "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra"
      },
      "atlas": {
        "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
      }
    },

    // =========================================================================
    // Base Categories (デフォルト: personal 構成)
    // =========================================================================
    "categories": {
      "ultrabrain": {
        "model": "cloudflare-ai-gateway-octg/gpt-5.6-sol",
        "models": [
          {
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-sol",
            "reasoning": "max"
          },
          {
            "model": "openai/gpt-5.6-sol",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra",
            "reasoning": "high"
          },
          {
            "model": "openai/gpt-5.6-terra",
            "reasoning": "high"
          }
        ]
      },
      "deep": {
        "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra",
        "models": [
          {
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra",
            "reasoning": "high"
          },
          {
            "model": "openai/gpt-5.6-terra",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-sol",
            "reasoning": "medium"
          },
          {
            "model": "openai/gpt-5.6-sol",
            "reasoning": "medium"
          }
        ]
      },
      "quick": {
        "model": "openai/gpt-5.6-luna",
        "models": [
          {
            "model": "openai/gpt-5.6-luna",
            "reasoning": "low"
          }
        ]
      },
      "writing": {
        "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code",
        "models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
          }
        ]
      },
      "unspecified-low": {
        "model": "openai/gpt-5.6-luna",
        "models": [
          {
            "model": "openai/gpt-5.6-luna",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
          }
        ]
      },
      "unspecified-high": {
        "model": "openai/gpt-5.6-luna",
        "models": [
          {
            "model": "openai/gpt-5.6-luna",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
          }
        ]
      },
      "visual-engineering": {
        "model": "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro",
        "models": [
          {
            "model": "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
          }
        ]
      },
      "artistry": {
        "model": "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro",
        "models": [
          {
            "model": "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
          }
        ]
      }
    }
  },

  // ===========================================================================
  // Base Models (デフォルト: personal カタログ)
  // ===========================================================================
  "models": {
    "kimi-k27": {
      "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
    },
    "kimi-k26": {
      "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.6"
    },
    "sol-octg": {
      "model": "cloudflare-ai-gateway-octg/gpt-5.6-sol"
    },
    "sol": {
      "model": "openai/gpt-5.6-sol"
    },
    "terra-octg": {
      "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra"
    },
    "terra": {
      "model": "openai/gpt-5.6-terra"
    },
    "luna": {
      "model": "openai/gpt-5.6-luna"
    },
    "gemini-pro": {
      "model": "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro"
    }
  },

  // ===========================================================================
  // Profiles (実行環境別プロファイル定義)
  // ===========================================================================
  "profiles": {

    // =========================================================================
    // PERSONAL プロファイル (個人開発用 / ベース設定をそのまま使用)
    // =========================================================================
    "personal": {},

    // =========================================================================
    // WORK プロファイル (業務環境用 / Amazon Bedrock Claude 統一ポリシー)
    //
    // 【モデルルーティング方針】
    // - Claude Opus 5   : 司令塔・最上位推論・高度レビュー
    // - Claude Sonnet 5 : 主力実装・プランニング・汎用オーケストレーション
    // - Claude Haiku 4.5: 高速検索・スクリーニング・軽量作業
    // =========================================================================
    "work": {
      // -----------------------------------------------------------------------
      // 論理モデルカタログ (Amazon Bedrock)
      // -----------------------------------------------------------------------
      "models": {
        // Claude Opus 5 (最上位推論)
        "opus": {
          "model": "amazon-bedrock/global.anthropic.claude-opus-5"
        },

        // Claude Sonnet 5 (高性能・高速主力)
        "sonnet": {
          "model": "amazon-bedrock/global.anthropic.claude-sonnet-5"
        },

        // Claude Haiku 4.5 (超高速・軽量)
        "haiku": {
          "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0"
        }
      },

      "[opencode]": {
        // Git コミット設定
        "git_master": {
          "commit_footer": false,
          "include_co_authored_by": false,
          "git_env_prefix": "GIT_MASTER=1"
        },

        // =====================================================================
        // Agents (業務プロファイル用エージェント定義)
        // =====================================================================
        "agents": {
          // Sisyphus (メイン司令塔: Sonnet -> Opus)
          "sisyphus": {
            "model": "amazon-bedrock/global.anthropic.claude-sonnet-5",
            "ultrawork": {
              "model": "amazon-bedrock/global.anthropic.claude-opus-5",
              "reasoning": "high"
            }
          },

          // Hephaestus は業務プロファイルでは無効化
          "hephaestus": {
            "disable": true
          },

          // Oracle (設計相談)
          "oracle": {
            "model": "amazon-bedrock/global.anthropic.claude-opus-5"
          },

          // Librarian (外部調査)
          "librarian": {
            "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0"
          },

          // Explore (コード探索)
          "explore": {
            "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0"
          },

          // Multimodal Looker (視覚解析)
          "multimodal-looker": {
            "model": "amazon-bedrock/global.anthropic.claude-opus-5"
          },

          // Prometheus (計画立案)
          "prometheus": {
            "model": "amazon-bedrock/global.anthropic.claude-opus-5"
          },

          // Metis (メカニクス分析)
          "metis": {
            "model": "amazon-bedrock/global.anthropic.claude-opus-5"
          },

          // Momus (レビュー)
          "momus": {
            "model": "amazon-bedrock/global.anthropic.claude-opus-5"
          },

          // Atlas (環境管理・進行監視)
          "atlas": {
            "model": "amazon-bedrock/global.anthropic.claude-sonnet-5"
          }
        },

        // =====================================================================
        // Categories (業務プロファイル用カテゴリ定義)
        // =====================================================================
        "categories": {
          // 最上位推論 (Opus/max -> Sonnet)
          "ultrabrain": {
            "model": "amazon-bedrock/global.anthropic.claude-opus-5",
            "models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-opus-5",
                "reasoning": "max"
              },
              {
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5"
              }
            ]
          },

          // ディープ実装 (Opus/max -> Sonnet)
          "deep": {
            "model": "amazon-bedrock/global.anthropic.claude-opus-5",
            "models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-opus-5",
                "reasoning": "max"
              },
              {
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5"
              }
            ]
          },

          // クイック作業 (Haiku -> Sonnet)
          "quick": {
            "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0",
            "models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0"
              },
              {
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5"
              }
            ]
          },

          // ドキュメント執筆 (Sonnet -> Haiku)
          "writing": {
            "model": "amazon-bedrock/global.anthropic.claude-sonnet-5",
            "models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5"
              },
              {
                "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0"
              }
            ]
          },

          // 汎用軽量タスク (Sonnet -> Haiku)
          "unspecified-low": {
            "model": "amazon-bedrock/global.anthropic.claude-sonnet-5",
            "models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5"
              },
              {
                "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0"
              }
            ]
          },

          // 汎用高度推論 (Opus/max -> Sonnet)
          "unspecified-high": {
            "model": "amazon-bedrock/global.anthropic.claude-opus-5",
            "models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-opus-5",
                "reasoning": "max"
              },
              {
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5"
              }
            ]
          },

          // ビジュアル・UI設計 (Opus/max -> Sonnet)
          "visual-engineering": {
            "model": "amazon-bedrock/global.anthropic.claude-opus-5",
            "models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-opus-5",
                "reasoning": "max"
              },
              {
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5"
              }
            ]
          },

          // クリエイティブ生成 (Sonnet -> Haiku)
          "artistry": {
            "model": "amazon-bedrock/global.anthropic.claude-sonnet-5",
            "models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5"
              },
              {
                "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0"
              }
            ]
          }
        }
      }
    }
  },

  // ===========================================================================
  // マイグレーション履歴
  // ===========================================================================
  "_migrations": [
    "2026-07-opencode-config-unification"
  ]
}
