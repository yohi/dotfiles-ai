// =============================================================================
// OMO (Oh-My-OpenAgent) Configuration
// =============================================================================
// - omo native profiles (v4.19.4+) 対応設定ファイル
// - プロファイル構成: personal (個人開発 / コスト最適化) / work (業務 / AWS Bedrock)
// - プロファイル切り替え: OMO_PROFILE=personal|work (またはラッパー引数 "opencode personal")
// =============================================================================
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/v4.19.4/assets/omo.schema.json",

  // ===========================================================================
  // OpenCode 共通設定 (全プロファイルで共有されるコア機能・環境設定)
  // ===========================================================================
  "[opencode]": {
    // -------------------------------------------------------------------------
    // Team Mode (マルチエージェント協調・自律チーム実行)
    // -------------------------------------------------------------------------
    "team_mode": {
      "enabled": false,
      "base_dir": ".sisyphus/team",
      "tmux_visualization": false,
      "max_parallel_members": 4,
      "max_members": 8,
      "max_messages_per_run": 10000,
      "max_wall_clock_minutes": 120,
      "max_member_turns": 500,
      "message_payload_max_bytes": 32768,
      "recipient_unread_max_bytes": 262144,
      "mailbox_poll_interval_ms": 3000
    },

    // -------------------------------------------------------------------------
    // Sisyphus Agent コア設定
    // -------------------------------------------------------------------------
    "sisyphus_agent": {
      "disabled": false,
      "planner_enabled": true,
      "replace_plan": true,
      "default_builder_enabled": true
    },

    // -------------------------------------------------------------------------
    // 実験的機能 (コンテキスト圧縮・タスクシステム)
    // -------------------------------------------------------------------------
    "experimental": {
      // 期待効果: TodoWrite/TodoReadを永続タスクシステムへ切り替え、
      // 長時間作業でタスク状態を安定して引き継ぐ。直接のtoken削減設定ではない。
      "task_system": true,

      // 期待効果: context limit超過時に大きなtool outputを追加削減し、
      // 復旧成功率を上げる。通常時には発火せず、日常的なtoken削減の主役ではない。
      // 注意: 超過時の救済策のため、必要な出力まで失う可能性がある。
      "aggressive_truncation": true,

      // 期待効果: context使用量が内部閾値(約78%)に達した際に先回りでcompactionし、
      // providerのcontext limit到達による停止を防ぐ。閾値はここでは変更しない。
      // 注意: compaction用の追加requestと要約による情報損失が発生し得る。
      "preemptive_compaction": true,

      // OpenCode側のtool_output制限でfull outputをdiskへ退避するため、
      // OmOでは全toolへの無差別truncationを行わない。OmO標準whitelistの
      // tool-output-truncatorは引き続き有効で、巨大outputの安全弁として機能する。
      "truncate_all_tool_outputs": false,

      // context limit復旧時に重複tool履歴を低損失で削除する。
      // v4.19.4ではprompt-too-long時のdeduplication recoveryが実動作の中心。
      "dynamic_context_pruning": {
        "enabled": true,
        "notification": "minimal",

        // task/session系の制御情報はdeduplication recoveryから保護する。
        "protected_tools": [
          "task",
          "todowrite",
          "todoread",
          "lsp_rename",
          "session_read",
          "session_write",
          "session_search"
        ],
        "strategies": {
          // 同一tool・同一引数の古いcall/resultを削除し、最新結果だけを残す。
          "deduplication": {
            "enabled": true
          }
        }
      }
    },

    // -------------------------------------------------------------------------
    // Tmux ターミナル分割・ペイン制御
    // -------------------------------------------------------------------------
    "tmux": {
      "enabled": true,
      "layout": "main-vertical",
      "main_pane_size": 65,
      "main_pane_min_width": 120,
      "agent_pane_min_width": 40,
      "isolation": "inline"
    },

    // -------------------------------------------------------------------------
    // ブラウザ自動化エンジン
    // -------------------------------------------------------------------------
    "browser_automation_engine": {
      "provider": "playwright-cli"
    },

    // -------------------------------------------------------------------------
    // バックグラウンドタスクのプロバイダ別並行制御
    // -------------------------------------------------------------------------
    "background_task": {
      // 100k+ token級requestの同時多発でquota windowが瞬間的に枯れるのを抑える。
      // providerConcurrencyのkeyはmodel文字列の先頭provider IDと完全一致させる。
      "defaultConcurrency": 6,
      "providerConcurrency": {
        "openai": 6,
        "opencode": 5,
        "cloudflare-ai-gateway": 3,
        "cloudflare-ai-gateway-custom": 5,
        "cloudflare-ai-gateway-octg": 4,
        "amazon-bedrock": 5
      },
      // 高コスト / 大contextモデルはprovider上限よりさらに狭く制御する。
      // Dynamic Routes停止中は、実際に利用する直結model IDへ合わせる。
      "modelConcurrency": {
        "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code": 2,
        "cloudflare-ai-gateway-custom/custom-opencode-go/kimi-k2.7-code": 2,
        "cloudflare-ai-gateway-custom/custom-sakura-ai/preview/Kimi-K2.7-Code": 2,
        "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k3": 1,
        "cloudflare-ai-gateway-custom/custom-command-code/zai-org/glm-5.2": 2,
        "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3": 2,
        "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3-flash": 4,
        "cloudflare-ai-gateway-custom/custom-command-code/z-ai/glm-5.3-flash": 4,
        "cloudflare-ai-gateway-custom/custom-ollama-cloud/deepseek-v4-flash": 5,
        "cloudflare-ai-gateway-custom/custom-command-code/deepseek/deepseek-v4-flash": 5,
        "cloudflare-ai-gateway-custom/custom-opencode-go/deepseek-v4-flash": 5,
        "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro": 2,
        "cloudflare-ai-gateway-octg/gpt-5.6-sol": 1,
        "cloudflare-ai-gateway-octg/gpt-5.6-terra": 2
      }
    },

    // TEMPORARY: Cloudflare Dynamic Routing is disabled because newly created
    // or recreated routes can fail with Error 2005 before provider invocation
    // (cloudflare/ai#611), and Custom Providers are not supported by Dynamic
    // Routing yet (cloudflare/cloudflare-docs#29840). Personal open models use
    // cloudflare-ai-gateway-custom direct paths, while Gemini 3.1 Pro remains on
    // the Google AI Studio provider used by the Dynamic Route definition.
    // -------------------------------------------------------------------------
    // ランタイム自動フォールバック (429 / 5xx エラー時に ordered model chain へ切り替え)
    // -------------------------------------------------------------------------
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [
        429,
        500,
        502,
        503,
        504
      ],
      // Dynamic Routing停止中はsame-model provider fallbackもOmO側で表現するため、
      // provider段とlogical-model段を最後まで辿れるよう上限を広げる。
      "max_fallback_attempts": 10,
      "cooldown_seconds": 60,
      // Dynamic Route内の長いprovider timeout chainを待つ必要がないため、
      // 直結運用では通常の短いtimeoutで次のmodelへ進める。
      "timeout_seconds": 30,
      "notify_on_fallback": true,
      // 一時的なquota / provider障害から回復後はprimaryへ戻す。
      "restore_primary_after_cooldown": true
    },

    // -------------------------------------------------------------------------
    // Goal モード (自律ゴール達成ループ)
    // -------------------------------------------------------------------------
    "goal": {
      "enabled": false,
      "auto_start": false,
      "default_max_iterations": 20
    },

    // -------------------------------------------------------------------------
    // デフォルト実行モード
    // -------------------------------------------------------------------------
    "default_mode": {
      "ultrawork": false,
      "goal": false
    },

    // -------------------------------------------------------------------------
    // Git Master (Conventional Commits 自動生成ポリシー)
    // -------------------------------------------------------------------------
    "git_master": {
      "commit_footer": false,
      "include_co_authored_by": false,
      "git_env_prefix": "GIT_MASTER=1"
    },

    // -------------------------------------------------------------------------
    // 無効化フック
    // -------------------------------------------------------------------------
    "disabled_hooks": [
      "auto-update-checker"
    ],

    // -------------------------------------------------------------------------
    // 高速行番号編集 (Hashline Edit)
    // -------------------------------------------------------------------------
    "hashline_edit": true,

    // -------------------------------------------------------------------------
    // MCP サーバーへ転送を許可する環境変数ホワイトリスト
    // -------------------------------------------------------------------------
    "mcp_env_allowlist": [
      "HOME",
      "CHRONOS_POSTGRES_HOST",
      "CHRONOS_POSTGRES_PASSWORD",
      "CHRONOS_NEO4J_URI",
      "CHRONOS_NEO4J_PASSWORD",
      "CHRONOS_REDIS_URL",
      "CHRONOS_POSTGRES_PORT",
      "CHRONOS_POSTGRES_DB",
      "CHRONOS_POSTGRES_USER",
      "CHRONOS_POSTGRES_SSL",
      "CHRONOS_GRAPH_ENABLED",
      "CHRONOS_NEO4J_USER",
      "CHRONOS_CACHE_BACKEND",
      "CHRONOS_REDIS_SSL",
      "CHRONOS_DECAY_HALF_LIFE_DAYS",
      "CHRONOS_SIMILARITY_THRESHOLD",
      "CHRONOS_DEDUP_THRESHOLD",
      "CHRONOS_EMBEDDING_PROVIDER",
      "CHRONOS_LOCAL_MODEL_NAME",
      "CHRONOS_EMBEDDING_DIMENSION"
    ],

    "disabled_mcps": [
      "websearch",
      "context7",
      "grep_app"
    ],

    // =========================================================================
    // Base Agents (デフォルト: personal 構成)
    //
    // 【重要: モデル指定形式について】
    // OMO 設計上は下記 models カタログの短縮名 (例: "luna", "sol") の解決機構がありますが、
    // OMO v4.19.4 時点の実装ではサブエージェント (task) 起動時等の特定パスでカタログ解決前の
    // 生文字列が渡り、下流の parseModelString() (provider/model 形式必須検査) で
    // `Invalid model format "<alias>"` エラーが発生する不整合があります。
    // そのため、各行に短縮名形式 (コメントアウト) を併記しつつ、実設定値には完全修飾名 (provider/model) を指定しています。
    //
    // TEMPORARY: Dynamic Routes are bypassed. Personal open models use
    // cloudflare-ai-gateway-custom direct paths, while Gemini 3.1 Pro keeps the
    // Google AI Studio provider selected by cf-ai-gw-dynamic-routing. Sisyphus-Junior
    // is intentionally not configured: category-routed tasks inherit the selected
    // category model. Same-model provider fallback is explicitly ordered in OmO
    // until Dynamic Routing can safely be re-enabled.
    // =========================================================================
    "agents": {
      "sisyphus": {
        // "model": "kimi-k27",
        "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code",
        "fallback_models": [
          "cloudflare-ai-gateway-custom/custom-sakura-ai/preview/Kimi-K2.7-Code",
          "cloudflare-ai-gateway-custom/custom-opencode-go/kimi-k2.7-code",
          "cloudflare-ai-gateway-custom/custom-command-code/moonshotai/kimi-k2.7-code"
        ],
        "ultrawork": {
          // "model": "sol",
          "model": "openai/gpt-6-sol",
          "reasoning": "high"
        }
      },
      "hephaestus": {
        "disable": false,
        // 高頻度の反復実装ではPlus Solを主系にして、OCTG STANDARDを温存する。
        // "model": "sol",
        "model": "openai/gpt-6-sol",
        "fallback_models": [
          {
            // OCTG STANDARDはPlus側障害時のfallbackとしてのみ使用する。
            // "model": "sol-octg",
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-sol",
            "reasoning": "high"
          }
        ]
      },
      "oracle": {
        // "model": "terra-octg",
        "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra"
      },
      "librarian": {
        // "model": "luna",
        "model": "openai/gpt-6-luna"
      },
      "explore": {
        // "model": "luna",
        "model": "openai/gpt-6-luna"
      },
      "multimodal-looker": {
        // "model": "gemini-pro",
        "model": "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro"
      },
      // Justice Review Gate reviewer の利用モデルを profile ごとに明示する。
      "justice-review-controller": {
        "model": "openai/gpt-6-sol"
      },
      "prometheus": {
        // OpenCode GoのK2.7枠を平常時から使い、Ollamaへの集中を避ける。
        "model": "cloudflare-ai-gateway-custom/custom-opencode-go/kimi-k2.7-code",
        "fallback_models": [
          "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code",
          "cloudflare-ai-gateway-custom/custom-sakura-ai/preview/Kimi-K2.7-Code",
          "cloudflare-ai-gateway-custom/custom-command-code/moonshotai/kimi-k2.7-code"
        ]
      },
      "metis": {
        // OpenCode GoのK2.7枠を平常時から使い、計画系workloadを分散する。
        "model": "cloudflare-ai-gateway-custom/custom-opencode-go/kimi-k2.7-code",
        "fallback_models": [
          "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code",
          "cloudflare-ai-gateway-custom/custom-sakura-ai/preview/Kimi-K2.7-Code",
          "cloudflare-ai-gateway-custom/custom-command-code/moonshotai/kimi-k2.7-code"
        ]
      },
      "momus": {
        // "model": "terra-octg",
        "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra"
      },
      "atlas": {
        // "model": "kimi-k27",
        "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code",
        "fallback_models": [
          "cloudflare-ai-gateway-custom/custom-sakura-ai/preview/Kimi-K2.7-Code",
          "cloudflare-ai-gateway-custom/custom-opencode-go/kimi-k2.7-code",
          "cloudflare-ai-gateway-custom/custom-command-code/moonshotai/kimi-k2.7-code"
        ]
      }
    },

    // Command-level model pins the subtask request independently of the caller's active model.
    "command": {
      "justice-review-gate": {
        "template": "$ARGUMENTS",
        "description": "Run the Justice Design / Implementation Plan review gate",
        "agent": "justice-review-controller",
        "model": "openai/gpt-6-sol",
        "subtask": true
      }
    },

    // =========================================================================
    // Base Categories (デフォルト: personal 構成)
    //
    // 【リソース割り当て方針】
    // - OCTG Sol STANDARD (1M tokens/day) は高価値・低頻度のultrabrain中心に温存する。
    // - Plus GPT-6 Lunaは軽量・高スループット用途、GPT-6 Solは高難度推論・coding用途に使う。
    // - Kimi / GLM / DeepSeek等のopen modelはcloudflare-ai-gateway-custom経由に統一する。
    // - Gemini 3.1 Proはcf-ai-gw-dynamic-routingと同じGoogle AI Studio providerを使う。
    // - Dynamic Routes停止中はsame-model provider fallbackをOmO側で明示する。
    // - provider primaryはworkload単位で分散し、固定費のあるOllama / Go / GOATを平常時から使う。
    // - GLM-5.3 Flashをdefault agentic coding、GLM-5.3 fullをpremium coding escalation、
    //   GLM-5.2をquota / compatibility hedgeとして扱う。
    // - v4.19.4のruntime-fallback hookはcategoryのfallback_modelsを参照するため、
    //   各categoryでmodels[1:]と同じ内容・順序を互換定義として維持する。
    // =========================================================================
    "categories": {
      // -----------------------------------------------------------------------
      // Justice / Superpowers semantic worker categories
      //
      // Justice v4.1.0 が決定するのは「semantic category」までであり、
      // 実際の model / provider / reasoning / fallback 順序は OmO 側の責務。
      // ここでは、将来のモデル更新時にも判断基準を再現できるよう、
      // 単純な「強いモデル順」ではなく次の原則で routing を組んでいる。
      //
      // 1. 高頻度タスクは固定費subscriptionの安価なopen modelをprimaryにする。
      //    - mechanical / review は DeepSeek Flash
      //    - implementation は GLM-5.3 Flash
      //    - integration は GLM-5.3 full
      // 2. 高価値・低頻度タスクは品質を優先し、GPT系の推論予算を使う。
      //    - architecture / final-review は GPT-6 Sol
      //    - deep は OATG Terra の無料quotaを優先しつつ GPT-6 Solへ退避
      // 3. 同一logical modelのprovider違いを前段fallbackに置き、
      //    一時的なquota枯渇・provider障害では能力クラスを変えない。
      // 4. 異種model fallbackは「同一modelを全providerで使えない場合」のみ。
      //    そのため DeepSeek/GLM の provider fallback後に GPT を置く。
      // 5. Kimi K3は性能不足ではなくcost efficiency / quota efficiencyの観点から
      //    automatic routingから除外。必要時は完全修飾model IDで明示選択する。
      // 6. Justice v4.1.0 の sp-review / sp-final-review は mandatory review 経路であり、
      //    review失敗は TaskAccepted / PlanComplete を止め得る。そのためreview系の
      //    最終fallbackは通常タスクより強くし、品質・可用性を優先する。
      // 7. runtime_fallback(v4.19.4) は category.fallback_models を直接参照するため、
      //    models[1:] と fallback_models は同じ内容・順序を維持する。
      //
      // したがって、新モデルへ置換する際は「ベンチマークで上だから」だけでなく、
      // workload role / subscription quota / provider diversity / mandatory gate impact
      // の4点を確認してから順序を変更すること。
      // -----------------------------------------------------------------------
      // 定型・低リスク・高頻度タスク向け。
      // rename / typo / config / test-only などに高価な推論モデルを使わない。
      // DeepSeek Flashを同一modelの3 providerで回し、全経路が失敗した場合だけ
      // GPT-6 Lunaへ退避する。Lunaはここでは「品質向上」ではなく可用性保険。
      "sp-mechanical": {
        "model": "cloudflare-ai-gateway-custom/custom-command-code/deepseek/deepseek-v4-flash",
        "models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-command-code/deepseek/deepseek-v4-flash",
            "reasoning": "low"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/deepseek-v4-flash",
            "reasoning": "low"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/deepseek-v4-flash",
            "reasoning": "low"
          },
          {
            "model": "openai/gpt-6-luna",
            "reasoning": "low"
          }
        ],
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/deepseek-v4-flash",
            "reasoning": "low"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/deepseek-v4-flash",
            "reasoning": "low"
          },
          {
            "model": "openai/gpt-6-luna",
            "reasoning": "low"
          }
        ]
      },
      // 通常のTDD実装向け。
      // GLM-5.3 Flashはagentic codingの主力として、full版よりquota効率を優先。
      // 同一Flashをprovider横断で使い切った後だけGPT-6 Sol/mediumへ移る。
      // Solをprimaryにしないのは、反復実装でPlus側quotaへ集中するのを避けるため。
      "sp-implementation": {
        "model": "cloudflare-ai-gateway-custom/custom-command-code/z-ai/glm-5.3-flash",
        "models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-command-code/z-ai/glm-5.3-flash",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3-flash",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/glm-5.3-flash",
            "reasoning": "high"
          },
          {
            "model": "openai/gpt-6-sol",
            "reasoning": "medium"
          }
        ],
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3-flash",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/glm-5.3-flash",
            "reasoning": "high"
          },
          {
            "model": "openai/gpt-6-sol",
            "reasoning": "medium"
          }
        ]
      },
      // 複数module / API / state / concurrency / async / migration等の統合作業向け。
      // FlashではなくGLM-5.3 full/maxをprimaryにして長時間・複雑なcodingを優先。
      // provider障害やquota枯渇が起きた場合の最終保険としてGPT-6 Sol/highを置く。
      // ここではthroughputより整合性・推論力を重視する。
      "sp-integration": {
        "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3",
        "models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-command-code/zai-org/glm-5.3",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/glm-5.3",
            "reasoning": "max"
          },
          {
            "model": "openai/gpt-6-sol",
            "reasoning": "high"
          }
        ],
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-command-code/zai-org/glm-5.3",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/glm-5.3",
            "reasoning": "max"
          },
          {
            "model": "openai/gpt-6-sol",
            "reasoning": "high"
          }
        ]
      },
      // research / investigate / deep reasoning向け。
      // コード変更を伴わない場合も多いため、まずOATG Terraの無料quotaを活用。
      // Terraが使えない場合はGPT-6 Sol/highへ直接上げ、その後にGLM-5.3 full。
      // cheap coding modelへ下げず、deep roleの推論強度を保つ順序。
      "sp-deep": {
        "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra",
        "models": [
          {
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra",
            "reasoning": "high"
          },
          {
            "model": "openai/gpt-6-sol",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-command-code/zai-org/glm-5.3",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/glm-5.3",
            "reasoning": "max"
          }
        ],
        "fallback_models": [
          {
            "model": "openai/gpt-6-sol",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-command-code/zai-org/glm-5.3",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/glm-5.3",
            "reasoning": "max"
          }
        ]
      },
      // architecture / design system /高影響設計判断向け。低頻度だが失敗コストが高い。
      // GPT-6 Sol/maxをprimaryにし、quota節約より判断品質を優先する。
      // OATG GPT-5.6 Solは能力の近い無料quota fallbackとして次点に置き、
      // 最後にGLM-5.3 full/maxをprovider横断で使う。
      "sp-architecture": {
        "model": "openai/gpt-6-sol",
        "models": [
          {
            "model": "openai/gpt-6-sol",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-sol",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-command-code/zai-org/glm-5.3",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/glm-5.3",
            "reasoning": "max"
          }
        ],
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-sol",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-command-code/zai-org/glm-5.3",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/glm-5.3",
            "reasoning": "max"
          }
        ]
      },
      // Task単位のmandatory review向け。
      // 実装系(GLM中心)とreview系(DeepSeek中心)でmodel familyを分け、
      // 同じモデルの盲点をそのまま再生産しにくくすることを狙う。
      // 高頻度なのでDeepSeek Flash/maxをprimaryにするが、Justice v4.1.0では
      // review失敗がTaskAcceptedを止め得るため、全DeepSeek経路失敗時は
      // LunaではなくGPT-6 Sol/highへ退避して可用性とreview品質を優先する。
      "sp-review": {
        "model": "cloudflare-ai-gateway-custom/custom-command-code/deepseek/deepseek-v4-flash",
        "models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-command-code/deepseek/deepseek-v4-flash",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/deepseek-v4-flash",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/deepseek-v4-flash",
            "reasoning": "max"
          },
          {
            "model": "openai/gpt-6-sol",
            "reasoning": "high"
          }
        ],
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/deepseek-v4-flash",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/deepseek-v4-flash",
            "reasoning": "max"
          },
          {
            "model": "openai/gpt-6-sol",
            "reasoning": "high"
          }
        ]
      },
      // Plan / branch全体のmandatory final review向け。
      // 最終ゲートなのでコスト最適化よりfalse negative /見落とし低減を優先。
      // GPT-6 Sol/maxをprimary、OATG Sol/maxを能力の近いquota fallback、
      // その後にGLM-5.3 full/maxをprovider横断で配置する。
      // failureはPlanCompleteを止め得るため、軽量modelへの降格は行わない。
      "sp-final-review": {
        "model": "openai/gpt-6-sol",
        "models": [
          {
            "model": "openai/gpt-6-sol",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-sol",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-command-code/zai-org/glm-5.3",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/glm-5.3",
            "reasoning": "max"
          }
        ],
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-sol",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-command-code/zai-org/glm-5.3",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/glm-5.3",
            "reasoning": "max"
          }
        ]
      },

      "ultrabrain": {
        // "model": "sol-octg",
        "model": "cloudflare-ai-gateway-octg/gpt-5.6-sol",
        "models": [
          {
            // "model": "sol-octg",
