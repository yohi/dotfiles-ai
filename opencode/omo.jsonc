  // ===========================================================================
  // Base Models (デフォルト: personal カタログ)
  //
  // ※ OMO の論理カタログ定義。上述の通りサブエージェント実行時の不整合回避のため、
  //   agents / categories 側には provider/model 完全修飾名を直接記述しています。
  // ※ Dynamic Routes停止中はaliasもpreferred direct providerを指す。実際のcategory/agentは
  //   workload単位のprovider primaryを完全修飾名で明示する。
  // ===========================================================================
  "models": {
    // NOTE: kimi-k3 aliasは意図的に定義しない。
    // K3はautomatic routingから外しており、将来一時的に使う場合も
    // catalog alias経由ではなく完全修飾model IDを明示する。
    // これにより別エージェントが「aliasがあるから通常fallbackに戻してよい」
    // と誤解するのを防ぐ。
    "kimi-k27": {
      "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
    },
    "glm-52": {
      "model": "cloudflare-ai-gateway-custom/custom-command-code/zai-org/glm-5.2"
    },
    "glm-53": {
      "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3"
    },
    "glm-53-flash": {
      "model": "cloudflare-ai-gateway-custom/custom-command-code/z-ai/glm-5.3-flash"
    },
    "deepseek-v4-flash": {
      "model": "cloudflare-ai-gateway-custom/custom-command-code/deepseek/deepseek-v4-flash"
    },
    "kimi-k26": {
      "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.6"
    },
    "sol-octg": {
      "model": "cloudflare-ai-gateway-octg/gpt-5.6-sol"
    },
    "sol": {
      "model": "openai/gpt-6-sol"
    },
    "terra-octg": {
      "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra"
    },
    "luna": {
      "model": "openai/gpt-6-luna"
    },
    "gemini-pro": {
      "model": "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro"
    }
  },

  // ===========================================================================
  // Profiles (実行環境別プロファイル定義)
  // ===========================================================================
  "profiles": {

    // =========================================================================
    // PERSONAL プロファイル (個人開発用 / ベース設定をそのまま使用)
    // =========================================================================
    "personal": {},

    // =========================================================================
    // WORK プロファイル (業務環境用 / Amazon Bedrock Claude 統一ポリシー)
    //
    // 【モデルルーティング方針】
    // - Claude Opus 5   : 司令塔・最上位推論・高度レビュー
    // - Claude Sonnet 5 : 主力実装・プランニング・汎用オーケストレーション
    // - Claude Haiku 4.5: 高速検索・スクリーニング・軽量作業
    // =========================================================================
    "work": {
      // -----------------------------------------------------------------------
      // 論理モデルカタログ (Amazon Bedrock)
      //
      // ※ OMO の論理カタログ定義。サブエージェント実行時の不整合回避のため、
      //   agents / categories 側には provider/model 完全修飾名を直接記述しています。
      // -----------------------------------------------------------------------
      "models": {
        // Claude Opus 5 (最上位推論)
        "opus": {
          "model": "amazon-bedrock/global.anthropic.claude-opus-5"
        },

        // Claude Sonnet 5 (高性能・高速主力)
        "sonnet": {
          "model": "amazon-bedrock/global.anthropic.claude-sonnet-5"
        },

        // Claude Haiku 4.5 (超高速・軽量)
        "haiku": {
          "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0"
        }
      },

      "[opencode]": {
        // =====================================================================
        // Agents (業務プロファイル用エージェント定義)
        // =====================================================================
        "agents": {
          // Sisyphus (メイン司令塔: Sonnet -> Opus)
          "sisyphus": {
            // "model": "sonnet",
            "model": "amazon-bedrock/global.anthropic.claude-sonnet-5",
            "ultrawork": {
              // "model": "opus",
              "model": "amazon-bedrock/global.anthropic.claude-opus-5",
              "reasoning": "high"
            }
          },

          // Hephaestus は業務プロファイルでは無効化
          "hephaestus": {
            "disable": true
          },

          // Oracle (設計相談)
          "oracle": {
