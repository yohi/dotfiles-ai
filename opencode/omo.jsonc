// =============================================================================
// OMO (Oh-My-OpenAgent) Configuration
// =============================================================================
// - omo native profiles (v4.19.4+) 対応設定ファイル
// - プロファイル構成: personal (個人開発 / コスト最適化) / work (業務 / AWS Bedrock)
// - プロファイル切り替え: OMO_PROFILE=personal|work (またはラッパー引数 "opencode personal")
// =============================================================================
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/v4.19.4/assets/omo.schema.json",

  // ===========================================================================
  // OpenCode 共通設定 (全プロファイルで共有されるコア機能・環境設定)
  // ===========================================================================
  "[opencode]": {
    // -------------------------------------------------------------------------
    // Team Mode (マルチエージェント協調・自律チーム実行)
    // -------------------------------------------------------------------------
    "team_mode": {
      "enabled": false,
      "base_dir": ".sisyphus/team",
      "tmux_visualization": false,
      "max_parallel_members": 4,
      "max_members": 8,
      "max_messages_per_run": 10000,
      "max_wall_clock_minutes": 120,
      "max_member_turns": 500,
      "message_payload_max_bytes": 32768,
      "recipient_unread_max_bytes": 262144,
      "mailbox_poll_interval_ms": 3000
    },

    // -------------------------------------------------------------------------
    // Sisyphus Agent コア設定
    // -------------------------------------------------------------------------
    "sisyphus_agent": {
      "disabled": false,
      "planner_enabled": true,
      "replace_plan": true,
      "default_builder_enabled": true
    },

    // -------------------------------------------------------------------------
    // 実験的機能 (コンテキスト圧縮・タスクシステム)
    // -------------------------------------------------------------------------
    "experimental": {
      // 期待効果: TodoWrite/TodoReadを永続タスクシステムへ切り替え、
      // 長時間作業でタスク状態を安定して引き継ぐ。直接のtoken削減設定ではない。
      "task_system": true,

      // 期待効果: context limit超過時に大きなtool outputを追加削減し、
      // 復旧成功率を上げる。通常時には発火せず、日常的なtoken削減の主役ではない。
      // 注意: 超過時の救済策のため、必要な出力まで失う可能性がある。
      "aggressive_truncation": true,

      // 期待効果: context使用量が内部閾値(約78%)に達した際に先回りでcompactionし、
      // providerのcontext limit到達による停止を防ぐ。閾値はここでは変更しない。
      // 注意: compaction用の追加requestと要約による情報損失が発生し得る。
      "preemptive_compaction": true,

      // OpenCode側のtool_output制限でfull outputをdiskへ退避するため、
      // OmOでは全toolへの無差別truncationを行わない。OmO標準whitelistの
      // tool-output-truncatorは引き続き有効で、巨大outputの安全弁として機能する。
      "truncate_all_tool_outputs": false,

      // context limit復旧時に重複tool履歴を低損失で削除する。
      // v4.19.4ではprompt-too-long時のdeduplication recoveryが実動作の中心。
      "dynamic_context_pruning": {
        "enabled": true,
        "notification": "minimal",

        // task/session系の制御情報はdeduplication recoveryから保護する。
        "protected_tools": [
          "task",
          "todowrite",
          "todoread",
          "lsp_rename",
          "session_read",
          "session_write",
          "session_search"
        ],
        "strategies": {
          // 同一tool・同一引数の古いcall/resultを削除し、最新結果だけを残す。
          "deduplication": {
            "enabled": true
          }
        }
      }
    },

    // -------------------------------------------------------------------------
    // Tmux ターミナル分割・ペイン制御
    // -------------------------------------------------------------------------
    "tmux": {
      "enabled": true,
      "layout": "main-vertical",
      "main_pane_size": 65,
      "main_pane_min_width": 120,
      "agent_pane_min_width": 40,
      "isolation": "inline"
    },

    // -------------------------------------------------------------------------
    // ブラウザ自動化エンジン
    // -------------------------------------------------------------------------
    "browser_automation_engine": {
      "provider": "playwright-cli"
    },

    // -------------------------------------------------------------------------
    // バックグラウンドタスクのプロバイダ別並行制御
    // -------------------------------------------------------------------------
    "background_task": {
      // 100k+ token級requestの同時多発でquota windowが瞬間的に枯れるのを抑える。
      // providerConcurrencyのkeyはmodel文字列の先頭provider IDと完全一致させる。
      "defaultConcurrency": 6,
      "providerConcurrency": {
        "openai": 6,
        "opencode": 5,
        "cloudflare-ai-gateway": 3,
        "cloudflare-ai-gateway-custom": 5,
        "cloudflare-ai-gateway-octg": 4,
        "amazon-bedrock": 5
      },
      // 高コスト / 大contextモデルはprovider上限よりさらに狭く制御する。
      // Dynamic Routes停止中は、実際に利用する直結model IDへ合わせる。
      "modelConcurrency": {
        "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code": 2,
        "cloudflare-ai-gateway-custom/custom-opencode-go/kimi-k2.7-code": 2,
        "cloudflare-ai-gateway-custom/custom-sakura-ai/preview/Kimi-K2.7-Code": 2,
        "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k3": 1,
        "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3": 2,
        "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3-flash": 4,
        "cloudflare-ai-gateway-custom/custom-ollama-cloud/deepseek-v4.1-flash": 5,
        "cloudflare-ai-gateway-custom/custom-opencode-go/deepseek-v4.1-flash": 5,
        "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro": 2,
        // OCTG STANDARD (1M/day shared pool): Astra/Sol/Lunaは同一quotaを共有する。
        // 高価値・低頻度用途を優先し、同時実行でpoolを急消費しないよう絞る。
        "cloudflare-ai-gateway-octg/gpt-6-astra": 1,
        "cloudflare-ai-gateway-octg/gpt-6-sol": 1,
        "cloudflare-ai-gateway-octg/gpt-6-luna": 2,
        // GPT-5.6 TerraはOCTG MINI (10M/day)側なのでSTANDARDとは別枠。
        "cloudflare-ai-gateway-octg/gpt-5.6-terra": 2
      }
    },

    // TEMPORARY: Cloudflare Dynamic Routing is disabled because newly created
    // or recreated routes can fail with Error 2005 before provider invocation
    // (cloudflare/ai#611), and Custom Providers are not supported by Dynamic
    // Routing yet (cloudflare/cloudflare-docs#29840). Personal open models use
    // cloudflare-ai-gateway-custom direct paths, while Gemini 3.1 Pro remains on
    // the Google AI Studio provider used by the Dynamic Route definition.
    // -------------------------------------------------------------------------
    // ランタイム自動フォールバック (429 / 5xx エラー時に ordered model chain へ切り替え)
    // -------------------------------------------------------------------------
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [
        429,
        500,
        502,
        503,
        504
      ],
      // Dynamic Routing停止中はsame-model provider fallbackもOmO側で表現するため、
      // provider段とlogical-model段を最後まで辿れるよう上限を広げる。
      "max_fallback_attempts": 10,
      "cooldown_seconds": 60,
      // Dynamic Route内の長いprovider timeout chainを待つ必要がないため、
      // 直結運用では通常の短いtimeoutで次のmodelへ進める。
      "timeout_seconds": 30,
      "notify_on_fallback": true,
      // 一時的なquota / provider障害から回復後はprimaryへ戻す。
      "restore_primary_after_cooldown": true
    },

    // -------------------------------------------------------------------------
    // Goal モード (自律ゴール達成ループ)
    // -------------------------------------------------------------------------
    "goal": {
      "enabled": false,
      "auto_start": false,
      "default_max_iterations": 20
    },

    // -------------------------------------------------------------------------
    // デフォルト実行モード
    // -------------------------------------------------------------------------
    "default_mode": {
      "ultrawork": false,
      "goal": false
    },

    // -------------------------------------------------------------------------
    // Git Master (Conventional Commits 自動生成ポリシー)
    // -------------------------------------------------------------------------
    "git_master": {
      "commit_footer": false,
      "include_co_authored_by": false,
      "git_env_prefix": "GIT_MASTER=1"
    },

    // -------------------------------------------------------------------------
    // 無効化フック
    // -------------------------------------------------------------------------
    "disabled_hooks": [
      "auto-update-checker"
    ],

    // -------------------------------------------------------------------------
    // 高速行番号編集 (Hashline Edit)
    // -------------------------------------------------------------------------
    "hashline_edit": true,

    // -------------------------------------------------------------------------
    // MCP サーバーへ転送を許可する環境変数ホワイトリスト
    // -------------------------------------------------------------------------
    "mcp_env_allowlist": [
      "HOME",
      "CHRONOS_POSTGRES_HOST",
      "CHRONOS_POSTGRES_PASSWORD",
      "CHRONOS_NEO4J_URI",
      "CHRONOS_NEO4J_PASSWORD",
      "CHRONOS_REDIS_URL",
      "CHRONOS_POSTGRES_PORT",
      "CHRONOS_POSTGRES_DB",
      "CHRONOS_POSTGRES_USER",
      "CHRONOS_POSTGRES_SSL",
      "CHRONOS_GRAPH_ENABLED",
      "CHRONOS_NEO4J_USER",
      "CHRONOS_CACHE_BACKEND",
      "CHRONOS_REDIS_SSL",
      "CHRONOS_DECAY_HALF_LIFE_DAYS",
      "CHRONOS_SIMILARITY_THRESHOLD",
      "CHRONOS_DEDUP_THRESHOLD",
      "CHRONOS_EMBEDDING_PROVIDER",
      "CHRONOS_LOCAL_MODEL_NAME",
      "CHRONOS_EMBEDDING_DIMENSION"
    ],

    "disabled_mcps": [
      "websearch",
      "context7",
      "grep_app"
    ],

    "claude_code": {
      "mcp": false
    },

    // =========================================================================
    // Base Agents (デフォルト: personal 構成)
    //
    // 【重要: モデル指定形式について】
    // OMO 設計上は下記 models カタログの短縮名 (例: "luna", "sol") の解決機構がありますが、
    // OMO v4.19.4 時点の実装ではサブエージェント (task) 起動時等の特定パスでカタログ解決前の
    // 生文字列が渡り、下流の parseModelString() (provider/model 形式必須検査) で
    // `Invalid model format "<alias>"` エラーが発生する不整合があります。
    // そのため、各行に短縮名形式 (コメントアウト) を併記しつつ、実設定値には完全修飾名 (provider/model) を指定しています。
    //
    // TEMPORARY: Dynamic Routes are bypassed. Personal open models use
    // cloudflare-ai-gateway-custom direct paths, while Gemini 3.1 Pro keeps the
    // Google AI Studio provider selected by cf-ai-gw-dynamic-routing. Sisyphus-Junior
    // is intentionally not configured: category-routed tasks inherit the selected
    // category model. Same-model provider fallback is explicitly ordered in OmO
    // until Dynamic Routing can safely be re-enabled.
    // =========================================================================
    "agents": {
      "sisyphus": {
        "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code",
        "fallback_models": [
          "cloudflare-ai-gateway-custom/custom-sakura-ai/preview/Kimi-K2.7-Code",
          "cloudflare-ai-gateway-custom/custom-opencode-go/kimi-k2.7-code"
        ],
        "ultrawork": {
          "model": "openai/gpt-6.1-sol",
          "reasoning": "high"
        }
      },
      "hephaestus": {
        "disable": false,
        "model": "openai/gpt-6.1-sol",
        "reasoning": "high",
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-octg/gpt-6-sol",
            "reasoning": "high"
          }
        ]
      },
      "oracle": {
        "model": "openai/gpt-6.1-sol",
        "reasoning": "xhigh",
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro",
            "reasoning": "high"
          }
        ]
      },
      "librarian": {
        "model": "openai/gpt-6-luna",
        "reasoning": "low",
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/deepseek-v4.1-flash",
            "reasoning": "low"
          }
        ]
      },
      "explore": {
        "model": "openai/gpt-6-luna",
        "reasoning": "low",
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/deepseek-v4.1-flash",
            "reasoning": "low"
          }
        ]
      },
      "multimodal-looker": {
        "model": "openai/gpt-6.1-sol",
        "reasoning": "low",
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro",
            "reasoning": "high"
          }
        ]
      },
      "justice-review-controller": {
        "model": "openai/gpt-6.1-sol",
        "reasoning": "high"
      },
      "justice-review-worker": {
        "model": "openai/gpt-6.1-sol",
        "reasoning": "high"
      },
      "prometheus": {
        "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code",
        "fallback_models": [
          "cloudflare-ai-gateway-custom/custom-opencode-go/kimi-k2.7-code"
        ]
      },
      "metis": {
        "model": "cloudflare-ai-gateway-custom/custom-opencode-go/kimi-k2.7-code",
        "fallback_models": [
          "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
        ]
      },
      "momus": {
        "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra",
        "reasoning": "high",
        "fallback_models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "xhigh"
          }
        ]
      },
      "atlas": {
        "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code",
        "fallback_models": [
          "cloudflare-ai-gateway-custom/custom-sakura-ai/preview/Kimi-K2.7-Code",
          "cloudflare-ai-gateway-custom/custom-opencode-go/kimi-k2.7-code"
        ]
      }
    },

    // Command-level model pins the subtask request independently of the caller's active model.
    "command": {
      "justice-review-gate": {
        "template": "$ARGUMENTS",
        "description": "Run the Justice Design / Implementation Plan review gate",
        "agent": "justice-review-controller",
        "model": "openai/gpt-6.1-sol",
        "subtask": true
      }
    },

    // =========================================================================
    // Base Categories (personal profile)
    // AgentはOmO v4.19.4公式推奨ファミリーを重視、CategoryはPlus Luna/maxを実装主力にする。
    // Ollamaは週次枠を積極利用し、Go・GOATは月次枠を温存する。
    // OCTG STANDARD（Astra/Sol/Luna共有の小容量枠）をPrimaryに置かない。
    // GOAT（カタログ維持）、Kimi K3、GLM-5.3 full、Console Freeは自動経路に配置しない。
    // mandatory sp-final-reviewはPlus Sol/max固定で、自動降格しない。
    // OmO v4.19.4 の models[1:] と fallback_models は同じ順序・reasoningを維持する。
    "categories": {
      "sp-mechanical": {
        "model": "openai/gpt-6-luna",
        "models": [
          {
            "model": "openai/gpt-6-luna",
            "reasoning": "low"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/deepseek-v4.1-flash",
            "reasoning": "low"
          }
        ],
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/deepseek-v4.1-flash",
            "reasoning": "low"
          }
        ]
      },
      "sp-implementation": {
        "model": "openai/gpt-6-luna",
        "models": [
          {
            "model": "openai/gpt-6-luna",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3-flash",
            "reasoning": "high"
          },
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/glm-5.3-flash",
            "reasoning": "high"
          }
        ],
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3-flash",
            "reasoning": "high"
          },
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/glm-5.3-flash",
            "reasoning": "high"
          }
        ]
      },
      "sp-integration": {
        "model": "openai/gpt-6-luna",
        "models": [
          {
            "model": "openai/gpt-6-luna",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3-flash",
            "reasoning": "high"
          },
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/glm-5.3-flash",
            "reasoning": "high"
          }
        ],
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3-flash",
            "reasoning": "high"
          },
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/glm-5.3-flash",
            "reasoning": "high"
          }
        ]
      },
      "sp-deep": {
        "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra",
        "models": [
          {
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra",
            "reasoning": "high"
          },
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "high"
          }
        ],
        "fallback_models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "high"
          }
        ]
      },
      "sp-architecture": {
        "model": "openai/gpt-6-luna",
        "models": [
          {
            "model": "openai/gpt-6-luna",
            "reasoning": "max"
          },
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra",
            "reasoning": "high"
          }
        ],
        "fallback_models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra",
            "reasoning": "high"
          }
        ]
      },
      "sp-review": {
        "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/deepseek-v4.1-flash",
        "models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/deepseek-v4.1-flash",
            "reasoning": "max"
          },
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/deepseek-v4.1-flash",
            "reasoning": "max"
          }
        ],
        "fallback_models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/deepseek-v4.1-flash",
            "reasoning": "max"
          }
        ]
      },
      "sp-final-review": {
        "model": "openai/gpt-6.1-sol",
        "models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "max"
          }
        ],
        "fallback_models": []
      },
      "ultrabrain": {
        "model": "openai/gpt-6.1-sol",
        "models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra",
            "reasoning": "high"
          }
        ],
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra",
            "reasoning": "high"
          }
        ]
      },
      "deep": {
        "model": "openai/gpt-6.1-sol",
        "models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra",
            "reasoning": "high"
          }
        ],
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra",
            "reasoning": "high"
          }
        ]
      },
      "quick": {
        "model": "openai/gpt-6-luna",
        "models": [
          {
            "model": "openai/gpt-6-luna",
            "reasoning": "low"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/deepseek-v4.1-flash",
            "reasoning": "low"
          }
        ],
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/deepseek-v4.1-flash",
            "reasoning": "low"
          }
        ]
      },
      "writing": {
        "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code",
        "models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-sakura-ai/preview/Kimi-K2.7-Code"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/kimi-k2.7-code"
          }
        ],
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-sakura-ai/preview/Kimi-K2.7-Code"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/kimi-k2.7-code"
          }
        ]
      },
      "unspecified-low": {
        "model": "openai/gpt-6-luna",
        "models": [
          {
            "model": "openai/gpt-6-luna",
            "reasoning": "medium"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/deepseek-v4.1-flash",
            "reasoning": "low"
          }
        ],
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/deepseek-v4.1-flash",
            "reasoning": "low"
          }
        ]
      },
      "unspecified-high": {
        "model": "openai/gpt-6-luna",
        "models": [
          {
            "model": "openai/gpt-6-luna",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
          },
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/kimi-k2.7-code"
          }
        ],
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
          },
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/kimi-k2.7-code"
          }
        ]
      },
      "visual-engineering": {
        "model": "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro",
        "models": [
          {
            "model": "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro",
