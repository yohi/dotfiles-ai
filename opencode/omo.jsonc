// OMO configuration
// Migrated to omo native profiles (v4.19.4+)
// Native profiles: personal / work
// Activation: OMO_PROFILE=personal|work
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",

  // ===========================================================================
  // OpenCode shared configuration
  // ===========================================================================
  "[opencode]": {
    "team_mode": {
      "enabled": false,
      "base_dir": ".sisyphus/team",
      "auto_sync": true
    },

    "sisyphus_agent": {
      "disabled": false,
      "planner_enabled": true,
      "replace_plan": true,
      "default_builder_enabled": true
    },

    "experimental": {
      "task_system": true,
      "aggressive_truncation": true,
      "preemptive_compaction": true
    },

    "tmux": {
      "enabled": true,
      "layout": "main-vertical",
      "main_pane_size": 65
    },

    "browser_automation_engine": {
      "provider": "playwright-cli"
    },

    "background_task": {
      "defaultConcurrency": 10,
      "providerConcurrency": {
        "openai": 5,
        "nvidia": 10,
        "minimax": 5,
        "google": 20,
        "opencode": 5,
        "sakura": 5
      }
    },

    // 429 / provider error時にordered model chainへ切り替える
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [
        429,
        500,
        502,
        503,
        504
      ],
      "max_fallback_attempts": 3,
      "cooldown_seconds": 60,
      "timeout_seconds": 30,
      "notify_on_fallback": true,
      "restore_primary_after_cooldown": true
    },

    "goal": {
      "enabled": true,
      "auto_start": false,
      "default_max_iterations": 20
    },

    "default_mode": {
      "goal": false
    },

    "git_master": {
      "commit_footer": false,
      "include_co_authored_by": false
    },

    "comment_checker": {
      "enabled": true
    },

    "disabled_hooks": [
      "auto-update-checker"
    ],

    "hashline_edit": true,

    "mcp_env_allowlist": [
      "HOME",
      "CHRONOS_POSTGRES_HOST",
      "CHRONOS_POSTGRES_PASSWORD",
      "CHRONOS_NEO4J_URI",
      "CHRONOS_NEO4J_PASSWORD",
      "CHRONOS_REDIS_URL",
      "CHRONOS_POSTGRES_PORT",
      "CHRONOS_POSTGRES_DB",
      "CHRONOS_POSTGRES_USER",
      "CHRONOS_POSTGRES_SSL",
      "CHRONOS_GRAPH_ENABLED",
      "CHRONOS_NEO4J_USER",
      "CHRONOS_CACHE_BACKEND",
      "CHRONOS_REDIS_SSL",
      "CHRONOS_DECAY_HALF_LIFE_DAYS",
      "CHRONOS_SIMILARITY_THRESHOLD",
      "CHRONOS_DEDUP_THRESHOLD",
      "CHRONOS_EMBEDDING_PROVIDER",
      "CHRONOS_LOCAL_MODEL_NAME",
      "CHRONOS_EMBEDDING_DIMENSION"
    ]
  },

  // ===========================================================================
  // Profiles
  // ===========================================================================
  "profiles": {

    // =========================================================================
    // PERSONAL
    //
    // Routing policy:
    //
    // Kimi K2.7   = orchestration / instruction-following / planning
    // Luna         = high-frequency worker / search / TDD implementation
    // Terra        = senior reasoning / review / architecture consultation
    // Sol          = explicit deep specialist only
    // Gemini       = visual / creative
    //
    // Provider paths are intentionally unchanged in Step 2.
    // =========================================================================
    "personal": {

      // -----------------------------------------------------------------------
      // Logical model catalog
      // -----------------------------------------------------------------------
      "models": {
        "kimi-k27": {
          "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
        },

        "kimi-k26": {
          "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.6"
        },

        "sol-octg": {
          "model": "cloudflare-ai-gateway-octg/gpt-5.6-sol"
        },

        "sol-plus": {
          "model": "openai/gpt-5.6-sol"
        },

        "terra-octg": {
          "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra"
        },

        "terra-plus": {
          "model": "openai/gpt-5.6-terra"
        },

        "luna-octg": {
          "model": "cloudflare-ai-gateway-octg/gpt-5.6-luna"
        },

        "luna-plus": {
          "model": "openai/gpt-5.6-luna"
        },

        "gemini-pro": {
          "model": "cloudflare-ai-gateway/google/gemini-3.1-pro"
        },

        "gemini-pro-ai-studio": {
          "model": "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro"
        }
      },

      "[opencode]": {

        // =====================================================================
        // Agents
        // =====================================================================
        "agents": {

          // -------------------------------------------------------------------
          // Sisyphus
          //
          // High-frequency orchestration.
          // K2.7 is maintainer-verified for Sisyphus and substantially cheaper
          // to keep running than Sol/K3-class models.
          // -------------------------------------------------------------------
          "sisyphus": {
            "models": [
              "kimi-k27",

              {
                "model": "sol-octg",
                "reasoning": "medium"
              },

              {
                "model": "sol-plus",
                "reasoning": "medium"
              }
            ],

            // Premium autonomous mode.
            //
            // Current provider set has no active K3 route, so keep the existing
            // OpenAI path rather than introducing a new provider in Step 2.
            "ultrawork": {
              "model": "sol-plus",
              "reasoning": "high"
            }
          },

          // -------------------------------------------------------------------
          // Hephaestus
          //
          // Explicit deep implementation specialist.
          // Restore upstream-native GPT-5.6 Sol / medium behavior.
          // -------------------------------------------------------------------
          "hephaestus": {
            "disable": false,

            "models": [
              {
                "model": "sol-octg",
                "reasoning": "medium"
              },

              {
                "model": "sol-plus",
                "reasoning": "medium"
              }
            ]
          },

          // -------------------------------------------------------------------
          // Oracle
          //
          // Oracle is invoked frequently in real workflows.
          // Do NOT spend Sol quota on every architecture/debug consultation.
          //
          // Normal:
          //   Terra/high
          //
          // Availability fallback:
          //   Luna/max -> alternate Terra -> alternate Luna
          //
          // Sol escalation should happen explicitly through
          // Hephaestus / deep / ultrabrain instead.
          // -------------------------------------------------------------------
          "oracle": {
            "models": [
              {
                "model": "terra-octg",
                "reasoning": "high"
              },

              {
                "model": "luna-octg",
                "reasoning": "max"
              },

              {
                "model": "terra-plus",
                "reasoning": "high"
              },

              {
                "model": "luna-plus",
                "reasoning": "max"
              }
            ]
          },

          // -------------------------------------------------------------------
          // Librarian
          //
          // High-frequency external documentation / OSS research.
          // -------------------------------------------------------------------
          "librarian": {
            "models": [
              {
                "model": "luna-octg",
                "reasoning": "low"
              },

              {
                "model": "luna-plus",
                "reasoning": "low"
              }
            ]
          },

          // -------------------------------------------------------------------
          // Explore
          //
          // High-frequency codebase search.
          // Upstream also places Luna/low first for this role.
          // -------------------------------------------------------------------
          "explore": {
            "models": [
              {
                "model": "luna-octg",
                "reasoning": "low"
              },

              {
                "model": "luna-plus",
                "reasoning": "low"
              }
            ]
          },

          // -------------------------------------------------------------------
          // Multimodal Looker
          // -------------------------------------------------------------------
          "multimodal-looker": {
            "models": [
              {
                "model": "gemini-pro",
                "reasoning": "high"
              },

              "kimi-k27"
            ]
          },

          // -------------------------------------------------------------------
          // Prometheus
          //
          // Superpowersを主planning workflowとして使うため、
          // 高頻度Sol plannerにはしない。
          //
          // K2.7 = normal planning
          // Sol/high = provider/model fallback
          // -------------------------------------------------------------------
          "prometheus": {
            "models": [
              "kimi-k27",

              {
                "model": "sol-octg",
                "reasoning": "high"
              },

              {
                "model": "sol-plus",
                "reasoning": "high"
              }
            ]
          },

          // -------------------------------------------------------------------
          // Metis
          //
          // Mechanics-driven planning/gap analysis.
          // Keep within Kimi family.
          // -------------------------------------------------------------------
          "metis": {
            "models": [
              "kimi-k27",
              "kimi-k26"
            ]
          },

          // -------------------------------------------------------------------
          // Momus
          //
          // Upstream-native primary is Terra/high.
          // Frequent planning review must not consume Sol on every round.
          // -------------------------------------------------------------------
          "momus": {
            "models": [
              {
                "model": "terra-octg",
                "reasoning": "high"
              },

              {
                "model": "luna-octg",
                "reasoning": "max"
              },

              {
                "model": "terra-plus",
                "reasoning": "high"
              },

              {
                "model": "luna-plus",
                "reasoning": "max"
              }
            ]
          },

          // -------------------------------------------------------------------
          // Atlas
          //
          // Execution controller / conductor.
          // Avoid expensive Sol as the normal orchestration model.
          // -------------------------------------------------------------------
          "atlas": {
            "models": [
              "kimi-k27",

              {
                "model": "sol-octg",
                "reasoning": "medium"
              },

              {
                "model": "sol-plus",
                "reasoning": "medium"
              }
            ]
          },

          // -------------------------------------------------------------------
          // Sisyphus Junior
          //
          // High-frequency implementation worker.
          //
          // This is the main Step 2 change for Superpowers compatibility:
          // normal detailed TDD tasks should run on Luna/max rather than Sol.
          // -------------------------------------------------------------------
          "sisyphus-junior": {
            "models": [
              {
                "model": "luna-octg",
                "reasoning": "max"
              },

              "kimi-k27",

              {
                "model": "terra-octg",
                "reasoning": "high"
              },

              {
                "model": "luna-plus",
                "reasoning": "max"
              }
            ]
          }
        },

        // =====================================================================
        // Categories
        // =====================================================================
        "categories": {

          // -------------------------------------------------------------------
          // ultrabrain
          //
          // Semantic meaning:
          // "I explicitly want the strongest reasoning."
          //
          // Keep Sol/max instead of silently degrading this category.
          // -------------------------------------------------------------------
          "ultrabrain": {
            "models": [
              {
                "model": "sol-octg",
                "reasoning": "max"
              },

              {
                "model": "sol-plus",
                "reasoning": "max"
              },

              {
                "model": "terra-octg",
                "reasoning": "high"
              }
            ]
          },

          // -------------------------------------------------------------------
          // deep
          //
          // Explicit deep autonomous implementation.
          // Keep upstream-native Sol/medium semantics.
          // -------------------------------------------------------------------
          "deep": {
            "models": [
              {
                "model": "sol-octg",
                "reasoning": "medium"
              },

              {
                "model": "sol-plus",
                "reasoning": "medium"
              },

              {
                "model": "terra-octg",
                "reasoning": "high"
              }
            ]
          },

          // -------------------------------------------------------------------
          // quick
          //
          // Search, trivial modifications, small mechanical work.
          // -------------------------------------------------------------------
          "quick": {
            "models": [
              {
                "model": "luna-octg",
                "reasoning": "low"
              },

              {
                "model": "luna-plus",
                "reasoning": "low"
              }
            ]
          },

          // -------------------------------------------------------------------
          // writing
          //
          // Kimi instruction-following remains a better fit than GPT-native
          // deep reasoning for normal technical writing.
          // -------------------------------------------------------------------
          "writing": {
            "models": [
              "kimi-k27"
            ]
          },

          // -------------------------------------------------------------------
          // unspecified-low
          //
          // Generic work where quick/low is too weak but deep is excessive.
          // Luna/high becomes the default general-purpose tier.
          // -------------------------------------------------------------------
          "unspecified-low": {
            "models": [
              {
                "model": "luna-octg",
                "reasoning": "high"
              },

              {
                "model": "luna-plus",
                "reasoning": "high"
              },

              "kimi-k27"
            ]
          },

          // -------------------------------------------------------------------
          // unspecified-high
          //
          // Senior general-purpose reasoning.
          // Terra/high replaces Sol/high to protect Sol capacity.
          // -------------------------------------------------------------------
          "unspecified-high": {
            "models": [
              {
                "model": "terra-octg",
                "reasoning": "high"
              },

              {
                "model": "terra-plus",
                "reasoning": "high"
              },

              "kimi-k27"
            ]
          },

          // -------------------------------------------------------------------
          // visual-engineering
          // -------------------------------------------------------------------
          "visual-engineering": {
            "models": [
              {
                "model": "gemini-pro",
                "reasoning": "high"
              },

              "kimi-k27"
            ]
          },

          // -------------------------------------------------------------------
          // artistry
          // -------------------------------------------------------------------
          "artistry": {
            "models": [
              {
                "model": "gemini-pro-ai-studio",
                "reasoning": "high"
              },

              "kimi-k27"
            ]
          }
        }
      }
    },

    // =========================================================================
    // WORK
    //
    // Step 2では変更しない。
    // =========================================================================
    "work": {
      "models": {
        "opus": {
          "model": "amazon-bedrock/global.anthropic.claude-opus-5"
        },

        "sonnet": {
          "model": "amazon-bedrock/global.anthropic.claude-sonnet-5"
        },

        "haiku": {
          "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0"
        }
      },

      "[opencode]": {
        "agents": {
          "sisyphus": {
            "models": [
              {
                "model": "sonnet",
                "reasoning": "max"
              },

              {
                "model": "opus",
                "reasoning": "max"
              }
            ],

            "ultrawork": {
              "model": "opus",
              "reasoning": "high"
            }
          },

          "hephaestus": {
            "disable": true
          },

          "oracle": {
            "models": [
              {
                "model": "opus",
                "reasoning": "max"
              },

              "sonnet"
            ]
          },

          "librarian": {
            "models": [
              "haiku",
              "sonnet"
            ]
          },

          "explore": {
            "models": [
              "haiku",
              "sonnet"
            ]
          },

          "multimodal-looker": {
            "models": [
              {
                "model": "opus",
                "reasoning": "max"
              },

              "sonnet"
            ]
          },

          "prometheus": {
            "models": [
              {
                "model": "opus",
                "reasoning": "max"
              },

              "sonnet"
            ]
          },

          "metis": {
            "models": [
              {
                "model": "opus",
                "reasoning": "max"
              },

              "sonnet"
            ]
          },

          "momus": {
            "models": [
              {
                "model": "opus",
                "reasoning": "max"
              },

              "sonnet"
            ]
          },

          "atlas": {
            "models": [
              "sonnet",
              "haiku"
            ]
          }
        },

        "categories": {
          "ultrabrain": {
            "models": [
              {
                "model": "opus",
                "reasoning": "max"
              },

              "sonnet"
            ]
          },

          "deep": {
            "models": [
              {
                "model": "opus",
                "reasoning": "max"
              },

              "sonnet"
            ]
          },

          "quick": {
            "models": [
              "haiku",
              "sonnet"
            ]
          },

          "writing": {
            "models": [
              "sonnet",
              "haiku"
            ]
          },

          "unspecified-low": {
            "models": [
              "sonnet",
              "haiku"
            ]
          },

          "unspecified-high": {
            "models": [
              {
                "model": "opus",
                "reasoning": "max"
              },

              "sonnet"
            ]
          },

          "visual-engineering": {
            "models": [
              {
                "model": "opus",
                "reasoning": "max"
              },

              "sonnet"
            ]
          },

          "artistry": {
            "models": [
              "sonnet",
              "haiku"
            ]
          }
        }
      }
    }
  },

  "_migrations": [
    "2026-07-opencode-config-unification"
  ]
}
