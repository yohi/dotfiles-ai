// =============================================================================
// OMO (Oh-My-OpenAgent) Configuration
// =============================================================================
// - omo native profiles (v4.19.4+) 対応設定ファイル
// - プロファイル構成: personal (個人開発 / コスト最適化) / work (業務 / AWS Bedrock)
// - プロファイル切り替え: OMO_PROFILE=personal|work (またはラッパー引数 "opencode personal")
// =============================================================================
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/v4.19.4/assets/omo.schema.json",

  // ===========================================================================
  // OpenCode 共通設定
  // ===========================================================================
  "[opencode]": {
    "team_mode": {
      "enabled": false,
      "base_dir": ".sisyphus/team",
      "tmux_visualization": false,
      "max_parallel_members": 4,
      "max_members": 8,
      "max_messages_per_run": 10000,
      "max_wall_clock_minutes": 120,
      "max_member_turns": 500,
      "message_payload_max_bytes": 32768,
      "recipient_unread_max_bytes": 262144,
      "mailbox_poll_interval_ms": 3000
    },

    "sisyphus_agent": {
      "disabled": false,
      "planner_enabled": true,
      "replace_plan": true,
      "default_builder_enabled": true
    },

    "experimental": {
      "task_system": true,
      "aggressive_truncation": true,
      "preemptive_compaction": true,
      "truncate_all_tool_outputs": false,
      "dynamic_context_pruning": {
        "enabled": true,
        "notification": "minimal",
        "protected_tools": [
          "task",
          "todowrite",
          "todoread",
          "lsp_rename",
          "session_read",
          "session_write",
          "session_search"
        ],
        "strategies": {
          "deduplication": {
            "enabled": true
          }
        }
      }
    },

    "tmux": {
      "enabled": true,
      "layout": "main-vertical",
      "main_pane_size": 65,
      "main_pane_min_width": 120,
      "agent_pane_min_width": 40,
      "isolation": "inline"
    },

    "browser_automation_engine": {
      "provider": "playwright-cli"
    },

    // Provider-wide limits are the coarse guardrail. Expensive personal models
    // additionally use modelConcurrency so one large-context workload cannot
    // drain a shared quota window through parallel reservations.
    "background_task": {
      "defaultConcurrency": 6,
      "providerConcurrency": {
        "openai": 6,
        "opencode": 5,
        "cloudflare-ai-gateway": 3,
        "cloudflare-ai-gateway-custom": 5,
        "cloudflare-ai-gateway-octg": 4,
        "amazon-bedrock": 5
      },
      "modelConcurrency": {
        "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code": 2,
        "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k3": 1,
        "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.2": 2,
        "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3-flash": 4,
        "opencode/deepseek-v4-flash-free": 5,
        "cloudflare-ai-gateway-octg/gpt-5.6-sol": 1,
        "cloudflare-ai-gateway-octg/gpt-5.6-terra": 2
      }
    },

    // TEMPORARY: Cloudflare Dynamic Routing is disabled because newly created
    // or recreated routes can fail with Error 2005 before provider invocation
    // (cloudflare/ai#611), and Custom Providers are not supported by Dynamic
    // Routing yet (cloudflare/cloudflare-docs#29840). Personal open models remain
    // pinned to direct provider paths until Cloudflare resolves these issues.
    // -------------------------------------------------------------------------
    // ランタイム自動フォールバック (429 / 5xx エラー時に ordered model chain へ切り替え)
    // -------------------------------------------------------------------------
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [
        429,
        500,
        502,
        503,
        504
      ],
      "max_fallback_attempts": 3,
      "cooldown_seconds": 60,
      "timeout_seconds": 600,
      "notify_on_fallback": true,
      "restore_primary_after_cooldown": false
    },

    "goal": {
      "enabled": false,
      "auto_start": false,
      "default_max_iterations": 20
    },

    "default_mode": {
      "ultrawork": false,
      "goal": false
    },

    "git_master": {
      "commit_footer": false,
      "include_co_authored_by": false,
      "git_env_prefix": "GIT_MASTER=1"
    },

    "disabled_hooks": [
      "auto-update-checker"
    ],

    "hashline_edit": true,

    "mcp_env_allowlist": [
      "HOME",
      "CHRONOS_POSTGRES_HOST",
      "CHRONOS_POSTGRES_PASSWORD",
      "CHRONOS_NEO4J_URI",
      "CHRONOS_NEO4J_PASSWORD",
      "CHRONOS_REDIS_URL",
      "CHRONOS_POSTGRES_PORT",
      "CHRONOS_POSTGRES_DB",
      "CHRONOS_POSTGRES_USER",
      "CHRONOS_POSTGRES_SSL",
      "CHRONOS_GRAPH_ENABLED",
      "CHRONOS_NEO4J_USER",
      "CHRONOS_CACHE_BACKEND",
      "CHRONOS_REDIS_SSL",
      "CHRONOS_DECAY_HALF_LIFE_DAYS",
      "CHRONOS_SIMILARITY_THRESHOLD",
      "CHRONOS_DEDUP_THRESHOLD",
      "CHRONOS_EMBEDDING_PROVIDER",
      "CHRONOS_LOCAL_MODEL_NAME",
      "CHRONOS_EMBEDDING_DIMENSION"
    ],

    "disabled_mcps": [
      "websearch",
      "context7",
      "grep_app"
    ],

    // =========================================================================
    // Base Agents (personal)
    //
    // v4.19.4 has an alias-resolution inconsistency on some task paths, so
    // executable agent/category settings intentionally use fully-qualified
    // provider/model strings. The logical models catalog below remains useful
    // for documentation and future migration.
    //
    // TEMPORARY: Dynamic Routes are bypassed. Open-model agents use direct
    // provider paths (primarily Ollama Cloud) until the Cloudflare issues are
    // resolved. Sisyphus-Junior is intentionally not configured: category-routed
    // tasks inherit the model from the selected category.
    // =========================================================================
    "agents": {
      "sisyphus": {
        "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code",
        "ultrawork": {
          "model": "openai/gpt-5.6-sol",
          "reasoning": "high"
        }
      },
      "hephaestus": {
        "disable": false,
        "model": "openai/gpt-5.6-sol",
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-sol",
            "reasoning": "high"
          }
        ]
      },
      "oracle": {
        "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra"
      },
      "librarian": {
        "model": "openai/gpt-5.6-luna"
      },
      "explore": {
        "model": "openai/gpt-5.6-luna"
      },
      "multimodal-looker": {
        "model": "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro"
      },
      "prometheus": {
        "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
      },
      "metis": {
        "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
      },
      "momus": {
        "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra"
      },
      "atlas": {
        "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
      }
    },

    // =========================================================================
    // Base Categories (personal)
    //
    // Resource policy:
    // - OCTG Sol STANDARD (1M tokens/day) stays primary only for ultrabrain,
    //   where each call is high-value and comparatively low-frequency.
    // - Hephaestus is high-frequency/iterative, so Plus Sol is primary there.
    // - TEMPORARY: open models use direct provider paths while Dynamic Routing
    //   is affected by Cloudflare's known Error 2005 / Custom Provider issues.
    // - Full GLM-5.3 is intentionally omitted; GLM-5.2 covers substantial
    //   coding while GLM-5.3 Flash has a distinct agentic-fast role.
    // =========================================================================
    "categories": {
      "ultrabrain": {
        "model": "cloudflare-ai-gateway-octg/gpt-5.6-sol",
        "models": [
          {
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-sol",
            "reasoning": "max"
          },
          {
            "model": "openai/gpt-5.6-sol",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra",
            "reasoning": "high"
          },
          {
            "model": "openai/gpt-5.6-terra",
            "reasoning": "high"
          }
        ]
      },
      "deep": {
        "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra",
        "models": [
          {
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.2"
          },
          {
            "model": "openai/gpt-5.6-terra",
            "reasoning": "high"
          },
          {
            "model": "openai/gpt-5.6-sol",
            "reasoning": "medium"
          }
        ]
      },
      "quick": {
        "model": "openai/gpt-5.6-luna",
        "models": [
          {
            "model": "openai/gpt-5.6-luna",
            "reasoning": "low"
          },
          {
            "model": "opencode/deepseek-v4-flash-free"
          }
        ]
      },
      "writing": {
        "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code",
        "models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
          }
        ]
      },
      "unspecified-low": {
        "model": "openai/gpt-5.6-luna",
        "models": [
          {
            "model": "openai/gpt-5.6-luna",
            "reasoning": "medium"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3-flash"
          }
        ]
      },
      "unspecified-high": {
        "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.2",
        "models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.2"
          },
          {
            "model": "openai/gpt-5.6-luna",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k3"
          }
        ]
      },
      "visual-engineering": {
        "model": "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro",
        "models": [
          {
            "model": "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
          }
        ]
      },
      "artistry": {
        "model": "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro",
        "models": [
          {
            "model": "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
          }
        ]
      }
    }
  },

  // ===========================================================================
  // Base Models (personal logical catalog)
  // ===========================================================================
  "models": {
    "kimi-k27": {
      "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
    },
    "kimi-k3": {
      "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k3"
    },
    "glm-52": {
      "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.2"
    },
    "glm-53-flash": {
      "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3-flash"
    },
    "deepseek-v4-flash": {
      "model": "opencode/deepseek-v4-flash-free"
    },
    "kimi-k26": {
      "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.6"
    },
    "sol-octg": {
      "model": "cloudflare-ai-gateway-octg/gpt-5.6-sol"
    },
    "sol": {
      "model": "openai/gpt-5.6-sol"
    },
    "terra-octg": {
      "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra"
    },
    "terra": {
      "model": "openai/gpt-5.6-terra"
    },
    "luna": {
      "model": "openai/gpt-5.6-luna"
    },
    "gemini-pro": {
      "model": "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro"
    }
  },

  // ===========================================================================
  // Profiles
  // ===========================================================================
  "profiles": {
    "personal": {},

    // WORK profile remains unchanged in routing policy: Amazon Bedrock Claude.
    "work": {
      "models": {
        "opus": {
          "model": "amazon-bedrock/global.anthropic.claude-opus-5"
        },
        "sonnet": {
          "model": "amazon-bedrock/global.anthropic.claude-sonnet-5"
        },
        "haiku": {
          "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0"
        }
      },

      "[opencode]": {
        "agents": {
          "sisyphus": {
            "model": "amazon-bedrock/global.anthropic.claude-sonnet-5",
            "ultrawork": {
              "model": "amazon-bedrock/global.anthropic.claude-opus-5",
              "reasoning": "high"
            }
          },
          "hephaestus": {
            "disable": true
          },
          "oracle": {
            "model": "amazon-bedrock/global.anthropic.claude-opus-5"
          },
          "librarian": {
            "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0"
          },
          "explore": {
            "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0"
          },
          "multimodal-looker": {
            "model": "amazon-bedrock/global.anthropic.claude-opus-5"
          },
          "prometheus": {
            "model": "amazon-bedrock/global.anthropic.claude-opus-5"
          },
          "metis": {
            "model": "amazon-bedrock/global.anthropic.claude-opus-5"
          },
          "momus": {
            "model": "amazon-bedrock/global.anthropic.claude-opus-5"
          },
          "atlas": {
            "model": "amazon-bedrock/global.anthropic.claude-sonnet-5"
          }
        },

        "categories": {
          "ultrabrain": {
            "model": "amazon-bedrock/global.anthropic.claude-opus-5",
            "models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-opus-5",
                "reasoning": "max"
              },
              {
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5"
              }
            ]
          },
          "deep": {
            "model": "amazon-bedrock/global.anthropic.claude-opus-5",
            "models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-opus-5",
                "reasoning": "max"
              },
              {
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5"
              }
            ]
          },
          "quick": {
            "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0",
            "models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0"
              },
              {
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5"
              }
            ]
          },
          "writing": {
            "model": "amazon-bedrock/global.anthropic.claude-sonnet-5",
            "models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5"
              },
              {
                "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0"
              }
            ]
          },
          "unspecified-low": {
            "model": "amazon-bedrock/global.anthropic.claude-sonnet-5",
            "models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5"
              },
              {
                "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0"
              }
            ]
          },
          "unspecified-high": {
            "model": "amazon-bedrock/global.anthropic.claude-opus-5",
            "models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-opus-5",
                "reasoning": "max"
              },
              {
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5"
              }
            ]
          },
          "visual-engineering": {
            "model": "amazon-bedrock/global.anthropic.claude-opus-5",
            "models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-opus-5",
                "reasoning": "max"
              },
              {
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5"
              }
            ]
          },
          "artistry": {
            "model": "amazon-bedrock/global.anthropic.claude-sonnet-5",
            "models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5"
              },
              {
                "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0"
              }
            ]
          }
        }
      }
    }
  },

  "_migrations": [
    "2026-07-opencode-config-unification",
    "2026-09-cloudflare-dynamic-routing-temporary-bypass"
  ]
}
