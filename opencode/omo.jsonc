// =============================================================================
// OMO (Oh-My-OpenAgent) Configuration
// =============================================================================
// - omo native profiles (v4.19.4+) 対応設定ファイル
// - プロファイル構成: personal (個人開発 / コスト最適化) / work (業務 / AWS Bedrock)
// - プロファイル切り替え: OMO_PROFILE=personal|work (またはラッパー引数 "opencode personal")
// =============================================================================
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/v4.19.4/assets/omo.schema.json",

  // ===========================================================================
  // OpenCode 共通設定 (全プロファイルで共有されるコア機能・環境設定)
  // ===========================================================================
  "[opencode]": {
    // -------------------------------------------------------------------------
    // Team Mode (マルチエージェント協調・自律チーム実行)
    // -------------------------------------------------------------------------
    "team_mode": {
      "enabled": false,
      "base_dir": ".sisyphus/team",
      "tmux_visualization": false,
      "max_parallel_members": 4,
      "max_members": 8,
      "max_messages_per_run": 10000,
      "max_wall_clock_minutes": 120,
      "max_member_turns": 500,
      "message_payload_max_bytes": 32768,
      "recipient_unread_max_bytes": 262144,
      "mailbox_poll_interval_ms": 3000
    },

    // -------------------------------------------------------------------------
    // Sisyphus Agent コア設定
    // -------------------------------------------------------------------------
    "sisyphus_agent": {
      "disabled": false,
      "planner_enabled": true,
      "replace_plan": true,
      "default_builder_enabled": true
    },

    // -------------------------------------------------------------------------
    // 実験的機能 (コンテキスト圧縮・タスクシステム)
    // -------------------------------------------------------------------------
    "experimental": {
      // 期待効果: TodoWrite/TodoReadを永続タスクシステムへ切り替え、
      // 長時間作業でタスク状態を安定して引き継ぐ。直接のtoken削減設定ではない。
      "task_system": true,

      // 期待効果: context limit超過時に大きなtool outputを追加削減し、
      // 復旧成功率を上げる。通常時には発火せず、日常的なtoken削減の主役ではない。
      // 注意: 超過時の救済策のため、必要な出力まで失う可能性がある。
      "aggressive_truncation": true,

      // 期待効果: context使用量が内部閾値(約78%)に達した際に先回りでcompactionし、
      // providerのcontext limit到達による停止を防ぐ。閾値はここでは変更しない。
      // 注意: compaction用の追加requestと要約による情報損失が発生し得る。
      "preemptive_compaction": true,

      // OpenCode側のtool_output制限でfull outputをdiskへ退避するため、
      // OmOでは全toolへの無差別truncationを行わない。OmO標準whitelistの
      // tool-output-truncatorは引き続き有効で、巨大outputの安全弁として機能する。
      "truncate_all_tool_outputs": false,

      // context limit復旧時に重複tool履歴を低損失で削除する。
      // v4.19.4ではprompt-too-long時のdeduplication recoveryが実動作の中心。
      "dynamic_context_pruning": {
        "enabled": true,
        "notification": "minimal",

        // task/session系の制御情報はdeduplication recoveryから保護する。
        "protected_tools": [
          "task",
          "todowrite",
          "todoread",
          "lsp_rename",
          "session_read",
          "session_write",
          "session_search"
        ],
        "strategies": {
          // 同一tool・同一引数の古いcall/resultを削除し、最新結果だけを残す。
          "deduplication": {
            "enabled": true
          }
        }
      }
    },

    // -------------------------------------------------------------------------
    // Tmux ターミナル分割・ペイン制御
    // -------------------------------------------------------------------------
    "tmux": {
      "enabled": true,
      "layout": "main-vertical",
      "main_pane_size": 65,
      "main_pane_min_width": 120,
      "agent_pane_min_width": 40,
      "isolation": "inline"
    },

    // -------------------------------------------------------------------------
    // ブラウザ自動化エンジン
    // -------------------------------------------------------------------------
    "browser_automation_engine": {
      "provider": "playwright-cli"
    },

    // -------------------------------------------------------------------------
    // バックグラウンドタスクのプロバイダ別並行制御
    // -------------------------------------------------------------------------
    "background_task": {
      // 100k+ token級requestの同時多発でquota windowが瞬間的に枯れるのを抑える。
      // providerConcurrencyのkeyはmodel文字列の先頭provider IDと完全一致させる。
      "defaultConcurrency": 6,
      "providerConcurrency": {
        "openai": 6,
        "opencode": 5,
        "cloudflare-ai-gateway": 3,
        "cloudflare-ai-gateway-custom": 5,
        "cloudflare-ai-gateway-octg": 4,
        "amazon-bedrock": 5
      },
      // 高コスト / 大contextモデルはprovider上限よりさらに狭く制御する。
      // Dynamic Routes停止中は、実際に利用する直結model IDへ合わせる。
      "modelConcurrency": {
        "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code": 2,
        "cloudflare-ai-gateway-custom/custom-opencode-go/kimi-k2.7-code": 2,
        "cloudflare-ai-gateway-custom/custom-sakura-ai/preview/Kimi-K2.7-Code": 2,
        "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k3": 1,
        "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3": 2,
        "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3-flash": 4,
        "cloudflare-ai-gateway-custom/custom-ollama-cloud/deepseek-v4.1-flash": 5,
        "cloudflare-ai-gateway-custom/custom-opencode-go/deepseek-v4.1-flash": 5,
        "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro": 2,
        // OCTG STANDARD (1M/day shared pool): Astra/Sol/Lunaは同一quotaを共有する。
        // 高価値・低頻度用途を優先し、同時実行でpoolを急消費しないよう絞る。
        "cloudflare-ai-gateway-octg/gpt-6-astra": 1,
        "cloudflare-ai-gateway-octg/gpt-6-sol": 1,
        "cloudflare-ai-gateway-octg/gpt-6-luna": 2,
        // GPT-5.6 TerraはOCTG MINI (10M/day)側なのでSTANDARDとは別枠。
        "cloudflare-ai-gateway-octg/gpt-5.6-terra": 2
      }
    },

    // TEMPORARY: Cloudflare Dynamic Routing is disabled because newly created
    // or recreated routes can fail with Error 2005 before provider invocation
    // (cloudflare/ai#611), and Custom Providers are not supported by Dynamic
    // Routing yet (cloudflare/cloudflare-docs#29840). Personal open models use
    // cloudflare-ai-gateway-custom direct paths, while Gemini 3.1 Pro remains on
    // the Google AI Studio provider used by the Dynamic Route definition.
    // -------------------------------------------------------------------------
    // ランタイム自動フォールバック (429 / 5xx エラー時に ordered model chain へ切り替え)
    // -------------------------------------------------------------------------
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [
        429,
        500,
        502,
        503,
        504
      ],
      // Dynamic Routing停止中はsame-model provider fallbackもOmO側で表現するため、
      // provider段とlogical-model段を最後まで辿れるよう上限を広げる。
      "max_fallback_attempts": 10,
      "cooldown_seconds": 60,
      // Dynamic Route内の長いprovider timeout chainを待つ必要がないため、
      // 直結運用では通常の短いtimeoutで次のmodelへ進める。
      "timeout_seconds": 30,
      "notify_on_fallback": true,
      // 一時的なquota / provider障害から回復後はprimaryへ戻す。
      "restore_primary_after_cooldown": true
    },

    // -------------------------------------------------------------------------
    // Goal モード (自律ゴール達成ループ)
    // -------------------------------------------------------------------------
    "goal": {
      "enabled": false,
      "auto_start": false,
      "default_max_iterations": 20
    },

    // -------------------------------------------------------------------------
    // デフォルト実行モード
    // -------------------------------------------------------------------------
    "default_mode": {
      "ultrawork": false,
      "goal": false
    },

    // -------------------------------------------------------------------------
    // Git Master (Conventional Commits 自動生成ポリシー)
    // -------------------------------------------------------------------------
    "git_master": {
      "commit_footer": false,
      "include_co_authored_by": false,
      "git_env_prefix": "GIT_MASTER=1"
    },

    // -------------------------------------------------------------------------
    // 無効化フック
    // -------------------------------------------------------------------------
    "disabled_hooks": [
      "auto-update-checker"
    ],

    // -------------------------------------------------------------------------
    // 高速行番号編集 (Hashline Edit)
    // -------------------------------------------------------------------------
    "hashline_edit": true,

    // -------------------------------------------------------------------------
    // MCP サーバーへ転送を許可する環境変数ホワイトリスト
    // -------------------------------------------------------------------------
    "mcp_env_allowlist": [
      "HOME",
      "CHRONOS_POSTGRES_HOST",
      "CHRONOS_POSTGRES_PASSWORD",
      "CHRONOS_NEO4J_URI",
      "CHRONOS_NEO4J_PASSWORD",
      "CHRONOS_REDIS_URL",
      "CHRONOS_POSTGRES_PORT",
      "CHRONOS_POSTGRES_DB",
      "CHRONOS_POSTGRES_USER",
      "CHRONOS_POSTGRES_SSL",
      "CHRONOS_GRAPH_ENABLED",
      "CHRONOS_NEO4J_USER",
      "CHRONOS_CACHE_BACKEND",
      "CHRONOS_REDIS_SSL",
      "CHRONOS_DECAY_HALF_LIFE_DAYS",
      "CHRONOS_SIMILARITY_THRESHOLD",
      "CHRONOS_DEDUP_THRESHOLD",
      "CHRONOS_EMBEDDING_PROVIDER",
      "CHRONOS_LOCAL_MODEL_NAME",
      "CHRONOS_EMBEDDING_DIMENSION"
    ],

    "disabled_mcps": [
      "websearch",
      "context7",
      "grep_app"
    ],

    "claude_code": {
      "mcp": false
    },

    // =========================================================================
    // Base Agents (デフォルト: personal 構成)
    //
    // 【重要: モデル指定形式について】
    // OMO 設計上は下記 models カタログの短縮名 (例: "luna", "sol") の解決機構がありますが、
    // OMO v4.19.4 時点の実装ではサブエージェント (task) 起動時等の特定パスでカタログ解決前の
    // 生文字列が渡り、下流の parseModelString() (provider/model 形式必須検査) で
    // `Invalid model format "<alias>"` エラーが発生する不整合があります。
    // そのため、各行に短縮名形式 (コメントアウト) を併記しつつ、実設定値には完全修飾名 (provider/model) を指定しています。
    //
    // TEMPORARY: Dynamic Routes are bypassed. Personal open models use
    // cloudflare-ai-gateway-custom direct paths, while Gemini 3.1 Pro keeps the
    // Google AI Studio provider selected by cf-ai-gw-dynamic-routing. Sisyphus-Junior
    // is intentionally not configured: category-routed tasks inherit the selected
    // category model. Same-model provider fallback is explicitly ordered in OmO
    // until Dynamic Routing can safely be re-enabled.
    // =========================================================================
    "agents": {
      // OmO公式のKimi K2.7対応を優先。長いTodo階層・委譲・ツール連携向け。
      // 高頻度でもLunaへ置換しない。Ollama週次 → Sakura → Go月次。
      // 論理alias: kimi-k27。ultraworkのみPlus Sol/highへ昇格。
      "sisyphus": {
        "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code",
        "fallback_models": [
          "cloudflare-ai-gateway-custom/custom-sakura-ai/preview/Kimi-K2.7-Code",
          "cloudflare-ai-gateway-custom/custom-opencode-go/kimi-k2.7-code"
        ],
        "ultrawork": {
          "model": "openai/gpt-6.1-sol",
          "reasoning": "high"
        }
      },
      // GPT-nativeの深い自律実装。OmOのSol系推奨に合わせPlus Sol/high。
      // OCTG STANDARD Sol/highはPlus障害時のみ使う緊急Fallback。
      "hephaestus": {
        "disable": false,
        "model": "openai/gpt-6.1-sol",
        "reasoning": "high",
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-octg/gpt-6-sol",
            "reasoning": "high"
          }
        ]
      },
      // 設計判断・難解バグ相談の独立専門家。公式のSol/xhigh推奨に従う。
      // 異なる推論系統のGemini Pro/highを代替に配置する。
      "oracle": {
        "model": "openai/gpt-6.1-sol",
        "reasoning": "xhigh",
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro",
            "reasoning": "high"
          }
        ]
      },
      // 外部資料・OSSコード検索。公式Luna Fast系に合わせPlus Luna/low。
      // 大量検索にmaxを常用せず、Ollama DeepSeek/lowで補完。
      "librarian": {
        "model": "openai/gpt-6-luna",
        "reasoning": "low",
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/deepseek-v4.1-flash",
            "reasoning": "low"
          }
        ]
      },
      // コード探索・grep等の高頻度Utility。Plus Luna/lowを使用。
      // Ollama DeepSeek/lowへ退避し、月次Goを温存する。
      "explore": {
        "model": "openai/gpt-6-luna",
        "reasoning": "low",
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/deepseek-v4.1-flash",
            "reasoning": "low"
          }
        ]
      },
      // 図・画像・PDF解析。公式GPT Sol/lowをPrimaryに置く。
      // Gemini Pro/highをFallbackにし、媒体対応は実行時検証する。
      "multimodal-looker": {
        "model": "openai/gpt-6.1-sol",
        "reasoning": "low",
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro",
            "reasoning": "high"
          }
        ]
      },
      // Justice Review GateのController。Plus Sol/highを明示的に固定。
      // command pinを含むGateの失敗をモデル障害でPASS扱いしない。
      "justice-review-controller": {
        "model": "openai/gpt-6.1-sol",
        "reasoning": "high"
      },
      // Justice実査Worker。Plus Sol/highを明示的に固定。
      // 実ランタイムのGate/証拠検証とモデルPinは独立の要件。
      "justice-review-worker": {
        "model": "openai/gpt-6.1-sol",
        "reasoning": "high"
      },
      // 計画立案Agent。公式のClaude Fable/Kimi K3系を参考にする。
      // K2.7は同系統の代替（K3同等の検証済みモデルではない）。
      // 週次Ollamaを主系にし、月次GoはFallbackとして温存。
      "prometheus": {
        "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code",
        "fallback_models": [
          "cloudflare-ai-gateway-custom/custom-opencode-go/kimi-k2.7-code"
        ]
      },
      // 計画の曖昧さ・リスクを分析する低頻度・高価値Agent。
      // 公式Claude Opus/Kimi K3系。Go K2.7を限定的に使用。
      "metis": {
        "model": "cloudflare-ai-gateway-custom/custom-opencode-go/kimi-k2.7-code",
        "fallback_models": [
          "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
        ]
      },
      // 計画の独立レビュー。公式のGPT Terra/high系を採用。
      // OCTG MINI Terra → Plus Sol/xhighで品質を確保。
      "momus": {
        "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra",
        "reasoning": "high",
        "fallback_models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "xhigh"
          }
        ]
      },
      // Todo管理・実行調整のオーケストレーション。Claude/Kimi系適性。
      // Ollama K2.7を維持し、Sakura → 月次Goの順に退避。
      "atlas": {
        "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code",
        "fallback_models": [
          "cloudflare-ai-gateway-custom/custom-sakura-ai/preview/Kimi-K2.7-Code",
          "cloudflare-ai-gateway-custom/custom-opencode-go/kimi-k2.7-code"
        ]
      }
    },

    // Command-level model pins the subtask request independently of the caller's active model.
    "command": {
      "justice-review-gate": {
        "template": "$ARGUMENTS",
        "description": "Run the Justice Design / Implementation Plan review gate",
        "agent": "justice-review-controller",
        "model": "openai/gpt-6.1-sol",
        "subtask": true
      }
    },

    // =========================================================================
    // =========================================================================
    // Base Categories (デフォルト: personal 構成)
    //
    // 【モデル適性と利用枠の分離】
    // - AgentはOmO v4.19.4のモデルファミリー適性・プロンプト調整を優先。
    //   Sisyphus / Atlas: Claude/Kimi系、Hephaestus / Oracle: GPT Sol系。
    //   Librarian / Explore: 高速Luna系、Momus: GPT Terra系を使用する。
    // - Categoryの通常実装はPlus Luna/maxを主力にしPlus利用枠を活用。
    //   ただしdeep / ultrabrain / mandatory final-reviewはPlus Solを優先。
    // - Ollama Cloud Legacyは週次、OpenCode GoとCommandCodeは月次のquota。
    //   週次Ollamaは積極利用。月次GoはMetisや障害時の予備に温存。
    // - OCTG STANDARDはAstra/Sol/Luna共有の小容量pool（設定上1M/day）。
    //   Category Primaryに使わず、Hephaestusの緊急Fallbackに限定する。
    //   同pool枯渇ならAstra→Solでも回復しない可能性が高い。
    // - OCTG MINI Terraは別pool（設定上10M/day）で調査・評価に使う。
    // - Kimi/GLM/DeepSeekはCloudflare Custom Provider、GeminiはGoogle
    //   AI StudioをGateway経由で使用する。Dynamic Routesは停止継続。
    // - Kimi K3 / GLM-5.3 full / Console Free / GOATは自動経路から除外。
    //   手動用のモデルカタログ定義は維持し、停止と廃止を区別する。
    // - OmO v4.19.4のruntime fallbackにはfallback_models参照経路あり。
    //   Categoryのmodels[1:]とfallback_modelsはmodel/reasoning/順序一致。
    // - Justiceが決めるのはsemantic category。Provider/model/fallbackの
    //   選択はOmO側の責務だが、Gate判定や承認権限はモデルへ移管しない。
    // - workload role / subscription quota / provider diversity /
    //   mandatory gate impactを検証して変更する。
    // =========================================================================
    "categories": {
      // -----------------------------------------------------------------------
      // Justice / Superpowers semantic worker categories
      //
      // Justice v4.1.0 が決定するのはsemantic categoryまで。
      // 実際のmodel/provider/reasoning/fallback順序はOmO側の責務。
      // 高頻度の実装とmandatory reviewではモデル系統を分離する。
      // review失敗はTaskAccepted / PlanCompleteを止め得るため、
      // 障害時の自動昇格・降格には必須Gateへの影響を考慮する。
      // モデルPinは実行証明・合格判定を保証するものではない。
      // -----------------------------------------------------------------------
      // 定型・低リスク・高頻度（rename / typo / config / test-only）。
      // 月次Goは使わず、Plus Luna/low → Ollama DeepSeek/low。
      "sp-mechanical": {
        "model": "openai/gpt-6-luna",
        "models": [
          {
            "model": "openai/gpt-6-luna",
            "reasoning": "low"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/deepseek-v4.1-flash",
            "reasoning": "low"
          }
        ],
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/deepseek-v4.1-flash",
            "reasoning": "low"
          }
        ]
      },
      // 通常のTDD実装・反復agentic coding。
      // Plus Luna/maxをPrimaryにし、Ollama GLM Flash/highで補完。
      // さらにPlus Sol/highへ昇格し、月次Go GLM/highは最後に使用。
      // GLM-5.3 fullは自動投入しない。
      "sp-implementation": {
        "model": "openai/gpt-6-luna",
        "models": [
          {
            "model": "openai/gpt-6-luna",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3-flash",
            "reasoning": "high"
          },
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/glm-5.3-flash",
            "reasoning": "high"
          }
        ],
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3-flash",
            "reasoning": "high"
          },
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/glm-5.3-flash",
            "reasoning": "high"
          }
        ]
      },
      // 複数module / API / state / concurrency / async / migrationの統合。
      // Plus Luna/max → Ollama GLM Flash/high → Plus Sol/high。
      // 最後のGo GLM Flash/highのみ月次枠を消費する。
      "sp-integration": {
        "model": "openai/gpt-6-luna",
        "models": [
          {
            "model": "openai/gpt-6-luna",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3-flash",
            "reasoning": "high"
          },
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/glm-5.3-flash",
            "reasoning": "high"
          }
        ],
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3-flash",
            "reasoning": "high"
          },
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/glm-5.3-flash",
            "reasoning": "high"
          }
        ]
      },
      // research / investigate / deep reasoningを担当。
      // OCTG MINI Terra/high → Plus Sol/high。STANDARDは使わない。
      "sp-deep": {
        "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra",
        "models": [
          {
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra",
            "reasoning": "high"
          },
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "high"
          }
        ],
        "fallback_models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "high"
          }
        ]
      },
      // architecture / design system / 高影響設計判断。
      // 小容量STANDARDのAstraを外し、Plus Luna/maxをPrimaryにする。
      // Plus Sol/maxへ昇格後、Terra/highは品質降格に注意した保険。
      "sp-architecture": {
        "model": "openai/gpt-6-luna",
        "models": [
          {
            "model": "openai/gpt-6-luna",
            "reasoning": "max"
          },
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra",
            "reasoning": "high"
          }
        ],
        "fallback_models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra",
            "reasoning": "high"
          }
        ]
      },
      // Task単位のmandatory review。実装側Lunaと異なる系統のDeepSeek/max。
      // Ollama → Plus Sol/high → 月次Go DeepSeek/maxの順に退避。
      // Review失敗はTaskAcceptedを止め得る。失敗をPASSと扱わない。
      "sp-review": {
        "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/deepseek-v4.1-flash",
        "models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/deepseek-v4.1-flash",
            "reasoning": "max"
          },
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/deepseek-v4.1-flash",
            "reasoning": "max"
          }
        ],
        "fallback_models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/deepseek-v4.1-flash",
            "reasoning": "max"
          }
        ]
      },
      // Plan / branch全体のmandatory final review。
      // コストより見落とし・false negative低減を優先する。
      // Plus Sol/maxのみ。Fallback無しで障害時の自動降格を認めない。
      // Gate判定/証拠のruntime検証は別途必要。
      "sp-final-review": {
        "model": "openai/gpt-6.1-sol",
        "models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "max"
          }
        ],
        "fallback_models": []
      },
      // 最上位推論・複雑な設計/監査。公式のGPT Sol系を尊重。
      // Plus Sol/max → OCTG MINI Terra/high（降格に注意）。
      "ultrabrain": {
        "model": "openai/gpt-6.1-sol",
        "models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra",
            "reasoning": "high"
          }
        ],
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra",
            "reasoning": "high"
          }
        ]
      },
      // 深い自律実装と難解バグ修正。公式のSol系推奨に合わせる。
      // Plus Sol/high → OCTG MINI Terra/high。
      "deep": {
        "model": "openai/gpt-6.1-sol",
        "models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra",
            "reasoning": "high"
          }
        ],
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra",
            "reasoning": "high"
          }
        ]
      },
      // 検索・軽微修正・プロトタイプ向け高速タスク。
      // Plus Luna/low。失敗時は週次Ollama DeepSeek/low。
      "quick": {
        "model": "openai/gpt-6-luna",
        "models": [
          {
            "model": "openai/gpt-6-luna",
            "reasoning": "low"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/deepseek-v4.1-flash",
            "reasoning": "low"
          }
        ],
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/deepseek-v4.1-flash",
            "reasoning": "low"
          }
        ]
      },
      // 文書・リリースノート・技術解説。公式Claude/Kimi系適性。
      // Ollama Kimi K2.7 → Sakura → 月次Go。K2.7 Variant未指定。
      "writing": {
        "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code",
        "models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-sakura-ai/preview/Kimi-K2.7-Code"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/kimi-k2.7-code"
          }
        ],
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-sakura-ai/preview/Kimi-K2.7-Code"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/kimi-k2.7-code"
          }
        ]
      },
      // 専門用途に分類できない低負荷の汎用作業。
      // Plus Luna/medium → Ollama DeepSeek/low。月次Goは温存。
      "unspecified-low": {
        "model": "openai/gpt-6-luna",
        "models": [
          {
            "model": "openai/gpt-6-luna",
            "reasoning": "medium"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/deepseek-v4.1-flash",
            "reasoning": "low"
          }
        ],
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/deepseek-v4.1-flash",
            "reasoning": "low"
          }
        ]
      },
      // 専門用途に分類できない高難度の汎用作業。
      // Plus Luna/max → Ollama Kimi K2.7 → Plus Sol/high → Go K2.7。
      // 最終レビュー/高リスク承認の代替にはしない。
      "unspecified-high": {
        "model": "openai/gpt-6-luna",
        "models": [
          {
            "model": "openai/gpt-6-luna",
            "reasoning": "max"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
          },
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/kimi-k2.7-code"
          }
        ],
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
          },
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-opencode-go/kimi-k2.7-code"
          }
        ]
      },
      // UI/UX、CSS、画面構造の視覚系実装。
      // 公式のClaude/Kimi推奨とは異なる意図的なGemini Pro/high例外。
      // Ollama Kimi K2.7 → Plus Luna/maxへFallback。
      "visual-engineering": {
        "model": "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro",
        "models": [
          {
            "model": "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro",
            "reasoning": "high"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
          },
          {
            "model": "openai/gpt-6-luna",
            "reasoning": "max"
          }
        ],
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
          },
          {
            "model": "openai/gpt-6-luna",
            "reasoning": "max"
          }
        ]
      },
      // 創作・アート・表現系。Claude/Kimi系との相性を重視。
      // Ollama Kimi K2.7 → Sakura → Gemini Pro/high。
      "artistry": {
        "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code",
        "models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
          },
          {
            "model": "cloudflare-ai-gateway-custom/custom-sakura-ai/preview/Kimi-K2.7-Code"
          },
          {
            "model": "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro",
            "reasoning": "high"
          }
        ],
        "fallback_models": [
          {
            "model": "cloudflare-ai-gateway-custom/custom-sakura-ai/preview/Kimi-K2.7-Code"
          },
          {
            "model": "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro",
            "reasoning": "high"
          }
        ]
      }
    }
  },

  // ===========================================================================
  // Base Models (デフォルト: personal カタログ)
  //
  // ※ OMO の論理カタログ定義。上述の通りサブエージェント実行時の不整合回避のため、
  //   agents / categories 側には provider/model 完全修飾名を直接記述しています。
  // ※ Dynamic Routes停止中はaliasもpreferred direct providerを指す。実際のcategory/agentは
  //   workload単位のprovider primaryを完全修飾名で明示する。
  // ===========================================================================
  "models": {
    // NOTE: kimi-k3 aliasは意図的に定義しない。
    // K3はautomatic routingから外しており、将来一時的に使う場合も
    // catalog alias経由ではなく完全修飾model IDを明示する。
    // これにより別エージェントが「aliasがあるから通常fallbackに戻してよい」
    // と誤解するのを防ぐ。
    "kimi-k27": {
      "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
    },
    "glm-53": {
      "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3"
    },
    "glm-53-flash": {
      "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/glm-5.3-flash"
    },
    "deepseek-v41-flash": {
      "model": "cloudflare-ai-gateway-custom/custom-opencode-go/deepseek-v4.1-flash"
    },
    // Console Free (native opencode provider; manual selection only).
    // ZDR / no-training per official Console docs as of 2026-10-19.
    "console-free-glm-53-flash": {
      "model": "opencode/glm-5.3-flash-free"
    },
    "console-free-deepseek-v41-flash": {
      "model": "opencode/deepseek-v4.1-flash-free"
    },
    "console-free-minimax-m31-flash": {
      "model": "opencode/minimax-m3.1-flash-free"
    },
    "console-free-longcat-25": {
      "model": "opencode/longcat-2.5-preview-free"
    },
    "kimi-k26": {
      "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.6"
    },
    // OCTG STANDARD aliases. Astra/Sol/Lunaは同じ1M/day poolを共有する。
    "astra-octg": {
      "model": "cloudflare-ai-gateway-octg/gpt-6-astra"
    },
    "sol-octg": {
      "model": "cloudflare-ai-gateway-octg/gpt-6-sol"
    },
    "luna-octg": {
      "model": "cloudflare-ai-gateway-octg/gpt-6-luna"
    },
    "sol": {
      "model": "openai/gpt-6.1-sol"
    },
    "terra-octg": {
      "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra"
    },
    "luna": {
      "model": "openai/gpt-6-luna"
    },
    "gemini-pro": {
      "model": "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro"
    }
  },

  // ===========================================================================
  // Profiles (実行環境別プロファイル定義)
  // ===========================================================================
  "profiles": {

    // =========================================================================
    // PERSONAL プロファイル (個人開発用 / ベース設定をそのまま使用)
    // =========================================================================
    "personal": {},

    // =========================================================================
    // WORK プロファイル (業務環境用 / Amazon Bedrock Claude 統一ポリシー)
    //
    // 【モデルルーティング方針】
    // - Claude Opus 5.5 : 司令塔・最上位推論・高度レビュー
    // - Claude Sonnet 5.5 : 主力実装・プランニング・汎用オーケストレーション
    // - Claude Haiku 4.5: 高速検索・スクリーニング・軽量作業
    // =========================================================================
    "work": {
      // -----------------------------------------------------------------------
      // 論理モデルカタログ (Amazon Bedrock)
      //
      // ※ OMO の論理カタログ定義。サブエージェント実行時の不整合回避のため、
      //   agents / categories 側には provider/model 完全修飾名を直接記述しています。
      // -----------------------------------------------------------------------
      "models": {
        // Claude Fable 5.1 (最上位推論)
        "fable": {
          "model": "amazon-bedrock/global.anthropic.claude-fable-5-1"
        },

        // Claude Opus 5.5 (高性能推論)
        "opus": {
          "model": "amazon-bedrock/global.anthropic.claude-opus-5-5"
        },

        // Claude Sonnet 5.5 (高性能・高速主力)
        "sonnet": {
          "model": "amazon-bedrock/global.anthropic.claude-sonnet-5-5"
        },

        // Claude Haiku 4.5 (超高速・軽量)
        "haiku": {
          "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0"
        }
      },

      "[opencode]": {
        // =====================================================================
        // Agents (業務プロファイル用エージェント定義)
        // =====================================================================
        "agents": {
          // Sisyphus (メイン司令塔: Sonnet -> Opus)
          "sisyphus": {
            // "model": "sonnet",
            "model": "amazon-bedrock/global.anthropic.claude-sonnet-5-5",
            "ultrawork": {
              // "model": "opus",
              "model": "amazon-bedrock/global.anthropic.claude-opus-5-5",
              "reasoning": "high"
            }
          },

          // Hephaestus は業務プロファイルでは無効化
          "hephaestus": {
            "disable": true
          },

          // Oracle (設計相談)
          "oracle": {
            // "model": "opus",
            "model": "amazon-bedrock/global.anthropic.claude-opus-5-5"
          },

          // Librarian (外部調査)
          "librarian": {
            // "model": "haiku",
            "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0"
          },

          // Explore (コード探索)
          "explore": {
            // "model": "haiku",
            "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0"
          },

          // Multimodal Looker (視覚解析)
          "multimodal-looker": {
            // "model": "opus",
            "model": "amazon-bedrock/global.anthropic.claude-opus-5-5"
          },

          // Prometheus (計画立案)
          "prometheus": {
            // "model": "opus",
            "model": "amazon-bedrock/global.anthropic.claude-opus-5-5"
          },

          // Metis (メカニクス分析)
          "metis": {
            // "model": "opus",
            "model": "amazon-bedrock/global.anthropic.claude-opus-5-5"
          },

          // Momus (レビュー)
          "momus": {
            // "model": "opus",
            "model": "amazon-bedrock/global.anthropic.claude-opus-5-5"
          },

          // Atlas (環境管理・進行監視)
          "atlas": {
            // "model": "sonnet",
            "model": "amazon-bedrock/global.anthropic.claude-sonnet-5-5"
          },

          // Review Gate reviewer も業務プロファイル内で Bedrock に固定する。
          "justice-review-controller": {
            "model": "amazon-bedrock/global.anthropic.claude-opus-5-5"
          },
          "justice-review-worker": {
            "model": "amazon-bedrock/global.anthropic.claude-opus-5-5"
          }
        },
        "command": {
          "justice-review-gate": {
            "model": "amazon-bedrock/global.anthropic.claude-opus-5-5"
          }
        },

        // =====================================================================
        // Categories (業務プロファイル用カテゴリ定義)
        //
        // work profileではpersonalのprovider diversityよりも、業務環境の認証・
        // データ境界を優先してBedrock-onlyとする。personal側のGPT/GLM/DeepSeekへ
        // fallbackさせないことが最優先条件。
        //
        // 役割分担:
        // - mechanical: Haiku -> Sonnet
        // - implementation / integration / review: Sonnet -> Opus
        // - deep / architecture / final-review: Opus -> Sonnet
        //
        // runtime_fallback(v4.19.4)互換のため models[1:] と fallback_models を
        // 明示的にmirrorする。将来OmO側でfallback_modelsが完全廃止された場合にのみ、
        // この互換定義の削除を検討する。
        // =====================================================================
        "categories": {
          // Justice / Superpowers semantic worker categories (Bedrock-only)
          "sp-mechanical": {
            "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0",
            "models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0"
              },
              {
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5-5"
              }
            ],
            "fallback_models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5-5"
              }
            ]
          },
          "sp-implementation": {
            "model": "amazon-bedrock/global.anthropic.claude-sonnet-5-5",
            "models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5-5"
              },
              {
                "model": "amazon-bedrock/global.anthropic.claude-opus-5-5",
                "reasoning": "high"
              }
            ],
            "fallback_models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-opus-5-5",
                "reasoning": "high"
              }
            ]
          },
          "sp-integration": {
            "model": "amazon-bedrock/global.anthropic.claude-sonnet-5-5",
            "models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5-5"
              },
              {
                "model": "amazon-bedrock/global.anthropic.claude-opus-5-5",
                "reasoning": "max"
              }
            ],
            "fallback_models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-opus-5-5",
                "reasoning": "max"
              }
            ]
          },
          "sp-deep": {
            "model": "amazon-bedrock/global.anthropic.claude-opus-5-5",
            "models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-opus-5-5",
                "reasoning": "max"
              },
              {
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5-5"
              }
            ],
            "fallback_models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5-5"
              }
            ]
          },
          "sp-architecture": {
            "model": "amazon-bedrock/global.anthropic.claude-opus-5-5",
            "models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-opus-5-5",
                "reasoning": "max"
              },
              {
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5-5"
              }
            ],
            "fallback_models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5-5"
              }
            ]
          },
          "sp-review": {
            "model": "amazon-bedrock/global.anthropic.claude-sonnet-5-5",
            "models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5-5"
              },
              {
                "model": "amazon-bedrock/global.anthropic.claude-opus-5-5",
                "reasoning": "high"
              }
            ],
            "fallback_models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-opus-5-5",
                "reasoning": "high"
              }
            ]
          },
          "sp-final-review": {
            "model": "amazon-bedrock/global.anthropic.claude-opus-5-5",
            "models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-opus-5-5",
                "reasoning": "max"
              },
              {
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5-5"
              }
            ],
            "fallback_models": [
              {
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5-5"
              }
            ]
          },

          // 最上位推論 (Opus/max -> Sonnet)
          "ultrabrain": {
            // "model": "opus",
            "model": "amazon-bedrock/global.anthropic.claude-opus-5-5",
            "models": [
              {
                // "model": "opus",
                "model": "amazon-bedrock/global.anthropic.claude-opus-5-5",
                "reasoning": "max"
              },
              {
                // "model": "sonnet",
                "model": "amazon-bedrock/global.anthropic.claude-sonnet-5-5"
              }
            ],
