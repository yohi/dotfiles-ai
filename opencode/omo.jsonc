          }
        ]
      },
      "unspecified-high": {
        // GOATのGLM-5.3 Flash枠を平常時から使い、Ollama集中を避ける。
        // Justice専用categoryではないが、sp-*と同じfallback invariantを維持する。
        // models末尾のGPT-6 Sol/highとfallback_models末尾は必ず同一にすること。
        "model": "cloudflare-ai-gateway-custom/custom-command-code/z-ai/glm-5.3-flash",
        "models": [
