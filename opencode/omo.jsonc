// OMO configuration
// Migrated to omo native profiles (v4.19.4+)
// Native profiles: personal / work
// Activation: OMO_PROFILE=personal|work
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",

  // ===========================================================================
  // OpenCode shared configuration
  // ===========================================================================
  "[opencode]": {
    "team_mode": {
      "enabled": false,
      "base_dir": ".sisyphus/team",
      "auto_sync": true
    },

    "sisyphus_agent": {
      "disabled": false,
      "planner_enabled": true,
      "replace_plan": true,
      "default_builder_enabled": true
    },

    "experimental": {
      "task_system": true,
      "aggressive_truncation": true,

      // Replaces the old unsupported
      // preemptive_compaction_threshold setting.
      "preemptive_compaction": true
    },

    "tmux": {
      "enabled": true,
      "layout": "main-vertical",
      "main_pane_size": 65
    },

    "browser_automation_engine": {
      "provider": "playwright-cli"
    },

    // Keep existing limits for Step 1.
    // Model/provider-specific optimization comes later.
    "background_task": {
      "defaultConcurrency": 10,
      "providerConcurrency": {
        "openai": 5,
        "nvidia": 10,
        "minimax": 5,
        "google": 20,
        "opencode": 5,
        "sakura": 5
      }
    },

    // Runtime model fallback.
    // Important for quota exhaustion / 429 handling.
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [
        429,
        500,
        502,
        503,
        504
      ],
      "max_fallback_attempts": 3,
      "cooldown_seconds": 60,
      "timeout_seconds": 30,
      "notify_on_fallback": true,
      "restore_primary_after_cooldown": true
    },

    // Ralph Loop -> Goal
    "goal": {
      "enabled": true,
      "auto_start": false,
      "default_max_iterations": 20
    },

    "default_mode": {
      "goal": false
    },

    "git_master": {
      "commit_footer": false,
      "include_co_authored_by": false
    },

    "comment_checker": {
      "enabled": true
    },

    "disabled_hooks": [
      "auto-update-checker"
    ],

    "hashline_edit": true,

    // Environment variables exposed to MCPs.
    "mcp_env_allowlist": [
      "HOME",
      "CHRONOS_POSTGRES_HOST",
      "CHRONOS_POSTGRES_PASSWORD",
      "CHRONOS_NEO4J_URI",
      "CHRONOS_NEO4J_PASSWORD",
      "CHRONOS_REDIS_URL",
      "CHRONOS_POSTGRES_PORT",
      "CHRONOS_POSTGRES_DB",
      "CHRONOS_POSTGRES_USER",
      "CHRONOS_POSTGRES_SSL",
      "CHRONOS_GRAPH_ENABLED",
      "CHRONOS_NEO4J_USER",
      "CHRONOS_CACHE_BACKEND",
      "CHRONOS_REDIS_SSL",
      "CHRONOS_DECAY_HALF_LIFE_DAYS",
      "CHRONOS_SIMILARITY_THRESHOLD",
      "CHRONOS_DEDUP_THRESHOLD",
      "CHRONOS_EMBEDDING_PROVIDER",
      "CHRONOS_LOCAL_MODEL_NAME",
      "CHRONOS_EMBEDDING_DIMENSION"
    ]
  },

  // ===========================================================================
  // Profiles
  // ===========================================================================
  "profiles": {
    // =========================================================================
    // PERSONAL
    // =========================================================================
    "personal": {
      // -----------------------------------------------------------------------
      // Logical model catalog
      //
      // Keep provider routing in one place.
      // Agent/category definitions below refer to these aliases.
      // -----------------------------------------------------------------------
      "models": {
        "kimi-k27": {
          "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.7-code"
        },
        "kimi-k26": {
          "model": "cloudflare-ai-gateway-custom/custom-ollama-cloud/kimi-k2.6"
        },

        "sol-octg": {
          "model": "cloudflare-ai-gateway-octg/gpt-5.6-sol"
        },
        "sol-plus": {
          "model": "openai/gpt-5.6-sol"
        },

        "terra-octg": {
          "model": "cloudflare-ai-gateway-octg/gpt-5.6-terra"
        },
        "terra-plus": {
          "model": "openai/gpt-5.6-terra"
        },

        "luna-octg": {
          "model": "cloudflare-ai-gateway-octg/gpt-5.6-luna"
        },
        "luna-plus": {
          "model": "openai/gpt-5.6-luna"
        },

        "gemini-pro": {
          "model": "cloudflare-ai-gateway/google/gemini-3.1-pro"
        },
        "gemini-pro-ai-studio": {
          "model": "cloudflare-ai-gateway/google-ai-studio/gemini-3.1-pro"
        }
      },

      "[opencode]": {
        "agents": {
          // -------------------------------------------------------------------
          // Primary agents
          // -------------------------------------------------------------------

          "sisyphus": {
            "models": [
              "kimi-k27",
              {
                "model": "sol-plus",
                "reasoning": "default"
              },
              {
                "model": "sol-octg",
                "reasoning": "default"
              }
            ],

            // NOTE:
            // Previous config had variant=max AND reasoning=high.
            // `reasoning` is canonical, so Step 1 preserves "high".
            "ultrawork": {
              "model": "sol-plus",
              "reasoning": "high"
            }
          },

          "hephaestus": {
            "disable": false,
            "models": [
              {
                "model": "terra-octg",
                "reasoning": "medium"
              },
              {
                "model": "terra-plus",
                "reasoning": "medium"
              },
              {
                "model": "luna-octg",
                "reasoning": "medium"
              },
              {
                "model": "luna-plus",
                "reasoning": "medium"
              }
            ]
          },

          // -------------------------------------------------------------------
          // Specialist subagents
          // -------------------------------------------------------------------

          "oracle": {
            "models": [
              {
                "model": "sol-octg",
                "reasoning": "high"
              },
              {
                "model": "sol-plus",
                "reasoning": "high"
              }
            ]
          },

          "librarian": {
            "models": [
              {
                "model": "luna-octg",
                "reasoning": "low"
              },
              {
                "model": "luna-plus",
                "reasoning": "low"
              }
            ]
          },

          "explore": {
            "models": [
              {
                "model": "luna-octg",
                "reasoning": "medium"
              },
              {
                "model": "luna-plus",
                "reasoning": "medium"
              }
            ]
          },

          "multimodal-looker": {
            "models": [
              "gemini-pro",
              "kimi-k27"
            ]
          },

          // -------------------------------------------------------------------
          // Planning / orchestration
          // -------------------------------------------------------------------

          "prometheus": {
            "models": [
              {
                "model": "sol-octg",
                "reasoning": "max"
              },
              {
                "model": "sol-plus",
                "reasoning": "max"
              },
              "kimi-k27"
            ]
          },

          "metis": {
            "models": [
              "kimi-k27",
              "kimi-k26"
            ]
          },

          "momus": {
            "models": [
              {
                "model": "sol-octg",
                "reasoning": "xhigh"
              },
              {
                "model": "sol-plus",
                "reasoning": "xhigh"
              },
              "kimi-k27"
            ]
          },

          "atlas": {
            "models": [
              "kimi-k27",
              {
                "model": "sol-octg",
                "reasoning": "default"
              },
              {
                "model": "sol-plus",
                "reasoning": "default"
              }
            ]
          }
        },

        "categories": {
          "ultrabrain": {
            "models": [
              "kimi-k27",
              "sol-octg",
              "sol-plus"
            ]
          },

          "deep": {
            "models": [
              {
                "model": "terra-octg",
                "reasoning": "xhigh"
              },
              {
                "model": "terra-plus",
                "reasoning": "xhigh"
              },
              "kimi-k27"
            ]
          },

          "quick": {
            "models": [
              {
                "model": "luna-octg",
                "reasoning": "low"
              },
              {
                "model": "luna-plus",
                "reasoning": "low"
              }
            ]
          },

          "writing": {
            "models": [
              "kimi-k27"
            ]
          },

          "unspecified-low": {
            "models": [
              {
                "model": "luna-octg",
                "reasoning": "xhigh"
              },
              {
                "model": "luna-plus",
                "reasoning": "xhigh"
              }
            ]
          },

          "unspecified-high": {
            "models": [
              {
                "model": "sol-octg",
                "reasoning": "high"
              },
              {
                "model": "sol-plus",
                "reasoning": "high"
              },
              "kimi-k27"
            ]
          },

          "visual-engineering": {
            "models": [
              {
                "model": "gemini-pro",
                "reasoning": "high"
              },
              "kimi-k27"
            ]
          },

          "artistry": {
            "models": [
              {
                "model": "gemini-pro-ai-studio",
                "reasoning": "high"
              },
              "kimi-k27"
            ]
          }
        }
      }
    },

    // =========================================================================
    // WORK
    // =========================================================================
    "work": {
      "models": {
        "opus": {
          "model": "amazon-bedrock/global.anthropic.claude-opus-5"
        },
        "sonnet": {
          "model": "amazon-bedrock/global.anthropic.claude-sonnet-5"
        },
        "haiku": {
          "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0"
        }
      },

      "[opencode]": {
        "agents": {
          "sisyphus": {
            "models": [
              {
                "model": "sonnet",
                "reasoning": "max"
              },
              {
                "model": "opus",
                "reasoning": "max"
              }
            ],
            "ultrawork": {
              "model": "opus",
              "reasoning": "high"
            }
          },

          "hephaestus": {
            "disable": true
          },

          "oracle": {
            "models": [
              {
                "model": "opus",
                "reasoning": "max"
              },
              "sonnet"
            ]
          },

          "librarian": {
            "models": [
              "haiku",
              "sonnet"
            ]
          },

          "explore": {
            "models": [
              "haiku",
              "sonnet"
            ]
          },

          "multimodal-looker": {
            "models": [
              {
                "model": "opus",
                "reasoning": "max"
              },
              "sonnet"
            ]
          },

          "prometheus": {
            "models": [
              {
                "model": "opus",
                "reasoning": "max"
              },
              "sonnet"
            ]
          },

          "metis": {
            "models": [
              {
                "model": "opus",
                "reasoning": "max"
              },
              "sonnet"
            ]
          },

          "momus": {
            "models": [
              {
                "model": "opus",
                "reasoning": "max"
              },
              "sonnet"
            ]
          },

          "atlas": {
            "models": [
              "sonnet",
              "haiku"
            ]
          }
        },

        "categories": {
          "ultrabrain": {
            "models": [
              {
                "model": "opus",
                "reasoning": "max"
              },
              "sonnet"
            ]
          },

          "deep": {
            "models": [
              {
                "model": "opus",
                "reasoning": "max"
              },
              "sonnet"
            ]
          },

          "quick": {
            "models": [
              "haiku",
              "sonnet"
            ]
          },

          "writing": {
            "models": [
              "sonnet",
              "haiku"
            ]
          },

          "unspecified-low": {
            "models": [
              "sonnet",
              "haiku"
            ]
          },

          "unspecified-high": {
            "models": [
              {
                "model": "opus",
                "reasoning": "max"
              },
              "sonnet"
            ]
          },

          "visual-engineering": {
            "models": [
              {
                "model": "opus",
                "reasoning": "max"
              },
              "sonnet"
            ]
          },

          "artistry": {
            "models": [
              "sonnet",
              "haiku"
            ]
          }
        }
      }
    }
  },

  "_migrations": [
    "2026-07-opencode-config-unification"
  ]
}
