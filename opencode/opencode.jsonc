{
  // Config Modernized: 2026-02-20
  // Target OpenCode Version: v1.3.x
  // Based on oh-my-opencode v3.7.4
  "$schema": "https://opencode.ai/config.json",
  // モデル
  //"model": "gemini-3-pro-preview",
  //"small_model": "gemini-3-flash-preview",
  // ログレベル設定（デバッグ用）
  // "logLevel": "DEBUG",
  // [Plugin]
  "plugin": [
    "oh-my-opencode@3.10.0",
    "opencode-openai-codex-auth@^1.0.0",
    // "opencode-antigravity-auth@beta",
    // "@yohi/opencode-antigravity-quota@^1.0.0",
    "@yohi/opencode-codex-quota@^1.0.0",
    // "@yohi/omo-sdd-hybrid",
    "opencode-geminicli-a2a-provider",
  ],
  // [Instruction]
  "instructions": [],
  // [Watcher]
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/.next/**",
      "**/coverage/**",
      "**/*.lock",
      "**/.cursorrules"
    ]
  },
  "compaction": {
    "auto": true,
    "reserved": 10000,
    "prune": true,
  },
  // [Permission]
  "permission": {
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "codesearch": "allow",
    "todoread": "allow",
    "edit": "allow",
    "todowrite": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "external_directory": "allow",
    "lsp": "allow", // [New] v1.3 LSP permission
    "skill": "allow", // [New] v1.3 Skill permission
    "task": "allow", // [New] v1.3 Task permission
    "bash": {
      "*": "allow", // 極限緩和: ask -> allow (デフォルト許可)
      
      // --- 安全弁 (ask) ---
      "git push*": "ask",
      "git reset*": "ask",
      "npm publish*": "deny", // 緩和: deny -> ask
      
      // --- 禁止 (deny) ---
      "git add .": "deny", // 一括追加は禁止を維持
      "rm *": "deny",
      "rm -rf *": "deny",
      "ssh *": "deny",
      "sudo *": "deny",
      "su *": "deny"
    }
  },

  "experimental": {
    "batch_tool": true, // [New] Enable batching for faster execution
    "continue_loop_on_deny": true // [New] Continue thinking on permission denial
  },
  // [MCP]
  "mcp": {
    "docker-mcp-gateway": {
      "type": "remote",
      "url": "http://localhost:10888/sse",
      "enabled": true
    }
  },
  // [LSP] 言語サーバー連携 (コードの構造的理解)
  "lsp": {
    "bash-language-server": {
      "command": [
        "bash-language-server",
        "start"
      ],
      "extensions": [
        ".sh"
      ],
      "disabled": false
    },
    "typescript-language-server": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mts",
        ".cts"
      ],
      "disabled": false
    },
    "pyright": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py"
      ],
      "disabled": false
    }
  },
  // プロバイダ設定
  "provider": {
    "opencode-geminicli-a2a": {
      "npm": "opencode-geminicli-a2a",
      "options": {
        "host": "127.0.0.1",
        "port": 41242,
        "protocol": "http"
      },
      "models": {
        "gemini-3.1-pro-preview": {},
        "gemini-3-flash-preview": {},
        "gemini-2.5-pro": {}
      }
    },
    "stellar-gemini": {
      "npm": "@ai-sdk/google",
      "name": "Stellar Gemini (OAuth)",
      "options": {
        "apiKey": "not-needed",
        "baseURL": "http://localhost:8742"
      },
      "models": {
        "gemini-3.1-pro-preview": {
          "name": "Gemini 3.1 Pro (Latest)",
          "limit": { "context": 1048576, "output": 65536 }
        },
        "gemini-3-flash-preview": {
          "name": "Gemini 3 Flash",
          "limit": { "context": 1000000, "output": 65536 }
        },
        "gemini-2.5-pro": {
          "name": "Gemini 2.5 Pro",
          "limit": { "context": 128000, "output": 65536 }
        }
      }
    },
    "zerogravity": {
      "npm": "@ai-sdk/google",
      "name": "ZeroGravity (Gemini)",
      "options": {
        "apiKey": "not-needed",
        "baseURL": "http://localhost:8741/v1beta",
      },
      "models": {
        "gemini-3.1-pro": {
          "name": "Gemini 3.1 Pro",
          "limit": { "context": 1048576, "output": 65535 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": {
            "low": { "thinkingLevel": "low" },
            "high": { "thinkingLevel": "high" }
          }
        },
        "gemini-3-flash": {
          "name": "Gemini 3 Flash",
          "limit": { "context": 1048576, "output": 65536 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": {
            "minimal": { "thinkingLevel": "minimal" },
            "low": { "thinkingLevel": "low" },
            "medium": { "thinkingLevel": "medium" },
            "high": { "thinkingLevel": "high" }
          }
        },
        "sonnet-4.6": {
          "name": "Claude Sonnet 4.6",
          "limit": { "context": 200000, "output": 64000 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] }
        },
        "opus-4.6": {
          "name": "Claude Opus 4.6 Thinking",
          "limit": { "context": 200000, "output": 64000 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": {
            "low": { "thinkingConfig": { "thinkingBudget": 8192 } },
            "max": { "thinkingConfig": { "thinkingBudget": 32768 } }
          }
        },
      },
    },
    // Vertex AI(Google)
    // [For LLM Context]
    // - Documantatin:
    //     - http://ai.google.dev/gemini-api/docs/models/gemini-3.1-pro-preview.md.txt
    "google-vertex": {
      "models": {
        "gemini-3-flash-preview": {},
        "gemini-3.1-pro-preview": {},
        "gemini-3.1-pro-preview-customtools": {},
      },
    },
    // Vertex AI Anthopic(Google)
    "google-vertex-anthropic": {
      "models": {
        "claude-haiku-4-5@20251001": {},
        "claude-sonnet-4-6@default": {},
        "claude-opus-4-6@default": {},
      },
    },
    // OpenAI
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": [
          "reasoning.encrypted_content"
        ],
        "store": false
      },
      "models": {
        "gpt-5.3-codex": {
          "name": "GPT 5.3 Codex (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.2": {
          "name": "GPT 5.2 (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "none": {
              "reasoningEffort": "none",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.1-codex-max": {
          "name": "GPT 5.1 Codex Max (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            }
          }
        },
      },
    }, // End Provider
  },
}
