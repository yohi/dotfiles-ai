// vim: ft=jsonc
// Config Modernized: 2026-05-09
// Target OpenCode Version: v1.14.41

/**
 * OpenCode Core Configuration
 *
 * [概要]
 * このファイルは OpenCode の推論エンジン、権限、およびバックエンド動作を定義します。
 * [Plugin] や [MCP] などのマーカーは自動化ツールのアンカーとして機能するため、
 * 位置を変更せずに保持してください。
 */
{
  "$schema": "https://opencode.ai/config.json",

  "default_agent": "sisyphus",
  "shell": "bash",
  "snapshot": true,

  // --------------------------------------------------------------------------
  // [Plugin] - エコシステム設定
  // --------------------------------------------------------------------------
  // [Plugin]
  "plugin": [
    "@yohi/opencode-codex-quota@1.0.0",
    "@yohi/justice@2.2.0",
    // "@yohi/opencode-cursor-plugin@1.3.8",
    "oh-my-openagent@4.2.2"
  ],

  // --------------------------------------------------------------------------
  // Permission - 権限とガードレール
  // --------------------------------------------------------------------------
  "permission": {
    "*": "ask",
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "lsp": "allow",
    "skill": "allow",
    "websearch": "allow",
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "cat": "allow",
      "cat *": "allow",
      "head": "allow",
      "head *": "allow",
      "tail": "allow",
      "tail *": "allow",
      "mkdir": "allow",
      "mkdir *": "allow",
      "touch": "allow",
      "touch *": "allow",
      "cp": "allow",
      "cp *": "allow",
      "mv": "allow",
      "mv *": "allow",
      "make": "allow",
      "make *": "allow",
      "uv": "allow",
      "uv *": "allow",
      "python": "ask",
      "node": "ask",
      "bun": "ask",
      "git status": "allow",
      "git status *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git branch": "allow",
      "git add": "allow",
      "git commit": "allow",
      "git commit *": "allow",
      "git add .": "deny",
      "git add *": "deny",
      "git add -A": "deny",
      "git add --all": "deny",
      "git add -u": "deny",
      "git add :/": "deny",
      "rm -rf *": "deny",
      "npm publish*": "deny",
      "sudo *": "deny",
      "su *": "deny",
      "curl* | sh": "deny",
      "curl *|sh": "deny",
      "curl * | sh": "deny",
      "bash _scripts/*": "deny",
      "curl*|sh": "deny",
      "bun run lint*": "allow",
      "bun run typecheck*": "allow",
      "bun run test*": "allow",
      "eslint*": "allow"
    }
  },

  // --------------------------------------------------------------------------
  // Compaction & Lifecycle
  // --------------------------------------------------------------------------
  "compaction": {
    "auto": true,
    "reserved": 15000,
    "tail_turns": 3,
    "prune": true
  },

  "share": "manual",

  // --------------------------------------------------------------------------
  // LSP - 言語サーバー設定
  // --------------------------------------------------------------------------
  "lsp": {
    "typescript-language-server": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx"
      ],
      "initialization": {
        "preferences": {
          "includeInlayParameterNameHints": "all",
          "includeInlayVariableTypeHints": true,
          "includeInlayFunctionParameterTypeHints": true,
          "disableSuggestions": false
        },
        "diagnostics": {
          "ignoredCodes": [
            6133
          ]
        }
      }
    },
    "bash-language-server": {
      "command": [
        "bash-language-server",
        "start"
      ],
      "extensions": [
        ".sh"
      ]
    },
    "pyright": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py"
      ],
      "initialization": {
        "python": {
          "analysis": {
            "typeCheckingMode": "strict",
            "autoSearchPaths": true,
            "useLibraryCodeForTypes": true
          }
        }
      }
    },
    "markdownlint": {
      "command": [
        "npx",
        "markdownlint-lsp",
        "--stdio"
      ],
      "extensions": [
        ".md"
      ]
    },
    "mypy": {
      "command": [
        "mypy",
        "--ignore-missing-imports",
        "--follow-imports=silent",
        "--strict"
      ],
      "extensions": [
        ".py"
      ]
    },
    "shellcheck": {
      "command": [
        "shellcheck",
        "-f",
        "gcc",
        "--severity=style"
      ],
      "extensions": [
        ".sh"
      ]
    },
    "eslint": {
      "command": [
        "eslint",
        "--format",
        "stylish",
        "--max-warnings",
        "0"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx"
      ]
    }
  },

  "instructions": [
    "global-rules/AGENTS.global.md",
    "agent-skills/superpowers/using-superpowers/SKILL.md"
  ],

  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/coverage/**",
      "**/*.lock",
      "**/.git/**"
    ]
  },

  // --------------------------------------------------------------------------
  // Providers & Models (2026-05 Latest)
  // --------------------------------------------------------------------------
  "enabled_providers": [
    // "google",
    "openai",
    "nvidia",
    "cloudflare-workers-ai",
    "opencode",
    // "cursor",
    "sakura"
  ],
  "provider": {
    // "google": {
    //   "whitelist": [
    //     "gemini-3-flash-preview",
    //     "gemini-3.1-flash-image-preview",
    //     "gemini-3.1-flash-lite",
    //     "gemini-3.1-flash-lite-preview",
    //     "gemini-3.1-pro-preview",
    //     "gemini-3.1-pro-preview-customtools",
    //   ]
    // },
    "openai": {
      "whitelist": [
        "gpt-5.3-codex",
        "gpt-5.3-codex-spark",
        "gpt-5.4",
        "gpt-5.4-mini",
        "gpt-5.5",
      ]
    },
    "nvidia": {
      "whitelist": [
        "minimaxai/minimax-m2.5",
        "minimaxai/minimax-m2.7",
        "z-ai/glm4.7",
       "qwen/qwen3-coder-480b-a35b-instruct",
      ]
    },
    "cloudflare-workers-ai": {
      "whitelist": [
        "@cf/google/gemma-4-26b-a4b-it",
        "@cf/meta/llama-4-scout-17b-16e-instruct",
        // "@cf/moonshotai/kimi-k2.5",
        "@cf/moonshotai/kimi-k2.6",
        "@cf/nvidia/nemotron-3-120b-a12b",
        "@cf/openai/gpt-oss-120b",
        "@cf/openai/gpt-oss-20b",
        "@cf/zai-org/glm-4.7-flash",
      ]
    },
    "opencode": {
      "whitelist": [
        "minimax-m2.5-free",
        "nemotron-3-super-free",
        "deepseek-v4-flash-free",
        "big-pickle",
      ]
    },
    // "cursor":{
    //   "whitelist": [
    //     "claude-haiku-4-5",
    //     "claude-opus-4-7",
    //     "claude-sonnet-4-6",
    //     "composer-2",
    //     "gemini-3-flash",
    //     "gemini-3.1-pro",
    //     "gpt-5.3-codex",
    //     "gpt-5.3-codex-spark",
    //     "gpt-5.4",
    //     "gpt-5.4-mini",
    //     "gpt-5.4-nano",
    //     "gpt-5.5",
    //   ]
    // },
    "sakura": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "sakura aipf",
      "options": {
        "baseURL": "https://api.ai.sakura.ad.jp/v1"
      },
      "models": {
        "preview/Kimi-K2.6": {
          "name": "Kimi-K2.6"
        }
      }
    }
  },

  "experimental": {
    "batch_tool": true,
    "openTelemetry": true,
    "continue_loop_on_deny": false,
    "mcp_timeout": 15000
  },

  // --------------------------------------------------------------------------
  // [MCP] - サーバー設定
  // --------------------------------------------------------------------------
  // [MCP]
  "mcp": {
    "docker-mcp": {
      "url": "http://127.0.0.1:10888/sse",
      "headers": {
        "Authorization": "Bearer {env:MCP_GATEWAY_TOKEN}"
      },
      "type": "remote",
      "enabled": true
    },
    "skillport": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "skillport-mcp"

      ]
    },
    "nexus": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@yohi/nexus@1.7.0"
      ]
    },
    "chronos-graph": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/yohi/chronos-graph.git[all]",
        "context-store"
      ],
      "environment": {
        "STORAGE_BACKEND": "{env:STORAGE_BACKEND}",
        "GRAPH_ENABLED": "{env:GRAPH_ENABLED}",
        "POSTGRES_HOST": "{env:POSTGRES_HOST}",
        "POSTGRES_PORT": "{env:POSTGRES_PORT}",
        "POSTGRES_DB": "{env:POSTGRES_DB}",
        "POSTGRES_USER": "{env:POSTGRES_USER}",
        "POSTGRES_PASSWORD": "{env:POSTGRES_PASSWORD}",
        "POSTGRES_SSL": "{env:POSTGRES_SSL}",
        "NEO4J_URI": "{env:NEO4J_URI}",
        "NEO4J_USER": "{env:NEO4J_USER}",
        "NEO4J_PASSWORD": "{env:NEO4J_PASSWORD}",
        "CACHE_BACKEND": "{env:CACHE_BACKEND}",
        "REDIS_URL": "{env:REDIS_URL}",
        "REDIS_SSL": "{env:REDIS_SSL}",
        "EMBEDDING_PROVIDER": "{env:EMBEDDING_PROVIDER}",
        "LOCAL_MODEL_NAME": "{env:LOCAL_MODEL_NAME}",
        "EMBEDDING_DIMENSION": "{env:EMBEDDING_DIMENSION}",
        "SIMILARITY_THRESHOLD": "{env:SIMILARITY_THRESHOLD}",
        "DEDUP_THRESHOLD": "{env:DEDUP_THRESHOLD}",
        "DEFAULT_TOP_K": "{env:DEFAULT_TOP_K}",
        "DECAY_HALF_LIFE_DAYS": "{env:DECAY_HALF_LIFE_DAYS}",
        "ARCHIVE_THRESHOLD": "{env:ARCHIVE_THRESHOLD}",
        "PURGE_RETENTION_DAYS": "{env:PURGE_RETENTION_DAYS}",
        "DASHBOARD_HOST": "{env:DASHBOARD_HOST}",
        "DASHBOARD_PORT": "{env:DASHBOARD_PORT}"
      }
    }
  }
}
