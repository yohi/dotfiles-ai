{
  "mcp": {
    "skillport": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "skillport-mcp"
      ],
      "environment": {
        "SKILLPORT_SKILLS_DIR": "${HOME}/dotfiles/components/dotfiles-ai/agent-skills"
      }
    },
    "nexus": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@yohi/nexus@1.7.0"
      ],
      "environment": {
        "NEXUS_STORAGE_ROOT_DIR": "${HOME}/.nexus",
        "NO_PROXY": "127.0.0.1,localhost"
      }
    },
    "SQLite": {
      "type": "remote",
      "enabled": true,
      "url": "http://127.0.0.1:10888/sse?server=SQLite"
    },
    "github-official": {
      "type": "remote",
      "enabled": true,
      "url": "http://127.0.0.1:10888/sse?server=github-official"
    },
    "sequentialthinking": {
      "type": "remote",
      "enabled": true,
      "url": "http://127.0.0.1:10888/sse?server=sequentialthinking"
    }
  }
}