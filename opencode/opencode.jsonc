{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "skillport": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "skillport-mcp"
      ]
    },
    "nexus": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@yohi/nexus@1.7.0"
      ]
    },
    "chronos-graph": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/yohi/chronos-graph.git",
        "context-store"
      ]
    }
  }
}