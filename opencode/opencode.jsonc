// Config Modernized: 2026-05-09
// Target OpenCode Version: v1.14.41
// vim: ft=jsonc
/**
 * OpenCode Core Configuration - v1.14.41 Optimized
 * 
 * [概要]
 * このファイルは OpenCode の推論エンジン、権限、およびバックエンド動作を定義します。
 * [Plugin] や [MCP] などのマーカーは自動化ツールのアンカーとして機能するため、
 * 位置を変更せずに保持してください。
 */
{
  "$schema": "https://opencode.ai/config.json",

  "default_agent": "sisyphus",
  "shell": "bash",
  "snapshot": true,

  // --------------------------------------------------------------------------
  // [Plugin] - エコシステム設定
  // --------------------------------------------------------------------------
  // [Plugin]
  "plugin": [
    "@yohi/opencode-codex-quota@1.1.0",
    "@yohi/justice@2.3.0",
    "@yohi/opencode-cursor-plugin@1.4.0",
    "oh-my-openagent@v4.0.0"
  ],

  // --------------------------------------------------------------------------
  // Permission - 権限とガードレール
  // --------------------------------------------------------------------------
  "permission": {
    "*": "ask",
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "lsp": "allow",
    "skill": "allow",
    "websearch": "allow",
    "shell": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "cat": "allow",
      "cat *": "allow",
      "head": "allow",
      "head *": "allow",
      "tail": "allow",
      "tail *": "allow",
      "mkdir": "allow",
      "mkdir *": "allow",
      "touch": "allow",
      "touch *": "allow",
      "cp": "allow",
      "cp *": "allow",
      "mv": "allow",
      "mv *": "allow",
      "make": "allow",
      "make *": "allow",
      "uv": "allow",
      "uv *": "allow",
      "python": "ask",
      "node": "ask",
      "bun": "ask",
      "git status": "allow",
      "git status *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git branch": "allow",
      "git add": "allow",
      "git add *": "allow",
      "git commit": "allow",
      "git commit *": "allow",
      "git add .": "deny",
      "rm -rf *": "deny",
      "npm publish*": "deny",
      "sudo *": "deny",
      "curl*|sh": "deny",
      "bun run lint*": "allow",
      "bun run typecheck*": "allow",
      "bun run test*": "allow",
      "eslint*": "allow"
    }
  },

  // --------------------------------------------------------------------------
  // Compaction & Lifecycle
  // --------------------------------------------------------------------------
  "compaction": {
    "auto": true,
    "reserved": 15000,
    "tail_turns": 3,
    "prune": true
  },

  "share": "manual",

  // --------------------------------------------------------------------------
  // LSP - 言語サーバー設定
  // --------------------------------------------------------------------------
  "lsp": {
    "typescript-language-server": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx"
      ],
      "initialization": {
        "preferences": {
          "includeInlayParameterNameHints": "all",
          "includeInlayVariableTypeHints": true,
          "includeInlayFunctionParameterTypeHints": true,
          "disableSuggestions": false
        },
        "diagnostics": {
          "ignoredCodes": [
            6133
          ]
        }
      }
    },
    "bash-language-server": {
      "command": [
        "bash-language-server",
        "start"
      ],
      "extensions": [
        ".sh"
      ]
    },
    "pyright": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py"
      ],
      "initialization": {
        "python": {
          "analysis": {
            "typeCheckingMode": "strict",
            "autoSearchPaths": true,
            "useLibraryCodeForTypes": true
          }
        }
      }
    },
    "markdownlint": {
      "command": [
        "npx",
        "markdownlint-lsp",
        "--stdio"
      ],
      "extensions": [
        ".md"
      ]
    },
    "mypy": {
      "command": [
        "mypy",
        "--ignore-missing-imports",
        "--follow-imports=silent",
        "--strict"
      ],
      "extensions": [
        ".py"
      ]
    },
    "shellcheck": {
      "command": [
        "shellcheck",
        "-f",
        "gcc",
        "--severity=style"
      ],
      "extensions": [
        ".sh"
      ]
    },
    "eslint": {
      "command": [
        "eslint",
        "--format",
        "compact",
        "--max-warnings",
        "0"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx"
      ]
    }
  },

  "instructions": [
    "global-rules/AGENTS.global.md",
    "agent-skills/superpowers/using-superpowers/SKILL.md"
  ],

  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/coverage/**",
      "**/*.lock",
      "**/.git/**"
    ]
  },

  // --------------------------------------------------------------------------
  // Providers & Models (2026-05 Latest)
  // --------------------------------------------------------------------------
  "enabled_providers": [
    "anthropic",
    "google",
    "openai",
    "amazon-bedrock",
    "cloudflare-workers-ai",
    "nvidia",
    "opencode"
  ],
  "provider": {
    "anthropic": {
      "options": {
        "timeout": 600000,
        "setCacheKey": true
      },
      "whitelist": [
        "claude-4-7-opus-latest",
        "claude-4-6-sonnet-latest",
        "claude-4-5-haiku-latest"
      ]
    },
    "google": {
      "whitelist": [
        "gemini-3-1-pro-latest",
        "gemini-3-1-flash-latest",
        "gemini-3-1-flash-lite",
        "gemini-3-deep-think"
      ]
    },
    "openai": {
      "whitelist": [
        "gpt-5-5-thinking-latest",
        "gpt-5-5-instant-latest",
        "o3-pro-latest",
        "o4-mini-latest"
      ]
    },
    "amazon-bedrock": {
      "options": {
        "region": "us-east-1"
      },
      "whitelist": [
        "anthropic.claude-opus-4-7",
        "anthropic.claude-sonnet-4-6",
        "anthropic.claude-haiku-4-5-20251001-v1:0"
      ]
    },
    "nvidia": {
      "whitelist": [
        "meta/llama-4-maverick-400b-moe",
        "alibaba/qwen-3-5-397b-a17b",
        "mistral/mistral-large-3",
        "nvidia/nemotron-3-super-120b"
      ]
    },
    "opencode": {
      "whitelist": [
        "deepseek-v4-pro-moe",
        "minimax-m2-5-free",
        "big-pickle-turbo"
      ]
    }
  },

  "experimental": {
    "batch_tool": true,
    "openTelemetry": true,
    "continue_loop_on_deny": false,
    "mcp_timeout": 15000
  },

  // --------------------------------------------------------------------------
  // [MCP] - サーバー設定
  // --------------------------------------------------------------------------
  // [MCP]
  "mcp": {
    "docker-mcp": {
      "url": "http://127.0.0.1:10888/sse",
      "headers": {
        "Authorization": "Bearer {env:MCP_GATEWAY_TOKEN}"
      },
      "type": "remote",
      "enabled": true
    }
  }
}
