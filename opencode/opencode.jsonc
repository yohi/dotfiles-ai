// vim: ft=jsonc
// Config Modernized: 2026-05-27
// Target OpenCode Version: v1.15.10

/**
 * OpenCode Core Configuration
 *
 * [概要]
 * このファイルは OpenCode の推論エンジン、権限、およびバックエンド動作を定義します。
 * [Plugin] や [MCP] などのマーカーは自動化ツールのアンカーとして機能するため、
 * 位置を変更せずに保持してください。
 */
{
  "$schema": "https://opencode.ai/config.json",

  "default_agent": "sisyphus",
  "shell": "bash",
  "snapshot": true,

  // --------------------------------------------------------------------------
  // [Plugin] - エコシステム設定
  // --------------------------------------------------------------------------
  // [Plugin]
  "plugin": [
    // "@yohi/opencode-codex-quota@1.0.0",
    "@yohi/justice@2.3.0",
    // "@yohi/opencode-cursor-plugin@1.3.8",
    "oh-my-openagent@4.5.1"
  ],

  // 使用しないプロバイダーを解決チェーンから明示的にブロック (v4.3.0 新機能)
  "disabled_providers": [
    "google",
    "cursor"
  ],

  // --------------------------------------------------------------------------
  // Permission - 権限とガードレール
  // --------------------------------------------------------------------------
  "permission": {
    "*": "ask",
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "skill": "allow",
    "lsp": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "context": "allow",
    "skillport_*": "allow",
    "mcp_skillport_*": "allow",
    "mcp__skillport__*": "allow",
    "skillport_load_skill": "allow",
    "nexus_*": "allow",
    "mcp_nexus_*": "allow",
    "chronos-graph_*": "allow",
    "mcp_chronos-graph_*": "allow",
    "external_directory": "ask",
    "doom_loop": "ask",
    "bash": {
      "*": "ask",

      // --- File Read Operations (Safe) ---
      "ls*": "allow",
      "cat*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "grep*": "allow",
      "rg*": "allow",
      "print*": "allow",
      "printf*": "allow",
      "command*": "allow",
      "true*": "allow",
      "exit*": "allow",
      "devcontainer*": "allow",
      "docker*": "allow",

      // --- Development Tools (Safe) ---
      "make*": "allow",
      "uv*": "allow",
      "bun run lint*": "allow",
      "bun run typecheck*": "allow",
      "bun run test*": "allow",
      "eslint*": "allow",
      "npm*": "allow",
      "npx*": "allow",
      "pnpm*": "allow",
      "yarn*": "allow",
      "bun*": "allow",

      // --- Git: Investigation (Safe/Allow) ---
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git blame*": "allow",
      "git ls-files*": "allow",
      "git rev-parse*": "allow",
      "git remote*": "allow",
      "git tag*": "allow",
      "git branch*": "allow",
      "git fetch*": "allow",
      "git merge-base*": "allow",
      "git worktree add*": "allow",
      "gh pr view*": "allow",
      "gh pr list*": "allow",
      "gh pr status*": "allow",
      "gh pr diff*": "allow",
      "gh pr checks*": "allow",
      "gh pr create*": "allow",
      "gh issue list*": "allow",
      "gh issue view*": "allow",
      "gh repo view*": "allow",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "gh auth status*": "allow",

      // --- Git: Modification (Ask/Manual) ---
      "git add": "allow",
      "git commit*": "allow",
      "git checkout*": "allow",
      "git merge": "ask",
      "git rebase": "ask",
      "git pull": "ask",

      // --- Git: Dangerous (Deny) ---
      "git add .": "deny",
      // NOTE: "git add *" を deny にすると個別のファイル追加もできなくなるため ask に設定
      "git add *": "ask",
      "git add -A": "deny",
      "git add --all": "deny",
      "git add -u": "deny",
      "git add :/": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean -fd*": "deny",

      // --- General Write Operations (Ask for safety) ---
      "mkdir": "allow",
      "touch": "allow",
      "cp": "allow",
      "mv": "allow",

      // --- Security Guards (Deny) ---
      "rm -rf *": "deny",
      "npm publish*": "deny",
      "sudo *": "deny",
      "su *": "deny",
      "curl* | sh": "deny",
      "curl *|sh": "deny",
      "curl * | sh": "deny",
      "curl*|sh": "deny",
      "bash _scripts/*": "deny",

      // --- Interpreter Access (Ask) ---
      "python": "ask",
      "node": "ask",
    }
  },

  // --------------------------------------------------------------------------
  // Compaction & Lifecycle
  // --------------------------------------------------------------------------
  "compaction": {
    "auto": true,
    "reserved": 15000,
    "tail_turns": 3,
    "prune": true
  },

  "share": "manual",

  // --------------------------------------------------------------------------
  // LSP - 言語サーバー設定
  // --------------------------------------------------------------------------
  "lsp": {
    "typescript-language-server": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx"
      ],
      "initialization": {
        "preferences": {
          "includeInlayParameterNameHints": "all",
          "includeInlayVariableTypeHints": true,
          "includeInlayFunctionParameterTypeHints": true,
          "disableSuggestions": false
        },
        "diagnostics": {
          "ignoredCodes": [
            6133
          ]
        }
      }
    },
    "bash-language-server": {
      "command": [
        "bash-language-server",
        "start"
      ],
      "extensions": [
        ".sh"
      ]
    },
    "pyright": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py"
      ],
      "initialization": {
        "python": {
          "analysis": {
            "typeCheckingMode": "strict",
            "autoSearchPaths": true,
            "useLibraryCodeForTypes": true
          }
        }
      }
    },
    "markdownlint": {
      "command": [
        "npx",
        "markdownlint-lsp",
        "--stdio"
      ],
      "extensions": [
        ".md"
      ]
    },
    "mypy": {
      "command": [
        "mypy",
        "--ignore-missing-imports",
        "--follow-imports=silent",
        "--strict"
      ],
      "extensions": [
        ".py"
      ]
    },
    "shellcheck": {
      "command": [
        "shellcheck",
        "-f",
        "gcc",
        "--severity=style"
      ],
      "extensions": [
        ".sh"
      ]
    },
    "eslint": {
      "command": [
        "eslint",
        "--format",
        "stylish",
        "--max-warnings",
        "0"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx"
      ]
    }
  },

  "instructions": [
    "global-rules/AGENTS.global.md",
    "agent-skills/superpowers/using-superpowers/SKILL.md"
  ],

  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/coverage/**",
      "**/*.lock",
      "**/.git/**"
    ]
  },

  // --------------------------------------------------------------------------
  // Providers & Models (2026-05 Latest)
  // --------------------------------------------------------------------------
  "enabled_providers": [
    // "google",
    "openai",
    "nvidia",
    "cloudflare-workers-ai",
    "opencode",
    // "cursor",
    "amazon-bedrock",
    "sakura"
  ],
  "provider": {
    // "google": {
    //   "whitelist": [
    //     "gemini-3-flash-preview",
    //     "gemini-3.1-flash-image-preview",
    //     "gemini-3.1-flash-lite",
    //     "gemini-3.1-flash-lite-preview",
    //     "gemini-3.1-pro-preview",
    //     "gemini-3.1-pro-preview-customtools",
    //   ]
    // },
    "openai": {
      "whitelist": [
        "gpt-5.3-codex",
        "gpt-5.3-codex-spark",
        "gpt-5.4",
        "gpt-5.4-mini",
        "gpt-5.5",
      ]
    },
    "nvidia": {
      "whitelist": [
        "minimaxai/minimax-m2.5",
        "minimaxai/minimax-m2.7",
        "z-ai/glm4.7",
       "qwen/qwen3-coder-480b-a35b-instruct",
      ]
    },
    "cloudflare-workers-ai": {
      "whitelist": [
        "@cf/google/gemma-4-26b-a4b-it",
        "@cf/meta/llama-4-scout-17b-16e-instruct",
        // "@cf/moonshotai/kimi-k2.5",
        "@cf/moonshotai/kimi-k2.6",
        "@cf/nvidia/nemotron-3-120b-a12b",
        "@cf/openai/gpt-oss-120b",
        "@cf/openai/gpt-oss-20b",
        "@cf/zai-org/glm-4.7-flash",
      ]
    },
    "opencode": {
      "whitelist": [
        "minimax-m2.5-free",
        "nemotron-3-super-free",
        "deepseek-v4-flash-free",
        "big-pickle",
      ]
    },
    // "cursor":{
    //   "whitelist": [
    //     "claude-haiku-4-5",
    //     "claude-opus-4-7",
    //     "claude-sonnet-4-6",
    //     "composer-2",
    //     "gemini-3-flash",
    //     "gemini-3.1-pro",
    //     "gpt-5.3-codex",
    //     "gpt-5.3-codex-spark",
    //     "gpt-5.4",
    //     "gpt-5.4-mini",
    //     "gpt-5.4-nano",
    //     "gpt-5.5",
    //   ]
    // },
    "amazon-bedrock": {
        "whitelist": [
            // "amazon.nova-2-lite-v1:0",
            // "amazon.nova-lite-v1:0",
            // "amazon.nova-micro-v1:0",
            // "amazon.nova-pro-v1:0",
            // "anthropic.claude-haiku-4-5-20251001-v1:0",
            // "anthropic.claude-opus-4-1-20250805-v1:0",
            // "anthropic.claude-opus-4-5-20251101-v1:0",
            // "anthropic.claude-opus-4-6-v1",
            // "anthropic.claude-opus-4-7",
            // "anthropic.claude-sonnet-4-5-20250929-v1:0",
            // "anthropic.claude-sonnet-4-6",
            // "au.anthropic.claude-haiku-4-5-20251001-v1:0",
            // "au.anthropic.claude-opus-4-6-v1",
            // "au.anthropic.claude-sonnet-4-5-20250929-v1:0",
            // "au.anthropic.claude-sonnet-4-6",
            // "deepseek.r1-v1:0",
            // "deepseek.v3-v1:0",
            // "deepseek.v3.2",
            // "eu.anthropic.claude-haiku-4-5-20251001-v1:0",
            // "eu.anthropic.claude-opus-4-5-20251101-v1:0",
            // "eu.anthropic.claude-opus-4-6-v1",
            // "eu.anthropic.claude-opus-4-7",
            // "eu.anthropic.claude-sonnet-4-5-20250929-v1:0",
            // "eu.anthropic.claude-sonnet-4-6",
            "global.anthropic.claude-haiku-4-5-20251001-v1:0",
            // "global.anthropic.claude-opus-4-5-20251101-v1:0",
            "global.anthropic.claude-opus-4-6-v1",
            "global.anthropic.claude-opus-4-7",
            // "global.anthropic.claude-sonnet-4-5-20250929-v1:0",
            "global.anthropic.claude-sonnet-4-6",
            // "google.gemma-3-12b-it",
            // "google.gemma-3-27b-it",
            // "google.gemma-3-4b-it",
            // "jp.anthropic.claude-opus-4-7",
            // "jp.anthropic.claude-sonnet-4-5-20250929-v1:0",
            // "jp.anthropic.claude-sonnet-4-6",
            // "meta.llama3-1-70b-instruct-v1:0",
            // "meta.llama3-1-8b-instruct-v1:0",
            // "meta.llama3-3-70b-instruct-v1:0",
            // "meta.llama4-maverick-17b-instruct-v1:0",
            // "meta.llama4-scout-17b-instruct-v1:0",
            // "minimax.minimax-m2",
            // "minimax.minimax-m2.1",
            // "minimax.minimax-m2.5",
            // "mistral.devstral-2-123b",
            // "mistral.magistral-small-2509",
            // "mistral.ministral-3-14b-instruct",
            // "mistral.ministral-3-3b-instruct",
            // "mistral.ministral-3-8b-instruct",
            // "mistral.mistral-large-3-675b-instruct",
            // "mistral.pixtral-large-2502-v1:0",
            // "mistral.voxtral-mini-3b-2507",
            // "mistral.voxtral-small-24b-2507",
            // "moonshot.kimi-k2-thinking",
            // "moonshotai.kimi-k2.5",
            // "nvidia.nemotron-nano-12b-v2",
            // "nvidia.nemotron-nano-3-30b",
            // "nvidia.nemotron-nano-9b-v2",
            // "nvidia.nemotron-super-3-120b",
            // "openai.gpt-oss-120b-1:0",
            // "openai.gpt-oss-20b-1:0",
            // "openai.gpt-oss-safeguard-120b",
            // "openai.gpt-oss-safeguard-20b",
            // "qwen.qwen3-235b-a22b-2507-v1:0",
