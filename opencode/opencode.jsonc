// vim: ft=jsonc
// AUTO-GENERATED by _scripts/generate-opencode-jsonc.py
// Source: apm.yml (SSOT) + opencode.jsonc.template
// Regenerate: make sync-opencode
// DO NOT EDIT DIRECTLY.

{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "sisyphus",
  "shell": "bash",
  "snapshot": true,

  // --------------------------------------------------------------------------
  // [Plugin] - エコシステム設定
    // [Plugin]
  // --------------------------------------------------------------------------
  "plugin": [
    "@yohi/justice@2.3.0",
    "@yohi/akane@latest",
    "oh-my-openagent@4.7.5",
    "@yohi/opencode-plugin-chronos-gate@1.4.0"
  ],
  "disabled_providers": [
    "google",
    "cursor"
  ],

  // --------------------------------------------------------------------------
  // Permission - 権限とガードレール
  // --------------------------------------------------------------------------
  "permission": {
    "*": "ask",
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "skill": "allow",
    "lsp": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skillport_*": "allow",
    "mcp_skillport_*": "allow",
    "mcp__skillport__*": "allow",
    "skillport_load_skill": "allow",
    "nexus_*": "allow",
    "mcp_nexus_*": "allow",
    "chronos-graph_*": "allow",
    "mcp_chronos-graph_*": "allow",
    "external_directory": "ask",
    "doom_loop": "ask",
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "cat*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "grep*": "allow",
      "devcontainer*": "allow",
      "docker*": "allow",
      "make*": "allow",
      "uv*": "allow",
      "bun run lint*": "allow",
      "bun run typecheck*": "allow",
      "bun run test*": "allow",
      "eslint*": "allow",
      "npm*": "allow",
      "npx*": "allow",
      "pnpm*": "allow",
      "yarn*": "allow",
      "bun*": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git blame*": "allow",
      "git ls-files*": "allow",
      "git rev-parse*": "allow",
      "git remote*": "allow",
      "git tag*": "allow",
      "git branch*": "allow",
      "git fetch*": "allow",
      "git add": "allow",
      "git commit*": "allow",
      "git checkout": "ask",
      "git checkout *": "ask",
      "git merge": "ask",
      "git rebase": "ask",
      "git pull": "ask",
      "git add .": "deny",
      "git add *": "ask",
      "git add -A": "deny",
      "git add --all": "deny",
      "git add -u": "deny",
      "git add :/": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean -fd*": "deny",
      "mkdir": "allow",
      "touch": "allow",
      "cp": "allow",
      "mv": "allow",
      "rm -rf *": "deny",
      "npm publish*": "deny",
      "sudo *": "deny",
      "su *": "deny",
      "curl* | sh": "deny",
      "curl *|sh": "deny",
      "curl * | sh": "deny",
      "curl*|sh": "deny",
      "bash _scripts/*": "deny",
      "python": "ask",
      "node": "ask"
    }
  },

  // --------------------------------------------------------------------------
  // Compaction & Lifecycle
  // --------------------------------------------------------------------------
  "compaction": {
    "auto": true,
    "reserved": 15000,
    "tail_turns": 3,
    "prune": true
  },
  "share": "manual",

  // --------------------------------------------------------------------------
  // LSP - 言語サーバー設定
  // --------------------------------------------------------------------------
  "lsp": {
    "typescript-language-server": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx"
      ],
      "initialization": {
        "preferences": {
          "includeInlayParameterNameHints": "all",
          "includeInlayVariableTypeHints": true,
          "includeInlayFunctionParameterTypeHints": true,
          "disableSuggestions": false
        },
        "diagnostics": {
          "ignoredCodes": [
            6133
          ]
        }
      }
    },
    "bash-language-server": {
      "command": [
        "bash-language-server",
        "start"
      ],
      "extensions": [
        ".sh"
      ]
    },
    "pyright": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py"
      ],
      "initialization": {
        "python": {
          "analysis": {
            "typeCheckingMode": "strict",
            "autoSearchPaths": true,
            "useLibraryCodeForTypes": true
          }
        }
      }
    },
    "markdownlint": {
      "command": [
        "npx",
        "markdownlint-lsp",
        "--stdio"
      ],
      "extensions": [
        ".md"
      ]
    },
    "mypy": {
      "command": [
        "mypy",
        "--ignore-missing-imports",
        "--follow-imports=silent",
        "--strict"
      ],
      "extensions": [
        ".py"
      ]
    },
    "shellcheck": {
      "command": [
        "shellcheck",
        "-f",
        "gcc",
        "--severity=style"
      ],
      "extensions": [
        ".sh"
      ]
    },
    "eslint": {
      "command": [
        "eslint",
        "--format",
        "stylish",
        "--max-warnings",
        "0"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx"
      ]
    }
  },

  // --------------------------------------------------------------------------
  // Instructions
  // --------------------------------------------------------------------------
  "instructions": [
    "global-rules/AGENTS.global.md",
    ".agents/skills/superpowers/using-superpowers/SKILL.md"
  ],

  // --------------------------------------------------------------------------
  // Watcher
  // --------------------------------------------------------------------------
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/coverage/**",
      "**/*.lock",
      "**/.git/**"
    ]
  },

  // --------------------------------------------------------------------------
  // Providers & Models
  // --------------------------------------------------------------------------
  "enabled_providers": [
    "openai",
    "nvidia",
    "cloudflare-workers-ai",
    "opencode",
    "opencode-go",
    "ollama-cloud",
    "amazon-bedrock",
    "openrouter",
    "sakura"
  ],
  "provider": {
    "openai": {
      "whitelist": [
        "gpt-5.3-codex",
        "gpt-5.3-codex-spark",
        "gpt-5.4",
        "gpt-5.4-mini",
        "gpt-5.5"
      ]
    },
    "nvidia": {
      "whitelist": [
        "minimaxai/minimax-m2.5",
        "minimaxai/minimax-m2.7",
        "z-ai/glm-5.1",
        "qwen/qwen3-coder-480b-a35b-instruct"
      ]
    },
    "cloudflare-workers-ai": {
      "whitelist": [
        "@cf/google/gemma-4-26b-a4b-it",
        "@cf/meta/llama-4-scout-17b-16e-instruct",
        "@cf/moonshotai/kimi-k2.6",
        "@cf/nvidia/nemotron-3-120b-a12b",
        "@cf/openai/gpt-oss-120b",
        "@cf/openai/gpt-oss-20b",
        "@cf/zai-org/glm-4.7-flash"
      ]
    },
    "opencode": {
      "whitelist": [
        "minimax-m2.5-free",
        "nemotron-3-super-free",
        "deepseek-v4-flash-free",
        "big-pickle"
      ]
    },
    "amazon-bedrock": {
      "whitelist": [
        "global.anthropic.claude-haiku-4-5-20251001-v1:0",
        "global.anthropic.claude-opus-4-6-v1",
        "global.anthropic.claude-opus-4-7",
        "global.anthropic.claude-sonnet-4-6",
        "global.anthropic.claude-opus-4-8"
      ]
    },
    "sakura": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "sakura aipf",
      "options": {
        "baseURL": "https://api.ai.sakura.ad.jp/v1"
      },
      "models": {
        "Qwen3-Coder-30B-A3B-Instruct": {
          "name": "Qwen3-Coder-30B-A3B-Instruct"
        },
        "Qwen3-Coder-480B-A35B-Instruct-FP8": {
          "name": "Qwen3-Coder-480B-A35B-Instruct-FP8"
        },
        "gpt-oss-120b": {
          "name": "gpt-oss-120b"
        },
        "preview/Kimi-K2.6": {
          "name": "Kimi-K2.6"
        }
      }
    },
    "opencode-go": {
      "whitelist": [
        "deepseek-v4-flash",
        "deepseek-v4-pro",
        "glm-5",
        "glm-5.1",
        "kimi-k2.5",
        "kimi-k2.6",
        "mimo-v2-omni",
        "mimo-v2-pro",
        "mimo-v2.5",
        "mimo-v2.5-pro",
        "minimax-m2.5",
        "minimax-m2.7",
        "minimax-m3",
        "qwen3.5-plus",
        "qwen3.6-plus",
        "qwen3.7-max"
      ]
    },
    "openrouter": {
      "whitelist": [
        "moonshotai/kimi-k2.6:free"
      ]
    },
    "ollama-cloud": {
      "whitelist": [
        "cogito-2.1:671b",
        "deepseek-v3.1:671b",
        "deepseek-v3.2",
        "deepseek-v4-flash",
        "deepseek-v4-pro",
        "devstral-2:123b",
        "devstral-small-2:24b",
        "gemini-3-flash-preview",
        "gemma3:12b",
        "gemma3:27b",
        "gemma3:4b",
        "gemma4:31b",
        "glm-4.6",
        "glm-4.7",
        "glm-5",
        "glm-5.1",
        "gpt-oss:120b",
        "gpt-oss:20b",
        "kimi-k2-thinking",
        "kimi-k2.5",
        "kimi-k2.6",
        "kimi-k2:1t",
        "minimax-m2",
        "minimax-m2.1",
        "minimax-m2.5",
        "minimax-m2.7",
        "minimax-m3",
        "ministral-3:14b",
        "ministral-3:3b",
        "ministral-3:8b",
        "mistral-large-3:675b",
        "nemotron-3-nano:30b",
        "nemotron-3-super",
        "qwen3-coder-next",
        "qwen3-coder:480b",
        "qwen3-next:80b",
        "qwen3-vl:235b",
        "qwen3-vl:235b-instruct",
        "qwen3.5:397b",
        "rnj-1:8b"
      ]
    }
  },

  // --------------------------------------------------------------------------
  // Experimental
  // --------------------------------------------------------------------------
  "experimental": {
    "batch_tool": true,
    "openTelemetry": true,
    "continue_loop_on_deny": false,
    "mcp_timeout": 120000,
    "watchdog": {
      "enabled": true,
      "stage1Ms": 180000,
      "stage2Ms": 180000,
      "maxPings": 1,
      "tmux": {
        "highlightWindow": true
      }
    }
  },

  // --------------------------------------------------------------------------
  // [MCP] - サーバー設定
    // [MCP]
  // --------------------------------------------------------------------------
  "mcp": {
    "docker-mcp": {
      "type": "remote",
      "url": "http://127.0.0.1:10888/sse",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:MCP_GATEWAY_TOKEN}"
      }
    },
    "skillport": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "skillport-mcp"
      ],
      "environment": {
        "SKILLPORT_SKILLS_DIR": "{env:PWD}/.agents/skills"
      }
    },
    "nexus": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@yohi/nexus@1.9.1"
      ],
      "environment": {
        "NEXUS_STORAGE_ROOT_DIR": "{env:HOME}/.nexus",
        "LOG_LEVEL": "ERROR",
        "NEXUS_WATCHER_IGNORE_PATHS": "node_modules,opencode/node_modules,.opencode/node_modules,oss/apm/node_modules,oss/apm/docs/node_modules,.git,.nexus,dist,gemini,agent-skills,apm_modules,.agents,.opencode,.gemini,.claude,.codex,.vscode,.devcontainer,oss,codex/.tmp,.worktrees,.venv,target,.mypy_cache,.ruff_cache,build,.serena,.cache,__pycache__,*.db,*.sqlite,*.log",
        "CHOKIDAR_USEPOLLING": "false",
        "CHOKIDAR_INTERVAL": "2000",
        "NO_PROXY": "127.0.0.1,localhost"
      }
    },
    "chronos-graph": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/yohi/chronos-graph.git[all]",
        "context-store"
      ],
      "environment": {
        "STORAGE_BACKEND": "{env:STORAGE_BACKEND}",
        "GRAPH_ENABLED": "{env:GRAPH_ENABLED}",
        "POSTGRES_HOST": "{env:POSTGRES_HOST}",
        "POSTGRES_PORT": "{env:POSTGRES_PORT}",
        "POSTGRES_DB": "{env:POSTGRES_DB}",
        "POSTGRES_USER": "{env:POSTGRES_USER}",
        "POSTGRES_PASSWORD": "{env:POSTGRES_PASSWORD}",
        "POSTGRES_SSL": "{env:POSTGRES_SSL}",
        "NEO4J_URI": "{env:NEO4J_URI}",
        "NEO4J_USER": "{env:NEO4J_USER}",
        "NEO4J_PASSWORD": "{env:NEO4J_PASSWORD}",
        "CACHE_BACKEND": "{env:CACHE_BACKEND}",
        "REDIS_URL": "{env:REDIS_URL}",
        "REDIS_SSL": "{env:REDIS_SSL}",
        "EMBEDDING_PROVIDER": "{env:EMBEDDING_PROVIDER}",
        "LOCAL_MODEL_NAME": "{env:LOCAL_MODEL_NAME}",
        "EMBEDDING_DIMENSION": "{env:EMBEDDING_DIMENSION}",
        "SIMILARITY_THRESHOLD": "{env:SIMILARITY_THRESHOLD}",
        "DEDUP_THRESHOLD": "{env:DEDUP_THRESHOLD}",
        "DEFAULT_TOP_K": "{env:DEFAULT_TOP_K}",
        "DECAY_HALF_LIFE_DAYS": "{env:DECAY_HALF_LIFE_DAYS}",
        "ARCHIVE_THRESHOLD": "{env:ARCHIVE_THRESHOLD}",
        "PURGE_RETENTION_DAYS": "{env:PURGE_RETENTION_DAYS}",
        "DASHBOARD_HOST": "{env:DASHBOARD_HOST}",
        "DASHBOARD_PORT": "{env:DASHBOARD_PORT}"
      }
    }
  }
}
