{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "sisyphus",
  "plugin": [
    "yohi@justice@latest",
    "oh-my-openagent@dev"
  ],
  "agent": {
    "build": {
      "model": "opencode/minimax-m2.5-free"
    }
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "lsp": "allow",
    "skill": "allow",
    "websearch": "allow",
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "cat": "allow",
      "cat *": "allow",
      "head": "allow",
      "head *": "allow",
      "tail": "allow",
      "tail *": "allow",
      "mkdir": "allow",
      "mkdir *": "allow",
      "touch": "allow",
      "touch *": "allow",
      "cp": "allow",
      "cp *": "allow",
      "mv": "allow",
      "mv *": "allow",
      "make": "allow",
      "make *": "allow",
      "uv": "allow",
      "uv *": "allow",
      "uvx": "ask",
      "uvx *": "ask",
      "python": "ask",
      "python *": "ask",
      "node": "ask",
      "node *": "ask",
      "bun": "ask",
      "bun *": "ask",
      "git status": "allow",
      "git status *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git checkout": "allow",
      "git checkout *": "allow",
      "git add": "allow",
      "git add *": "allow",
      "git commit": "allow",
      "git commit *": "allow",
      "git add .": "deny",
      "rm -rf *": "deny",
      "npm publish*": "deny",
      "sudo *": "deny",
      "su *": "deny",
      "curl*|sh": "deny",
      "curl* | sh": "deny",
      "curl *|sh": "deny",
      "curl * | sh": "deny",
      "bash _scripts/*": "ask",
      "bun run lint*": "allow",
      "bun run typecheck*": "allow",
      "bun run test*": "allow",
      "bun run build*": "allow",
      "dmypy*": "allow",
      "shellcheck*": "allow",
      "eslint*": "allow",
      "git push*": "ask",
      "git reset*": "ask",
      "git clean*": "ask",
      "git pull*": "ask",
      "gh pr create*": "ask"
    }
  },
  "compaction": {
    "auto": true,
    "reserved": 12000,
    "tail_turns": 3,
    "prune": true
  },
  "lsp": {
    "typescript-language-server": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx"
      ],
      "initialization": {
        "preferences": {
          "includeInlayParameterNameHints": "all",
          "includeInlayVariableTypeHints": true,
          "includeInlayFunctionParameterTypeHints": true,
          "disableSuggestions": false
        },
        "diagnostics": {
          "ignoredCodes": [
            6133
          ]
        }
      }
    },
    "bash-language-server": {
      "command": [
        "bash-language-server",
        "start"
      ],
      "extensions": [
        ".sh"
      ]
    },
    "pyright": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py"
      ],
      "initialization": {
        "python": {
          "analysis": {
            "typeCheckingMode": "strict",
            "autoSearchPaths": true,
            "useLibraryCodeForTypes": true
          }
        }
      }
    },
    "markdownlint": {
      "command": [
        "npx",
        "markdownlint-lsp",
        "--stdio"
      ],
      "extensions": [
        ".md"
      ]
    },
    "mypy": {
      "command": [
        "mypy",
        "--ignore-missing-imports",
        "--follow-imports=silent",
        "--strict"
      ],
      "extensions": [
        ".py"
      ]
    },
    "shellcheck": {
      "command": [
        "shellcheck",
        "-f",
        "gcc",
        "--severity=style"
      ],
      "extensions": [
        ".sh"
      ]
    },
    "eslint": {
      "command": [
        "eslint",
        "--format",
        "compact",
        "--max-warnings",
        "0"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx"
      ]
    }
  },
  "experimental": {
    "batch_tool": true,
    "continue_loop_on_deny": false,
    "mcp_timeout": 10000
  },
  "instructions": [
    "global-rules/AGENTS.global.md",
    "agent-skills/superpowers/using-superpowers/SKILL.md"
  ],
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/coverage/**",
      "**/*.lock",
      "**/.git/**"
    ]
  },
  "provider": {
    "opencode": {
      "whitelist": [
        "big-pickle",
        "minimax-m2.5-free",
        "ling-2.6-flash-free",
        "hy3-preview-free",
        "nemotron-3-super-free",
        "gpt-5-nano"
      ]
    },
    "openai": {
      "whitelist": [
        "gpt-5.5",
        "gpt-5.4",
        "gpt-5.4-mini",
        "gpt-5.3-codex"
      ]
    },
    "google": {
      "whitelist": [
        "gemini-3-flash-preview",
        "gemini-3.1-flash-image-preview",
        "gemini-3.1-flash-lite-preview",
        "gemini-3.1-pro-preview",
        "gemini-3.1-pro-preview-customtools"
      ]
    },
    "nvidia": {
      "whitelist": [
        "z-ai/glm-5.1",
        "z-ai/glm5",
        "moonshotai/kimi-k2.6",
        "minimaxai/minimax-m2.5",
        "minimaxai/minimax-m2.7",
        "nvidia/nemotron-3-nano-30b-a3b",
        "nvidia/nvidia-nemotron-nano-9b-v2",
        "nvidia/nemotron-4-340b-instruct",
        "qwen/qwen3.5-397b-a17b"
      ]
    },
    "cloudflare-workers-ai": {
      "whitelist": [
        "@cf/google/gemma-4-26b-a4b-it",
        "@cf/meta/llama-4-scout-17b-16e-instruct",
        "@cf/moonshotai/kimi-k2.5",
        "@cf/moonshotai/kimi-k2.6",
        "@cf/nvidia/nemotron-3-120b-a12b",
        "@cf/openai/gpt-oss-120b",
        "@cf/openai/gpt-oss-20b",
        "@cf/zai-org/glm-4.7-flash"
      ]
    }
  },
  "mcp": {
    "docker-mcp": {
      "url": "http://127.0.0.1:10888/sse",
      "headers": {
        "Authorization": "Bearer ${OPCODE_GATEWAY_TOKEN}"
      },
      "type": "remote",
      "enabled": true
    }
  }
}