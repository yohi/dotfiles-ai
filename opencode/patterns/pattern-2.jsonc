{
  // 【パターン2】Economy (コスパ・節約構成)
  //  SisyphusをGemini 3 Proに任せてコストを抑制しつつ、要所(実装・相談)で高性能モデルを使う。
  "description": "節約構成 (Gemini Pro + GPT-4o + Flash)",
  "agents": {
    "sisyphus": {
      "model": "zerogravity/gemini-3-pro", // 指揮はGemini Pro
      "variant": "high",
      "temperature": 0.2
    },
    "prometheus": {
      "model": "zerogravity/gemini-3-pro", // 計画立案もGemini Proで節約
      "variant": "high"
    },
    "atlas": {
      "model": "zerogravity/gemini-3-pro", // ContextもGemini Pro
      "variant": "high"
    },
    "metis": {
      "model": "openai/gpt-5.2", // 参謀：バランス型のGPT-5.2
      "temperature": 0.5
    },
    "hephaestus": {
      "model": "openai/gpt-5.2", // 実装だけは妥協せずGPT-5.2
      "variant": "medium"
    },
    "oracle": {
      "model": "google-vertex-anthropic/claude-opus-4.6", // 相談役だけはOpus（ここぞという時用）
      "variant": "max"
    },
    "momus": {
      "model": "zerogravity/gemini-3-pro"
    },
    "librarian": {
      "model": "zerogravity/gemini-3-flash"
    },
    "explore": {
      "model": "zerogravity/gemini-3-flash"
    },
    "multimodal-looker": {
      "model": "zerogravity/gemini-3-flash"
    },
    "git-specialist": {
      "description": "Git operations specialist",
      "model": "zerogravity/gemini-3-pro",
      "permission": {
        "bash": {
          "git push --force": "deny",
          "git push -f": "deny",
          "git clean *": "ask",
          "git add .": "ask",
          "git *": "allow",
          "*": "deny"
        },
        "edit": "deny",
        "webfetch": "deny"
      }
    }
  },
  "categories": {
    "quick": {
      "model": "zerogravity/gemini-3-flash"
    },
    "writing": {
      "model": "zerogravity/gemini-3-flash"
    },
    "visual-engineering": {
      "model": "zerogravity/gemini-3-pro"
    },
    "artistry": {
      "model": "zerogravity/gemini-3-pro",
      "variant": "high"
    },
    "ultrabrain": {
      "model": "zerogravity/gemini-3-pro",
      "variant": "high"
    },
    "deep": {
      "model": "openai/gpt-4o",
      "variant": "medium"
    }, // deepだけはGPT
    "unspecified-low": {
      "model": "zerogravity/gemini-3-flash"
    },
    "unspecified-high": {
      "model": "zerogravity/gemini-3-pro"
    }
  }
}
