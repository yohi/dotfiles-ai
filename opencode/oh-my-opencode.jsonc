{
  // Config Modernized: 2026-03-12
  // Target OpenCode Version: v1.2.24
  // Based on oh-my-opencode v3.11.2
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "sisyphus_agent": {
    "disabled": false,
    "planner_enabled": true,
    "replace_plan": true,
    "default_builder_enabled": false
  },
  "experimental": {
    "task_system": false,
    "aggressive_truncation": true,
    "auto_resume": true,
    "preemptive_compaction_threshold": 0.85
  },
  "google_auth": false,
  "share": "disabled",
  "disabled_hooks": [
    // "auto-update-checker",
    "comment-checker"
  ],
  "disabled_mcps": [],
  "disabled_agents": [],
  "disabled_skills": [],
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60
  },
  "browser_automation_engine": {
    "provider": "playwright-cli"
  },
  "background_task": {
    "defaultConcurrency": 5,
    "staleTimeoutMs": 180000,
    "providerConcurrency": {
      "google": 20,
      "openai": 10,
      "anthropic": 5
    },
    "modelConcurrency": {
      "zerogravity/opus-4.6": 1,
      "openai/gpt-5.3-codex": 1
    }
  },
  "git_master": {
    "commit_footer": false,
    "include_co_authored_by": false
  },
  "ralph_loop": {
    "enabled": true,
    "default_max_iterations": 20
  },
  "boulder_state": {
    "enabled": true,
    "storage_path": ".sisyphus/boulder_state.json"
  },
  "session_recovery": {
    "enabled": true,
    "storage_path": ".sisyphus/session_recovery.json"
  },
  "interactive_bash": {
    "enabled": true,
    "timeout_ms": 300000
  },
  "auto_slash_command": {
    "enabled": true
  },
  "commands": {
    "git-pr-flow": {
      "description": "Git PR Flow",
      "prompt": "./commands/git-pr-flow.md",
      "skills": {
        "git-master": {
          "enabled": true,
          "allow": [
            "git_add",
            "git_commit",
            "git_push",
            "git_status",
            "git_diff",
            "git_log",
            "git_checkout",
            "git_branch"
          ]
        }
      }
    },
    "build-skill": {
      "description": "Agent Skill Builder",
      "prompt": "./commands/build-skill.md",
      "skills": {
        "agent-skill-architect": {
          "enabled": true
        }
      }
    }
  },
  "rules_injector": {
    "enabled": true
  },
  "hooks": {
    "PermissionRequest": [
      "scripts/auto-approve-git.sh"
    ]
  },
  "categories": {
    // 複雑な推論（Thinking）を伴う、設計・監査の最高峰モデル
    "thinking-pro": {
      "model": "opencode-geminicli-a2a/gemini-3.1-pro-preview",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 32768
      }
    },
    // 安定したコンテキスト把握能力を持つ標準モデル
    "standard-pro": {
      "model": "opencode-geminicli-a2a/gemini-3.1-pro-preview",
      "temperature": 0.1
    },
    // 高速レスポンスと低コストを両立した調査・レビュー用モデル
    "flash-speed": {
      "model": "opencode-geminicli-a2a/gemini-3.1-flash-preview",
      "temperature": 0.1
    }
  },
  "agents": {
    // ---------------------------------------------------------
    // コア・オーケストレーション & 計画
    // ---------------------------------------------------------

    // メインプランナー: 目標達成のための詳細なステップを構築
    "sisyphus": {
      "category": "thinking-pro",
    },

    // 長期計画・インタビュー: 要件定義とマイルストーン策定を担当
    "prometheus": {
      "category": "standard-pro",
      "temperature": 0.2,
    },

    // 戦略分析: プロジェクト開始前の技術スタック検討とスコープ分析
    "metis": {
      "category": "thinking-pro",
    },

    // ---------------------------------------------------------
    // スペシャリスト
    // ---------------------------------------------------------

    // アーキテクト: 高度な設計判断、デバッグ、論理的整合性の検証
    "oracle": {
      "category": "thinking-pro",
      "temperature": 0,
    },

    // 司書: 公式ドキュメントの検索や外部ライブラリの調査
    "librarian": {
      "category": "flash-speed",
    },

    // 探索者: ローカルコードベースのスキャンと既存パターンの特定
    "explore": {
      "category": "standard-pro",
    },

    // 視覚解析: スクリーンショットやUI/UXデザインの解析を担当
    "multimodal-looker": {
      "model": "opencode-geminicli-a2a/gemini-3-pro-preview",
      "temperature": 0.1,
    },

    // ---------------------------------------------------------
    // 検証・レビュー
    // ---------------------------------------------------------

    // 批評家: 提示された計画の欠陥やエッジケースを指摘し改善を促す
    "momus": {
      "category": "standard-pro",
      "temperature": 0.7,
    },

    // 監査役: 実装されたコードの品質レビューと整合性チェック
    "atlas": {
      "category": "thinking-pro",
      "temperature": 0,
    },

    // ---------------------------------------------------------
    // 実装
    // ---------------------------------------------------------

    // 実行役: 実際のコード書き出しとターミナル操作に特化
    "hephaestus": {
      "model": "openai/gpt-5.2-codex",
      "temperature": 0.1,
      "variant": "xhigh"
    },

    // "git-specialist": {
    //   "description": "Git operations specialist with elevated permissions",
    //   "model": "openai/gpt-5.3-codex",
    //   "permission": {
    //     "bash": {
    //       "git push --force": "deny",
    //       "git push -f": "deny",
    //       "git clean *": "ask",
    //       "git add .": "ask",
    //       "git *": "allow",
    //       "*": "deny"
    //     },
    //     "edit": "deny",
    //     "webfetch": "deny"
    //   }
    // }
  },
  "hashline_edit": true
}
