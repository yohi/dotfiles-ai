{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/refs/heads/dev/dist/oh-my-opencode.schema.json",

  /**
   * [1] 知能カテゴリー (Categories)
   * 構成戦略: GPT を強力なバックアップ（ベース）として保持しつつ、
   * 中華製無料枠モデルをフロント（第1優先）に立てることで GPT の消費比率を低減。
   */
  "categories": {
    // 【最上位知能】品質担保のため GPT-5.4 をフロントに維持
    "ultrabrain": {
      "model": "openai/gpt-5.4",
      "fallback_models": [
        "opencode/kimi-k2.5-free",
        "opencode/big-pickle",
        "github-models/openai/gpt-5.4",
        "openrouter/anthropic/claude-opus-4-6"
      ],
      "temperature": 0.2
    },
    // 【戦略・論理】Kimi をフロントに立て、GPT の比率を低減
    "deep": {
      "model": "opencode/kimi-k2.5-free",
      "fallback_models": [
        "openai/gpt-5.4",
        "opencode/big-pickle",
        "github-models/openai/gpt-5.4",
        "google/gemini-3.1-pro-preview"
      ],
      "temperature": 0.1
    },
    // 【視覚・UI】GPT のビジョン機能を維持しつつ、GLM (Big Pickle) を上位へ
    "visual": {
      "model": "openai/gpt-5.4",
      "fallback_models": [
        "opencode/big-pickle",
        "google/gemini-3.1-pro-preview"
      ],
      "parallel": 3
    },
    // 【実装職人】Codex の前に Kimi を配置し、GPT 比率を抑制
    "craftsman": {
      "model": "opencode/kimi-k2.5-free",
      "fallback_models": [
        "openai/gpt-5.3-codex",
        "github-copilot/gpt-5.3-codex",
        "openrouter/anthropic/claude-opus-4-6"
      ],
      "temperature": 0.1
    },
    // 【高速定型】MiniMax をフロントに。GPT Mini はフォールバックへ
    "quick": {
      "model": "opencode/minimax-m2.5-free",
      "fallback_models": [
        "openai/gpt-5.4-mini",
        "opencode/kimi-k2.5-free",
        "opencode/gpt-5-nano"
      ],
      "temperature": 0.5
    },
    // 【高速探索】MiniMax 主軸（GPT比率 0%）
    "fast": {
      "model": "opencode/minimax-m2.5-free",
      "fallback_models": [
        "opencode/kimi-k2.5-free",
        "opencode/gpt-5-nano"
      ]
    }
  },

  /**
   * [2] 規律あるエージェント (Agents)
   */
  "agents": {
    "sisyphus": { "category": "ultrabrain" },
    "prometheus": { "category": "deep" },
    "metis": { "category": "deep" },
    "hephaestus": { "category": "craftsman" },
    "atlas": { "category": "quick" },
    "oracle": { "category": "deep" },
    "momus": { "category": "deep" },
    "explore": { "category": "fast" },
    "librarian": { "category": "fast" },
    "multimodal-looker": { "category": "visual" }
  },

  /**
   * [3] 高度な機能設定 (Features)
   */
  "features": {
    "hashline_edit": { "enabled": true, "strict_verification": true },
    "intent_gate": {
      "enabled": true,
      "verbose": true,
      "routing_map": {
        "research": "fast",
        "implementation": "craftsman",
        "ui_design": "visual",
        "fix": "quick",
        "architecture": "deep"
      }
    },
    "background_agent": { "enabled": true, "max_parallel": 5, "auto_start": true },
    "tmux": { "enabled": true, "layout": "main-vertical" }
  },

  "claude_code": { "use_standard_tools": true, "theme": "dark" }
}
