// vim: ft=jsonc
/**
 * OpenCode TUI Configuration - v1.14.41 Optimized
 * 
 * このファイルは TUI（ターミナル・ユーザー・インターフェース）の
 * 外観、操作感、およびユーザー体験に関する設定を定義します。
 * v1.14.41 より、エンジンの動作設定 (opencode.jsonc) から完全に分離されました。
 */
{
  "$schema": "https://opencode.ai/tui.json",

  // --------------------------------------------------------------------------
  // 1. 外観 (Aesthetics)
  // --------------------------------------------------------------------------
  
  // カラーテーマ。組み込みテーマのほか、plugins 経由のカスタムテーマも利用可能。
  "theme": "tokyonight",

  // Diff（差分）の表示スタイル。
  // "auto": 画面幅に応じて最適な形式を選択。
  // "unified": 従来の diff 形式。
  // "side-by-side": 左右に並べて表示（横幅が広い場合に推奨）。
  "diff_style": "auto",

  // マウス操作
  "mouse": true,

  // --------------------------------------------------------------------------
  // 2. インタラクション (Interaction)
  // --------------------------------------------------------------------------

  // スクロール感のチューニング。
  "scroll_speed": 3,
  "scroll_acceleration": {
    "enabled": true,
    "factor": 1.5 // 連続スクロール時に速度を 1.5 倍まで加速。
  },

  // --------------------------------------------------------------------------
  // 3. 外部連携 (Integrations)
  // --------------------------------------------------------------------------

  "editor": {
    // 外部エディタ（Vim/VSCode等）での編集を優先するかどうか。
    "use_external": true
  },

  // --------------------------------------------------------------------------
  // 4. キーバインド (Keyboard Shortcuts)
  // --------------------------------------------------------------------------
  "keybinds": {
    // パネル・表示トグル関連キーバインドの有効化設定例
    // （各キーバインドにキーアサインを設定するか、ブール値対応項目を true に指定）
  },

  // --------------------------------------------------------------------------
  // 5. プラグイン (Plugins)
  // --------------------------------------------------------------------------
  "plugin": [
    "oh-my-openagent/tui",
    "@yohi/akane@1.6.2"
  ]
}

