// vim: ft=jsonc
{
  // Config Modernized: 2026-02-20
  // Target OpenCode Version: v1.3.x
  // Based on oh-my-opencode v3.7.4
  "$schema": "https://opencode.ai/config.json",

  // --------------------------------------------------------------------------
  // 1. コアモデル設定: 最新のフラグシップモデルを配置
  //    タスクの難易度に応じて適切なモデルを使い分けるための基本設定です。
  // --------------------------------------------------------------------------
  // "model": "openai/gpt-5.4-pro", // メインの思考エンジン。複雑なロジック構築や全体設計を担当。
  // "small_model": "google/gemini-3-flash-preview", // 高速な要約、型チェックの修正提案、単純な置換タスク用。
  "default_agent": "sisyphus", // OMO (Oh-My-OpenCode) オーケストレーションの司令塔となるエージェント。

  // [Plugin]
  "plugin": [
    "oh-my-opencode@dev",
    // "opencode-geminicli-a2a-provider",
  ],

  "agent": {
    "build": {
      "model": "opencode/minimax-m2.5-free"
    }
  },

  // --------------------------------------------------------------------------
  // 2. 権限とセキュリティ: 「自律」と「安全」の黄金律
  //    エージェントがスムーズに作業できる「自律性」と、破壊的操作を防ぐ「安全性」のバランスを定義します。
  // --------------------------------------------------------------------------
  "permission": {
    "*": "ask", // 明示的に許可されていない操作は、安全のため常に人間に確認する
    "read": "allow", // ファイルの読み取りは自由（解析に必須）
    "list": "allow", // ディレクトリ一覧の取得（構造理解に必須）
    "glob": "allow", // パターンマッチによるファイル探索
    "grep": "allow", // コード内キーワード検索
    "edit": "allow", // ファイル編集（エージェントの主目的）
    "lsp": "allow", // 言語サーバーによるコード診断情報の取得
    "skill": "allow", // 登録されたスキルの実行
    "websearch": "allow", // 最新情報の収集（ブラウザ検索）
    "bash": {
      "*": "ask", // 任意のコマンド実行は原則として確認が必要

      // --- 禁止設定 (Deny): 最優先で評価されるガードレール ---
      "git add .": "deny", // 意図しない全ファイル追加を防止。個別にファイル指定（git add file）を推奨。
      "rm -rf *": "deny", // 破壊的な削除は絶対に許可しない
      "npm publish*": "deny", // 公開操作は必ず人間が行う
      "sudo *": "deny", // 特権操作はエージェントには許可しない
      "su *": "deny", // ユーザー切り替え禁止
      "curl*|sh": "deny", // 外部スクリプトの直接実行は高リスク

      // --- 許可設定 (Allow): エージェントが自律的に繰り返す「試行錯誤」を加速 ---
      "git status*": "allow", // リポジトリの状態確認
      "git log*": "allow", // コミット履歴の確認
      "tail*": "allow", // ログファイルの末尾確認
      "bun run lint*": "allow", // 静的解析による品質確認
      "bun run typecheck*": "allow", // 型チェックによる検証
      "bun run test*": "allow", // テスト実行による動作検証
      "bun run build*": "allow", // ビルド確認（構文エラーの最終確認）
      "dmypy*": "allow", // mypyデーモンによる高速な型チェック
      "shellcheck*": "allow", // シェルスクリプトの文法確認
      "eslint*": "allow", // JS/TSのスタイル・バグ確認
      "git add*": "allow", // 指定されたファイルのステージング
      "git commit*": "allow", // ローカルでの作業保存（メッセージ生成込み）

      // --- 確認設定 (Ask): 外部影響やコンテキストの大きな変化を伴う操作 ---
      "git push*": "ask", // リモートへの反映は最終的な人間の承認が必要
      "git reset*": "ask", // 作業内容の巻き戻しは意図を確認する
      "git clean*": "ask", // 未追跡ファイルの削除
      "git checkout*": "ask", // ブランチ切り替え（エージェントのコンテキストが変わるため）
      "git pull*": "ask", // コンフリクトのリスクがあるため確認
      "gh pr create*": "ask" // プルリクエスト作成は外部向けの意思表示
    }
  },

  // --------------------------------------------------------------------------
  // 3. コンテキスト・ライフサイクル管理
  //    エージェントの「記憶」の質と量を最適化し、長時間の対話でも精度を維持します。
  // --------------------------------------------------------------------------
  "compaction": {
    "auto": true, // 会話が長くなった際に自動で重要事項を要約する
    "reserved": 12000, // 要約バッファを広めに確保（複雑なタスクでもコンテキスト落ちしにくくする）
    "tail_turns": 3, // 直近の数ターンは原文をそのまま保持し、現在の文脈を正確に把握させる
    "prune": true // 不要なツールの実行結果などを積極的に削除してトークンを節約する
  },

  // --------------------------------------------------------------------------
  // 4. 言語サーバー (LSP) / 静的解析ツール: コード理解の精度向上
  //    AIがコードを書くだけでなく、その正しさをリアルタイムに自己診断するための設定です。
  // --------------------------------------------------------------------------
  "lsp": {
    "typescript-language-server": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx"
      ]
    },
    "bash-language-server": {
      "command": [
        "bash-language-server",
        "start"
      ],
      "extensions": [
        ".sh"
      ]
    },
    "pyright": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py"
      ]
    },
    "markdownlint": {
      "command": [
        "markdownlint-cli2"
      ],
      "extensions": [
        ".md"
      ]
    },
    "mypy": {
      // dmypy (daemon mypy) を使用することで、大規模プロジェクトでも高速に型診断を行い、
      // AIがエラーを即座に修正できるようにします。
      "command": [
        "dmypy",
        "run",
        "--",
        "--ignore-missing-imports",
        "--follow-imports=silent",
        "."
      ],
      "extensions": [
        ".py"
      ]
    },
    "shellcheck": {
      "command": [
        "shellcheck",
        "-f",
        "gcc" // OpenCodeがエラー箇所を正確に把握しやすいgcc形式を指定
      ],
      "extensions": [
        ".sh"
      ]
    },
    "eslint": {
      "command": [
        "eslint",
        "--format",
        "compact" // 出力を簡潔にし、コンテキストの圧迫を防ぎつつ正確な情報を伝達
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx"
      ]
    }
  },

  // --------------------------------------------------------------------------
  // 5. 実験的・最新機能の有効化
  //    OpenCodeのポテンシャルを最大限に引き出すための最適化設定です。
  // --------------------------------------------------------------------------
  "experimental": {
    "batch_tool": true, // 複数ツール実行をバッチ化して通信回数を減らし、高速化する
    "continue_loop_on_deny": false, // コマンド実行が拒否された場合は思考を停止させ、安全を確保する
    "mcp_timeout": 10000 // MCP (Model Context Protocol) リクエストのタイムアウトを延長
  },

  // --------------------------------------------------------------------------
  // 6. 外部リソース・ルール
  //    エージェントが準拠すべきコーディング標準や共通ルールを定義します。
  // --------------------------------------------------------------------------
  "instructions": [
    "docs/global-rules/AGENTS.global.md", // 全プロジェクト共通の行動指針
    "agent-skills/superpowers/using-superpowers/SKILL.md" // Superpowersワークフローの導入
  ],
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/coverage/**",
      "**/*.lock",
      "**/.git/**"
    ]
  },

