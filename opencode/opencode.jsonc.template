// vim: ft=jsonc
{
  // Config Modernized: 2026-02-20
  // Target OpenCode Version: v1.3.x
  // Based on oh-my-opencode v3.7.4
  "$schema": "https://opencode.ai/config.json",

  // [Plugin]
  "plugin": [
    // "oh-my-opencode@3.10.0",
    // "opencode-openai-codex-auth@^1.0.0",
    // // "opencode-antigravity-auth@beta",
    // // "@yohi/opencode-antigravity-quota@^1.0.0",
    // "@yohi/opencode-codex-quota@^1.0.0",
    // // "@yohi/omo-sdd-hybrid",
    // "opencode-geminicli-a2a-provider",
  ],

  // [Instruction]
  "instructions": [],

  // [Watcher]
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/.next/**",
      "**/coverage/**",
      "**/*.lock",
      "**/.cursorrules",
    ],
  },

  // [Compaction]
  "compaction": {
    "auto": true,
    "reserved": 10000,
    "prune": true,
  },

  // [Permission]
  "permission": {
    "*": "ask",
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "codesearch": "allow",
    "todoread": "allow",
    "edit": "allow",
    "todowrite": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "external_directory": "ask",
    "lsp": "allow", // [New] v1.3 LSP permission
    "skill": "allow", // [New] v1.3 Skill permission
    "task": "allow", // [New] v1.3 Task permission
    "bash": {
      "*": "ask", // 自律性と安全性のバランス: allow -> ask (デフォルト確認)

      // --- 安全弁 (ask) ---
      "git push*": "ask",
      "git reset*": "ask",

      // --- 禁止 (deny) ---
      "npm publish*": "deny", // 誤公開防止: deny を維持
      "curl*|sh": "deny",
      "curl*|bash": "deny",
      "git clean -fd*": "deny",
      "git add .": "deny", // 一括追加は禁止を維持
      "rm *": "deny",
      "rm -rf *": "deny",
      "ssh *": "deny",
      "sudo *": "deny",
      "su *": "deny",
    },
  },

  // [Experimental]
  "experimental": {
    "batch_tool": true, // [New] Enable batching for faster execution
    "continue_loop_on_deny": false, // [New] Stop thinking on permission denial / do not continue
  },

  // [MCP]
  "mcp": {
    "docker-mcp-gateway": {
      "type": "remote",
      "url": "http://127.0.0.1:10888/sse",
      "enabled": true,
    },
    "chronos-graph": {
      "type": "local",
      "command": [
        "uv",
        "--quiet",
        "run",
        "context-store",
      ],
      "environment": {
        "STORAGE_BACKEND": "sqlite",
        "SQLITE_DB_PATH": "/home/y_ohi/.context-store/memories.db",
        "GRAPH_ENABLED": "true",
      },
    },
  },

  // [LSP]
  "lsp": {
    "bash-language-server": {
      "command": [
        "bash-language-server",
        "start",
      ],
      "extensions": [
        ".sh",
      ],
      "disabled": false,
    },
    "typescript-language-server": {
      "command": [
        "typescript-language-server",
        "--stdio",
      ],
      "extensions": [
        ".ts",
        ".tsx",

        ".js",
        ".jsx",
        ".mts",
        ".cts",
      ],
      "disabled": false,
    },
    "pyright": {
      "command": [
        "pyright-langserver",
        "--stdio",
      ],
      "extensions": [
        ".py",
      ],
      "disabled": false,
    },
  },

