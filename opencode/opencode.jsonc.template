// vim: ft=jsonc
{
  // Config Modernized: 2026-02-20
  // Target OpenCode Version: v1.3.x
  // Based on oh-my-opencode v3.7.4
  "$schema": "https://opencode.ai/config.json",

  // --------------------------------------------------------------------------
  // 1. コアモデル設定: 最新のフラグシップモデルを配置
  // --------------------------------------------------------------------------
  "model": "openai/gpt-5.4", // メイン頭脳
  "small_model": "google/gemini-3-flash", // 高速な要約・補助タスク用
  "default_agent": "sisyphus", // OMOオーケストレーションの司令塔


  // --------------------------------------------------------------------------
  // 2. 権限とセキュリティ: 「自律」と「安全」の黄金律
  // --------------------------------------------------------------------------
  "permission": {
    "*": "ask",
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "lsp": "allow",
    "skill": "allow",
    "websearch": "allow",
    "bash": {
      "*": "ask",
      // --- 禁止設定 (Deny) ---
      "rm -rf *": "deny",
      "npm publish*": "deny",
      "sudo *": "deny",
      "su *": "deny",
      "curl*|sh": "deny",
      // --- 確認設定 (Ask) ---
      "git push*": "ask",
      "git reset*": "ask",
      "git clean*": "ask"
    }
  },

  // --------------------------------------------------------------------------
  // 3. コンテキスト・ライフサイクル管理
  // --------------------------------------------------------------------------
  "compaction": {
    "auto": true,
    "reserved": 12000, // 余裕を持たせた要約バッファ
    "tail_turns": 3,   // 直近のやり取りをより深く保持
    "prune": true      // 不要なツール出力を積極的に削除
  },

  // --------------------------------------------------------------------------
  // 4. 言語サーバー (LSP): コード理解の精度向上
  // --------------------------------------------------------------------------
  "lsp": {
    "typescript-language-server": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx"]
    },
    "bash-language-server": {
      "command": ["bash-language-server", "start"],
      "extensions": [".sh"]
    },
    "pyright": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py"]
    }
  },

  // --------------------------------------------------------------------------
  // 5. 実験的・最新機能の有効化
  // --------------------------------------------------------------------------
  "experimental": {
    "batch_tool": true, // 複数ツール実行をバッチ化して高速化
    "continue_loop_on_deny": false, // 拒否された場合は思考を停止（安全重視）
    "mcp_timeout": 10000 // MCPリクエストのタイムアウト延長
  },

  // --------------------------------------------------------------------------
  // 6. 外部リソース・ルール
  // --------------------------------------------------------------------------
  "instructions": [
    "docs/global-rules/AGENTS.global.md",
    "agent-skills/superpowers/using-superpowers/SKILL.md"
  ],
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/coverage/**",
      "**/*.lock",
      "**/.git/**"
    ]
  },

  // --------------------------------------------------------------------------
  // 7. プロバイダー構成 (主要なA2AおよびAPI接続)
  // --------------------------------------------------------------------------
  "provider": {
    "opencode": {
      "whitelist": [
        "gpt-5-nano",
        "kimi-k2.5-free",
        "big-pickle",
        "minimax-m2.5-free"
      ]
    },
    "github-copilot": {
      "whitelist": ["claude-4.6-sonnet", "gpt-5.4", "gemini-3.1-pro-preview"]
    },
    "openrouter": {
      "options": { "baseURL": "https://openrouter.ai/api/v1" },
      "whitelist": ["anthropic/claude-4.6-sonnet", "google/gemini-3.1-pro-preview"]
    }
  }
}
