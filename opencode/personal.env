# OpenCode Environment Variables for Personal Use (Multi-Model Stack)
#
# Optimal mapping leveraging model family characteristics (compliant with opencode.jsonc):
#   Kimi family (sakura main / cloudflare-workers-ai fallback) -> Instruction-following. Strong in long contexts and multi-step Todo management.
#                           -> Sisyphus (Orchestration) / Atlas (Management) / Writing
#   GPT family (OpenAI)      -> Principle-driven. Strong in autonomous problem solving, deep implementation, and auditing.
#                           -> Hephaestus (Implementation) / Oracle (Expert Consultant) / Momus (Reviewer)

# ------------------------------------------------------------------------------
# 1. Orchestration (Core Agents)
# ------------------------------------------------------------------------------

# SISYPHUS: Orchestration agent. Uses Kimi-K2.6 (sakura) or Kimi-K2.7 (cloudflare-workers-ai) for instruction following and Todo management.
SISYPHUS_MODEL=sakura/preview/Kimi-K2.6
SISYPHUS_VARIANT=default
SISYPHUS_FALLBACK_MODEL=cloudflare-workers-ai/@cf/moonshotai/kimi-k2.7-code

# PROMETHEUS: Agent Swarm planner. Uses GPT-5.5 for high structuring capability.
PROMETHEUS_MODEL=openai/gpt-5.5
PROMETHEUS_VARIANT=default
PROMETHEUS_FALLBACK_MODEL=sakura/preview/Kimi-K2.6

# ORACLE: Architecture consultant and complex debugging. Fully utilizes GPT-5.5's principle-driven reasoning.
ORACLE_MODEL=openai/gpt-5.5
ORACLE_VARIANT=high
ORACLE_FALLBACK_MODEL=cloudflare-workers-ai/@cf/zai-org/glm-5.2

# MOMUS: Plan reviewer. Prioritizes critical thinking of GPT-5.5 (xhigh) for strict validation.
MOMUS_MODEL=openai/gpt-5.5
MOMUS_VARIANT=xhigh
MOMUS_FALLBACK_MODEL=sakura/preview/Kimi-K2.6

# METIS: Pre-planning consultant. Prioritizes Kimi to eliminate ambiguity.
METIS_MODEL=sakura/preview/Kimi-K2.6
METIS_VARIANT=default
METIS_FALLBACK_MODEL=cloudflare-workers-ai/@cf/moonshotai/kimi-k2.7-code

# ------------------------------------------------------------------------------
# 2. Deep Specialists (Implementation)
# ------------------------------------------------------------------------------

# HEPHAESTUS: Implementation specialist. GPT's autonomous problem solving is best suited for deep coding.
HEPHAESTUS_DISABLED=false
HEPHAESTUS_MODEL=openai/gpt-5.5
HEPHAESTUS_VARIANT=medium
HEPHAESTUS_FALLBACK_MODEL=sakura/preview/Kimi-K2.6

# ATLAS: Management and Todo coordinator. Uses Kimi for instruction following.
ATLAS_MODEL=sakura/preview/Kimi-K2.6
ATLAS_VARIANT=default
ATLAS_FALLBACK_MODEL=cloudflare-workers-ai/@cf/moonshotai/kimi-k2.7-code

# SISYPHUS_JUNIOR: Task runner. Uses gpt-5.4-mini for speed.
SISYPHUS_JUNIOR_MODEL=openai/gpt-5.4-mini
SISYPHUS_JUNIOR_VARIANT=default
SISYPHUS_JUNIOR_FALLBACK_MODEL=opencode/minimax-m2.5

# ------------------------------------------------------------------------------
# 3. Utility & Speed (Search & Scaffolding)
# ------------------------------------------------------------------------------

# EXPLORE: Codebase explorer. Uses fast gpt-5.4-mini.
EXPLORE_MODEL=openai/gpt-5.4-mini
EXPLORE_VARIANT=default
EXPLORE_FALLBACK_MODEL=opencode/qwen3.6-plus

# LIBRARIAN: External documentation searcher.
LIBRARIAN_MODEL=openai/gpt-5.4-mini
LIBRARIAN_VARIANT=default
LIBRARIAN_FALLBACK_MODEL=opencode/qwen3.6-plus

# MULTIMODAL_LOOKER: Visual analyst. Uses Kimi with vision capabilities.
MULTIMODAL_LOOKER_MODEL=sakura/preview/Kimi-K2.6
MULTIMODAL_LOOKER_VARIANT=default
MULTIMODAL_LOOKER_FALLBACK_MODEL=cloudflare-workers-ai/@cf/moonshotai/kimi-k2.6

# ------------------------------------------------------------------------------
# 4. Category Settings (Task-based Routing)
# ------------------------------------------------------------------------------

# ultrabrain: Most advanced reasoning. Balanced setup with GPT and Kimi/GLM.
ULTRABRAIN_MODEL=openai/gpt-5.5
ULTRABRAIN_VARIANT=xhigh
ULTRABRAIN_FALLBACK_MODEL=cloudflare-workers-ai/@cf/zai-org/glm-5.2

# deep: Autonomous implementation. Leverages GPT's craftsmanship.
DEEP_MODEL=openai/gpt-5.5
DEEP_VARIANT=medium
DEEP_FALLBACK_MODEL=sakura/preview/Kimi-K2.6

# quick: Fast responses. Prioritizes gpt-5.4-mini.
QUICK_MODEL=openai/gpt-5.4-mini
QUICK_VARIANT=default
QUICK_FALLBACK_MODEL=opencode/minimax-m2.5

# writing: Content creation. Uses Kimi-K2.6.
WRITING_MODEL=sakura/preview/Kimi-K2.6
WRITING_VARIANT=default
WRITING_FALLBACK_MODEL=cloudflare-workers-ai/@cf/moonshotai/kimi-k2.6

# visual-engineering: UI/UX analysis. GLM / Kimi.
VISUAL_ENGINEERING_MODEL=cloudflare-workers-ai/@cf/zai-org/glm-5.2
VISUAL_ENGINEERING_VARIANT=default
VISUAL_ENGINEERING_FALLBACK_MODEL=cloudflare-workers-ai/@cf/moonshotai/kimi-k2.6

# artistry: Creativity. GPT / Kimi.
ARTISTRY_MODEL=openai/gpt-5.5
ARTISTRY_VARIANT=high
ARTISTRY_FALLBACK_MODEL=sakura/preview/Kimi-K2.6

# unspecified-high: Heavy load general tasks. Claude.
UNSPECIFIED_HIGH_MODEL=anthropic/claude-fable-5
UNSPECIFIED_HIGH_VARIANT=high
UNSPECIFIED_HIGH_FALLBACK_MODEL=anthropic/claude-opus-4-8

# unspecified-low: Light load general tasks. Kimi-K2.6.
UNSPECIFIED_LOW_MODEL=sakura/preview/Kimi-K2.6
UNSPECIFIED_LOW_VARIANT=default
UNSPECIFIED_LOW_FALLBACK_MODEL=cloudflare-workers-ai/@cf/moonshotai/kimi-k2.6

# ------------------------------------------------------------------------------
# 5. Extra Modes
# ------------------------------------------------------------------------------

# ULTRA_WORK: Maximum capacity workloads. GPT-5.5 (max) and Kimi.
ULTRA_WORK_MODEL=openai/gpt-5.5
ULTRA_WORK_VARIANT=max
ULTRA_WORK_FALLBACK_MODEL=sakura/preview/Kimi-K2.6
