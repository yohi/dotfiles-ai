# OpenCode Environment Variables for Personal Use (GPT + Kimi-K2.6 Only)
#
# 利用可能モデル制約:
#   - OpenAI GPT 系: gpt-5.5 (max/high/medium), gpt-5.4-mini
#   - Kimi K2.6     : openrouter/moonshotai/kimi-k2.6:free
#
# モデルファミリー特性 (README §4 参照):
#   GPT 系  → 原則駆動型。自律解決・深い実装・監査に強い。
#              → ultrabrain / deep / Hephaestus / Oracle / Momus 向き
#   Kimi 系 → 指示追従型。長大文脈・多段 Todo 管理に強い。
#              → ultrabrain サポート / writing / Sisyphus / Atlas 向き

# ------------------------------------------------------------------------------
# 1. Orchestration (Core Agents)
# ------------------------------------------------------------------------------

# SISYPHUS: 司令塔。GPT-5.5 (high) で全体統制し、
#           Kimi-K2.6 の長大文脈対応力をフォールバックに配置。
SISYPHUS_MODEL=openai/gpt-5.5
SISYPHUS_VARIANT=high
SISYPHUS_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free

# PROMETHEUS: Agent Swarm 計画担当。高精度推論が必要なため GPT-5.5。
PROMETHEUS_MODEL=openai/gpt-5.5
PROMETHEUS_VARIANT=high
PROMETHEUS_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free

# ORACLE: アーキ相談・難解デバッグ。GPT-5.5 の原則駆動型推論を最大活用。
ORACLE_MODEL=openai/gpt-5.5
ORACLE_VARIANT=high
ORACLE_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free

# MOMUS: 計画レビュアー。厳格な検証に GPT-5.5 (max) を優先。
MOMUS_MODEL=openai/gpt-5.5
MOMUS_VARIANT=max
MOMUS_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free

# METIS: 計画前コンサル。リスク特定・曖昧さ排除に GPT-5.5。
METIS_MODEL=openai/gpt-5.5
METIS_VARIANT=high
METIS_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free

# ------------------------------------------------------------------------------
# 2. Deep Specialists (Implementation)
# ------------------------------------------------------------------------------

# HEPHAESTUS: 実装職人。GPT 専用プロンプト最適化済み。medium で十分。
HEPHAESTUS_DISABLED=false
HEPHAESTUS_MODEL=openai/gpt-5.5
HEPHAESTUS_VARIANT=medium
HEPHAESTUS_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free

# ATLAS: 現場監督・Todo 管理。Kimi の指示追従型を活かし、GPT-5.5 をフォールバックに。
ATLAS_MODEL=openrouter/moonshotai/kimi-k2.6:free
ATLAS_VARIANT=default
ATLAS_FALLBACK_MODEL=openai/gpt-5.5

# SISYPHUS_JUNIOR: 実行用作業員（動的生成）。速度優先で gpt-5.4-mini を採用。
SISYPHUS_JUNIOR_MODEL=openai/gpt-5.4-mini
SISYPHUS_JUNIOR_VARIANT=default
SISYPHUS_JUNIOR_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free

# ------------------------------------------------------------------------------
# 3. Utility & Speed (Search & Scaffolding)
# ------------------------------------------------------------------------------

# EXPLORE: コードベース探索・grep。高速な gpt-5.4-mini を採用。
EXPLORE_MODEL=openai/gpt-5.4-mini
EXPLORE_VARIANT=default
EXPLORE_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free

# LIBRARIAN: 外部ドキュメント検索。高速な gpt-5.4-mini を採用。
LIBRARIAN_MODEL=openai/gpt-5.4-mini
LIBRARIAN_VARIANT=default
LIBRARIAN_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free

# MULTIMODAL_LOOKER: 視覚アナリスト。GPT-5.5 でマルチモーダル解析し、
#                    Kimi-K2.6 をフォールバックに。
MULTIMODAL_LOOKER_MODEL=openai/gpt-5.5
MULTIMODAL_LOOKER_VARIANT=medium
MULTIMODAL_LOOKER_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free

# ------------------------------------------------------------------------------
# 4. Category Settings (Task-based Routing)
# ------------------------------------------------------------------------------

# ultrabrain: 最強推論。GPT-5.5 (max) を主軸に、Kimi をフォールバック。
ULTRABRAIN_MODEL=openai/gpt-5.5
ULTRABRAIN_VARIANT=max
ULTRABRAIN_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free

# deep: 自律実装。GPT-5.5 の原則駆動型を活用。
DEEP_MODEL=openai/gpt-5.5
DEEP_VARIANT=medium
DEEP_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free

# quick: 高速応答。gpt-5.4-mini を最優先、Kimi をフォールバック。
QUICK_MODEL=openai/gpt-5.4-mini
QUICK_VARIANT=default
QUICK_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free

# writing: 文章作成。指示追従に優れる Kimi-K2.6 を最優先。
WRITING_MODEL=openrouter/moonshotai/kimi-k2.6:free
WRITING_VARIANT=default
WRITING_FALLBACK_MODEL=openai/gpt-5.5

# visual-engineering: UI/UX 解析。GPT-5.5 で代替（Gemini/Qwen 利用不可のため）。
VISUAL_ENGINEERING_MODEL=openai/gpt-5.5
VISUAL_ENGINEERING_VARIANT=high
VISUAL_ENGINEERING_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free

# artistry: 創造性。Kimi-K2.6 の長文文脈対応力を活用。
ARTISTRY_MODEL=openrouter/moonshotai/kimi-k2.6:free
ARTISTRY_VARIANT=default
ARTISTRY_FALLBACK_MODEL=openai/gpt-5.5

# unspecified-high: 高負荷汎用。Kimi の指示追従力を活かし、GPT をフォールバック。
UNSPECIFIED_HIGH_MODEL=openrouter/moonshotai/kimi-k2.6:free
UNSPECIFIED_HIGH_VARIANT=default
UNSPECIFIED_HIGH_FALLBACK_MODEL=openai/gpt-5.5

# unspecified-low: 低負荷汎用。軽量な gpt-5.4-mini を採用。
UNSPECIFIED_LOW_MODEL=openai/gpt-5.4-mini
UNSPECIFIED_LOW_VARIANT=default
UNSPECIFIED_LOW_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free

# ------------------------------------------------------------------------------
# 5. Extra Modes
# ------------------------------------------------------------------------------

# ULTRA_WORK: 最大負荷作業。GPT-5.5 (max) 一択、Kimi をフォールバック。
ULTRA_WORK_MODEL=openai/gpt-5.5
ULTRA_WORK_VARIANT=max
ULTRA_WORK_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free
