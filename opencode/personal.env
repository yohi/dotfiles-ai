# OpenCode Environment Variables for Personal Use (GPT-5.5 & Kimi-K2.6 Optimized)

# ------------------------------------------------------------------------------
# 1. Core Logic & Orchestration (Agent Settings)
# ------------------------------------------------------------------------------
# SISYPHUS: 司令塔。GPT-5.5 の圧倒的な推論力で全体を統制し、
# Kimi-K2.6 の高い指示追従性と長大文脈対応力をフォールバックに配置。
SISYPHUS_MODEL=openai/gpt-5.5
SISYPHUS_VARIANT=max
SISYPHUS_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free

PROMETHEUS_MODEL=openai/gpt-5.5
PROMETHEUS_VARIANT=max
PROMETHEUS_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free

ORACLE_MODEL=openai/gpt-5.5
ORACLE_VARIANT=max
ORACLE_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free

MOMUS_MODEL=openai/gpt-5.5
MOMUS_VARIANT=max
MOMUS_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free

METIS_MODEL=openai/gpt-5.5
METIS_VARIANT=max
METIS_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free

# ------------------------------------------------------------------------------
# 2. Deep Specialists (Implementation)
# ------------------------------------------------------------------------------
# HEPHAESTUS: 実装職人。GPT-5.5 専用プロンプトに最適化。
HEPHAESTUS_DISABLED=false
HEPHAESTUS_MODEL=openai/gpt-5.5
HEPHAESTUS_VARIANT=medium
HEPHAESTUS_FALLBACK_MODEL=openai/gpt-5.4-mini

# ATLAS: 現場監督。速度と精度のバランスが良い GPT-5.4-mini を採用。
ATLAS_MODEL=openai/gpt-5.4-mini
ATLAS_VARIANT=default
ATLAS_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free

# ------------------------------------------------------------------------------
# 3. Utility & Speed (Search & Scaffolding)
# ------------------------------------------------------------------------------
EXPLORE_MODEL=openai/gpt-5.4-mini
EXPLORE_VARIANT=default
EXPLORE_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free

LIBRARIAN_MODEL=openai/gpt-5.4-mini
LIBRARIAN_VARIANT=default
LIBRARIAN_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free

# ------------------------------------------------------------------------------
# 4. Category Settings (Task-based Routing)
# ------------------------------------------------------------------------------
# ultrabrain: 最強推論。GPT-5.5 を主軸に。
ULTRABRAIN_MODEL=openai/gpt-5.5
ULTRABRAIN_VARIANT=max
ULTRABRAIN_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free

# deep: 自律解決。実装に強い GPT-5.5。
DEEP_MODEL=openai/gpt-5.5
DEEP_VARIANT=medium
DEEP_FALLBACK_MODEL=openai/gpt-5.4-mini

# quick: 些細な修正。高速な GPT-5.4-mini。
QUICK_MODEL=openai/gpt-5.4-mini
QUICK_VARIANT=default
QUICK_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free

# writing: 文章作成。表現力に優れる Kimi-K2.6 を最優先。
WRITING_MODEL=openrouter/moonshotai/kimi-k2.6:free
WRITING_VARIANT=default
WRITING_FALLBACK_MODEL=openai/gpt-5.5

# visual-engineering: UI/UX解析。Qwen3 または Kimi。
VISUAL_ENGINEERING_MODEL=nvidia/qwen/qwen3-coder-480b-a35b-instruct
VISUAL_ENGINEERING_VARIANT=default
VISUAL_ENGINEERING_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free

# artistry: 創造性。Kimi-K2.6 を採用。
ARTISTRY_MODEL=openrouter/moonshotai/kimi-k2.6:free
ARTISTRY_VARIANT=default
ARTISTRY_FALLBACK_MODEL=openai/gpt-5.5

# unspecified: 汎用。
UNSPECIFIED_HIGH_MODEL=openrouter/moonshotai/kimi-k2.6:free
UNSPECIFIED_HIGH_VARIANT=default
UNSPECIFIED_HIGH_FALLBACK_MODEL=openai/gpt-5.5

UNSPECIFIED_LOW_MODEL=openai/gpt-5.4-mini
UNSPECIFIED_LOW_VARIANT=default
UNSPECIFIED_LOW_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free

# ------------------------------------------------------------------------------
# 5. Extra Modes
# ------------------------------------------------------------------------------
ULTRA_WORK_MODEL=openai/gpt-5.5
ULTRA_WORK_FALLBACK_MODEL=openrouter/moonshotai/kimi-k2.6:free
