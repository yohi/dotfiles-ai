# OpenCode Environment Variables for Personal Use (Multi-Model Stack)
#
# モデルファミリー特性を活かした「適材適所」の構成:
#   Kimi 系 (opencode-go) → 指示追従型。長大文脈・多段 Todo 管理に強い。
#                           → Sisyphus (司令塔) / Atlas (現場監督) / Writing
#   GPT 系 (OpenAI)      → 原則駆動型。自律解決・深い実装・監査に強い。
#                           → Hephaestus (実装) / Oracle (賢者) / Momus (レビュアー)
#   Qwen 系 (opencode-go) → 視覚・推論型。デザイン解析、CSS、UI構造理解に強い。
#                           → Looker (視覚) / Visual Engineering / Artistry

# ------------------------------------------------------------------------------
# 1. Orchestration (Core Agents)
# ------------------------------------------------------------------------------

# SISYPHUS: 司令塔。指示追従と Todo 管理に優れる Kimi-K2.6 をメインに据え、
#           GPT-5.5 (high) を知能補完のフォールバックに。
SISYPHUS_MODEL=opencode-go/kimi-k2.6
SISYPHUS_VARIANT=default
SISYPHUS_FALLBACK_MODEL=openai/gpt-5.5

# PROMETHEUS: Agent Swarm 計画担当。構造化能力が高い Qwen3.7-max を採用。
PROMETHEUS_MODEL=opencode-go/qwen3.7-max
PROMETHEUS_VARIANT=default
PROMETHEUS_FALLBACK_MODEL=openai/gpt-5.5

# ORACLE: アーキ相談・難解デバッグ。GPT-5.5 の原則駆動型推論を最大活用。
ORACLE_MODEL=openai/gpt-5.5
ORACLE_VARIANT=high
ORACLE_FALLBACK_MODEL=opencode-go/glm-5.1

# MOMUS: 計画レビュアー。厳格な検証には GPT-5.5 (max) の批判的思考を優先。
MOMUS_MODEL=openai/gpt-5.5
MOMUS_VARIANT=max
MOMUS_FALLBACK_MODEL=opencode-go/qwen3.7-max

# METIS: 計画前コンサル。曖昧さ排除のため Kimi と GPT を併用。
METIS_MODEL=opencode-go/kimi-k2.6
METIS_VARIANT=default
METIS_FALLBACK_MODEL=openai/gpt-5.5

# ------------------------------------------------------------------------------
# 2. Deep Specialists (Implementation)
# ------------------------------------------------------------------------------

# HEPHAESTUS: 実装職人。深い実装には GPT の自律解決力が最適。
HEPHAESTUS_DISABLED=false
HEPHAESTUS_MODEL=openai/gpt-5.5
HEPHAESTUS_VARIANT=medium
HEPHAESTUS_FALLBACK_MODEL=opencode-go/qwen3.7-max

# ATLAS: 現場監督・Todo 管理。指示追従の Kimi 一択。
ATLAS_MODEL=opencode-go/kimi-k2.6
ATLAS_VARIANT=default
ATLAS_FALLBACK_MODEL=openai/gpt-5.5

# SISYPHUS_JUNIOR: 実行用作業員。速度重視で gpt-5.4-mini。
SISYPHUS_JUNIOR_MODEL=openai/gpt-5.4-mini
SISYPHUS_JUNIOR_VARIANT=default
SISYPHUS_JUNIOR_FALLBACK_MODEL=opencode-go/minimax-m3

# ------------------------------------------------------------------------------
# 3. Utility & Speed (Search & Scaffolding)
# ------------------------------------------------------------------------------

# EXPLORE: コードベース探索。高速な MiniMax-M3 を採用。
EXPLORE_MODEL=opencode-go/minimax-m3
EXPLORE_VARIANT=default
EXPLORE_FALLBACK_MODEL=openai/gpt-5.4-mini

# LIBRARIAN: 外部ドキュメント検索。Qwen3.5-plus の検索親和性を活用。
LIBRARIAN_MODEL=opencode-go/qwen3.5-plus
LIBRARIAN_VARIANT=default
LIBRARIAN_FALLBACK_MODEL=openai/gpt-5.4-mini

# MULTIMODAL_LOOKER: 視覚アナリスト。視覚能力に定評のある Qwen3.7-max。
MULTIMODAL_LOOKER_MODEL=opencode-go/qwen3.7-max
MULTIMODAL_LOOKER_VARIANT=default
MULTIMODAL_LOOKER_FALLBACK_MODEL=openai/gpt-5.5

# ------------------------------------------------------------------------------
# 4. Category Settings (Task-based Routing)
# ------------------------------------------------------------------------------

# ultrabrain: 最強推論。GPT (原則) と Kimi (追従) のバランス型。
ULTRABRAIN_MODEL=openai/gpt-5.5
ULTRABRAIN_VARIANT=max
ULTRABRAIN_FALLBACK_MODEL=opencode-go/kimi-k2.6

# deep: 自律実装。GPT の職人芸を活用。
DEEP_MODEL=openai/gpt-5.5
DEEP_VARIANT=medium
DEEP_FALLBACK_MODEL=opencode-go/qwen3.7-max

# quick: 高速応答。MiniMax-M3 の圧倒的初速を優先。
QUICK_MODEL=opencode-go/minimax-m3
QUICK_VARIANT=default
QUICK_FALLBACK_MODEL=openai/gpt-5.4-mini

# writing: 文章作成。Kimi-K2.6 の文章表現力を活用。
WRITING_MODEL=opencode-go/kimi-k2.6
WRITING_VARIANT=default
WRITING_FALLBACK_MODEL=opencode-go/qwen3.7-max

# visual-engineering: UI/UX 解析。Qwen3.7-max の視覚推論。
VISUAL_ENGINEERING_MODEL=opencode-go/qwen3.7-max
VISUAL_ENGINEERING_VARIANT=default
VISUAL_ENGINEERING_FALLBACK_MODEL=opencode-go/glm-5.1

# artistry: 創造性。Qwen3.7-max。
ARTISTRY_MODEL=opencode-go/qwen3.7-max
ARTISTRY_VARIANT=default
ARTISTRY_FALLBACK_MODEL=opencode-go/kimi-k2.6

# unspecified-high: 高負荷汎用。Kimi-K2.6。
UNSPECIFIED_HIGH_MODEL=opencode-go/kimi-k2.6
UNSPECIFIED_HIGH_VARIANT=default
UNSPECIFIED_HIGH_FALLBACK_MODEL=openai/gpt-5.5

# unspecified-low: 低負荷汎用。gpt-5.4-mini。
UNSPECIFIED_LOW_MODEL=openai/gpt-5.4-mini
UNSPECIFIED_LOW_VARIANT=default
UNSPECIFIED_LOW_FALLBACK_MODEL=opencode-go/minimax-m2.7

# ------------------------------------------------------------------------------
# 5. Extra Modes
# ------------------------------------------------------------------------------

# ULTRA_WORK: 最大負荷作業。GPT-5.5 (max) と Qwen3.7-max。
ULTRA_WORK_MODEL=openai/gpt-5.5
ULTRA_WORK_VARIANT=max
ULTRA_WORK_FALLBACK_MODEL=opencode-go/qwen3.7-max
