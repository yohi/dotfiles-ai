# OpenCode Environment Variables for Personal Use (Multi-Model Stack)
#
# Optimal mapping leveraging model family characteristics (compliant with opencode.jsonc):
#   Kimi family (sakura main / cloudflare-workers-ai fallback) -> Instruction-following. Strong in long contexts and multi-step Todo management.
#                           -> Sisyphus (Orchestration) / Atlas (Management) / Writing
#   GPT family (OpenAI)      -> Principle-driven. Strong in autonomous problem solving, deep implementation, and auditing.
#                           -> Hephaestus (Implementation) / Oracle (Expert Consultant) / Momus (Reviewer)

# ------------------------------------------------------------------------------
# 1. Orchestration (Core Agents)
# ------------------------------------------------------------------------------

KIMI_K2_6=cloudflare-ai-gateway-custom/dynamic/kimi-k2.6
KIMI_K2_7_CODE=cloudflare-ai-gateway-custom/dynamic/kimi-k2.7-code
KIMI_K3=cloudflare-ai-gateway-custom/dynamic/kimi-k3
GLM_5_2=cloudflare-ai-gateway-custom/dynamic/glm-5.2
GPT_5_5=openai/gpt-5.5
GPT_5_4_MINI=openai/gpt-5.4-mini
GPT_5_6=openai/gpt-5.6
GPT_5_6_LUNA=openai/gpt-5.6-luna
GPT_5_6_SOL=openai/gpt-5.6-sol
GPT_5_6_TERRA=openai/gpt-5.6-terra

# SISYPHUS: Orchestration agent. Uses Kimi-K2.7 Code for instruction following and Todo management.
SISYPHUS_MODEL=${KIMK_K2_7_CODE}
SISYPHUS_VARIANT=default
SISYPHUS_FALLBACK_MODEL=${KIMI_K2_7_CODE}

# PROMETHEUS: Agent Swarm planner. Uses GPT-5.6 Sol (max) / GPT-5.5 (fallback).
PROMETHEUS_MODEL=${GPT_5_6_SOL}
PROMETHEUS_VARIANT=max
PROMETHEUS_FALLBACK_MODEL=${GPT_5_5}

# ORACLE: Architecture consultant and complex debugging.
ORACLE_MODEL=${GPT_5_6_SOL}
ORACLE_VARIANT=high
ORACLE_FALLBACK_MODEL=${QWEN_3_6_PLUS}

# MOMUS: Plan reviewer.
MOMUS_MODEL=${GPT_5_6_SOL}
MOMUS_VARIANT=xhigh
MOMUS_FALLBACK_MODEL=${GLM_5_2}

# METIS: Pre-planning consultant. Prioritizes Kimi to eliminate ambiguity.
METIS_MODEL=${KIMK_K2_7_CODE}
METIS_VARIANT=default
METIS_FALLBACK_MODEL=${KIMI_K2_7_CODE}

# ------------------------------------------------------------------------------
# 2. Deep Specialists (Implementation)
# ------------------------------------------------------------------------------

# HEPHAESTUS: Implementation specialist.
HEPHAESTUS_DISABLED=false
HEPHAESTUS_MODEL=${GPT_5_6_TERRA}
HEPHAESTUS_VARIANT=xhigh
HEPHAESTUS_FALLBACK_MODEL=${GLM_5_2}

# ATLAS: Management and Todo coordinator. Uses Kimi for instruction following.
ATLAS_MODEL=${KIMK_K2_7_CODE}
ATLAS_VARIANT=default
ATLAS_FALLBACK_MODEL=${KIMI_K2_7_CODE}

# SISYPHUS_JUNIOR: Task runner. Uses Kimi K2.7 Code for instruction following.
SISYPHUS_JUNIOR_MODEL=${KIMK_K2_7_CODE}
SISYPHUS_JUNIOR_VARIANT=default
SISYPHUS_JUNIOR_FALLBACK_MODEL=${KIMI_K2_7_CODE}

# ------------------------------------------------------------------------------
# 3. Utility & Speed (Search & Scaffolding)
# ------------------------------------------------------------------------------

# EXPLORE: Codebase explorer.
EXPLORE_MODEL=${GPT_5_6_LUNA}
EXPLORE_VARIANT=default
EXPLORE_FALLBACK_MODEL=${MINIMAX_M3}

# LIBRARIAN: External documentation searcher.
LIBRARIAN_MODEL=${GPT_5_6_LUNA}
LIBRARIAN_VARIANT=default
LIBRARIAN_FALLBACK_MODEL=${KIMI_K2_6}

# MULTIMODAL_LOOKER: Visual analyst. Uses GPT-5.6 Sol with vision capabilities.
MULTIMODAL_LOOKER_MODEL=${GPT_5_6_SOL}
MULTIMODAL_LOOKER_VARIANT=default
MULTIMODAL_LOOKER_FALLBACK_MODEL=${KIMI_K2_7_CODE}

# ------------------------------------------------------------------------------
# 4. Category Settings (Task-based Routing)
# ------------------------------------------------------------------------------

# ultrabrain: Most advanced reasoning.
ULTRABRAIN_MODEL=${GPT_5_6_SOL}
ULTRABRAIN_VARIANT=xhigh
ULTRABRAIN_FALLBACK_MODEL=${QWEN_3_6_PLUS}

# deep: Autonomous implementation.
DEEP_MODEL=${GPT_5_6_TERRA}
DEEP_VARIANT=xhigh
DEEP_FALLBACK_MODEL=${QWEN_3_6_PLUS}

# quick: Fast responses.
QUICK_MODEL=${GPT_5_6_LUNA}
QUICK_VARIANT=default
QUICK_FALLBACK_MODEL=${KIMI_K2_6}

# writing: Content creation.
WRITING_MODEL=${KIMK_K2_7_CODE}
WRITING_VARIANT=default
WRITING_FALLBACK_MODEL=${KIMI_K2_7_CODE}

# visual-engineering: UI/UX analysis.
VISUAL_ENGINEERING_MODEL=${QWEN_3_6_PLUS}
VISUAL_ENGINEERING_VARIANT=high
VISUAL_ENGINEERING_FALLBACK_MODEL=${GLM_5_2}

# artistry: Creativity.
ARTISTRY_MODEL=${QWEN_3_6_PLUS}
ARTISTRY_VARIANT=high
ARTISTRY_FALLBACK_MODEL=${GPT_5_6_SOL}

# unspecified-high: Heavy load general tasks.
UNSPECIFIED_HIGH_MODEL=${GPT_5_6_SOL}
UNSPECIFIED_HIGH_VARIANT=high
UNSPECIFIED_HIGH_FALLBACK_MODEL=${KIMI_K2_7_CODE}

# unspecified-low: Light load general tasks. GPT-5.6 Luna.
UNSPECIFIED_LOW_MODEL=${GPT_5_6_LUNA}
UNSPECIFIED_LOW_VARIANT=xhigh
UNSPECIFIED_LOW_FALLBACK_MODEL=${KIMI_K2_6}

# ------------------------------------------------------------------------------
# 5. Extra Modes
# ------------------------------------------------------------------------------

# ULTRA_WORK: Maximum capacity workloads. GPT-5.6 Sol (max) and Kimi.
ULTRA_WORK_MODEL=${GPT_5_6_SOL}
ULTRA_WORK_VARIANT=max
ULTRA_WORK_FALLBACK_MODEL=${KIMI_K2_7_CODE}
