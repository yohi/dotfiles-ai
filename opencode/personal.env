# OpenCode Environment Variables for Personal Use (Multi-Model Stack)
#
# モデルファミリー特性を活かした「適材適所」の構成 (opencode.jsonc 準拠):
#   Kimi 系 (sakura メイン / cloudflare-workers-ai フォールバック) → 指示追従型。長大文脈・多段 Todo 管理に強い。
#                           → Sisyphus (司令塔) / Atlas (現場監督) / Writing
#   GPT 系 (OpenAI)      → 原則駆動型。自律解決・深い実装・監査に強い。
#                           → Hephaestus (実装) / Oracle (賢者) / Momus (レビュアー)

# ------------------------------------------------------------------------------
# 1. Orchestration (Core Agents)
# ------------------------------------------------------------------------------

# SISYPHUS: 司令塔。指示追従と Todo 管理に優れる Kimi-K2.7 (opencode-go) または Kimi-K2.6 (sakura) をメインにする。
SISYPHUS_MODEL=opencode-go/kimi-k2.7-code
SISYPHUS_VARIANT=default
SISYPHUS_FALLBACK_MODEL=sakura/preview/Kimi-K2.6

# PROMETHEUS: Agent Swarm 計画担当。構造化能力が高い GPT-5.5。
PROMETHEUS_MODEL=openai/gpt-5.5
PROMETHEUS_VARIANT=default
PROMETHEUS_FALLBACK_MODEL=opencode-go/kimi-k2.7-code

# ORACLE: アーキ相談・難解デバッグ。GPT-5.5 の原則駆動型推論を最大活用。
ORACLE_MODEL=openai/gpt-5.5
ORACLE_VARIANT=high
ORACLE_FALLBACK_MODEL=opencode-go/glm-5.1

# MOMUS: 計画レビュアー。厳格な検証には GPT-5.5 (xhigh) の批判的思考を優先。
MOMUS_MODEL=openai/gpt-5.5
MOMUS_VARIANT=xhigh
MOMUS_FALLBACK_MODEL=opencode-go/kimi-k2.7-code

# METIS: 計画前コンサル。曖昧さ排除のため Kimi を優先。
METIS_MODEL=opencode-go/kimi-k2.7-code
METIS_VARIANT=default
METIS_FALLBACK_MODEL=sakura/preview/Kimi-K2.6

# ------------------------------------------------------------------------------
# 2. Deep Specialists (Implementation)
# ------------------------------------------------------------------------------

# HEPHAESTUS: 実装職人。深い実装には GPT の自律解決力が最適。
HEPHAESTUS_DISABLED=false
HEPHAESTUS_MODEL=openai/gpt-5.5
HEPHAESTUS_VARIANT=medium
HEPHAESTUS_FALLBACK_MODEL=opencode-go/kimi-k2.7-code

# ATLAS: 現場監督・Todo 管理。指示追従の Kimi。
ATLAS_MODEL=opencode-go/kimi-k2.7-code
ATLAS_VARIANT=default
ATLAS_FALLBACK_MODEL=sakura/preview/Kimi-K2.6

# SISYPHUS_JUNIOR: 実行用作業員。速度重視で gpt-5.4-mini。
SISYPHUS_JUNIOR_MODEL=openai/gpt-5.4-mini
SISYPHUS_JUNIOR_VARIANT=default
SISYPHUS_JUNIOR_FALLBACK_MODEL=opencode-go/minimax-m3

# ------------------------------------------------------------------------------
# 3. Utility & Speed (Search & Scaffolding)
# ------------------------------------------------------------------------------

# EXPLORE: コードベース探索。高速な gpt-5.4-mini を採用。
EXPLORE_MODEL=openai/gpt-5.4-mini
EXPLORE_VARIANT=default
EXPLORE_FALLBACK_MODEL=opencode-go/qwen3.5-plus

# LIBRARIAN: 外部ドキュメント検索。
LIBRARIAN_MODEL=openai/gpt-5.4-mini
LIBRARIAN_VARIANT=default
LIBRARIAN_FALLBACK_MODEL=opencode-go/qwen3.5-plus

# MULTIMODAL_LOOKER: 視覚アナリスト。視覚能力がある Kimi。
MULTIMODAL_LOOKER_MODEL=opencode-go/kimi-k2.7-code
MULTIMODAL_LOOKER_VARIANT=default
MULTIMODAL_LOOKER_FALLBACK_MODEL=sakura/preview/Kimi-K2.6

# ------------------------------------------------------------------------------
# 4. Category Settings (Task-based Routing)
# ------------------------------------------------------------------------------

# ultrabrain: 最強推論。GPT と Kimi/GLM のバランス型。
ULTRABRAIN_MODEL=openai/gpt-5.5
ULTRABRAIN_VARIANT=xhigh
ULTRABRAIN_FALLBACK_MODEL=opencode-go/glm-5.1

# deep: 自律実装。GPT の職人芸を活用。
DEEP_MODEL=openai/gpt-5.5
DEEP_VARIANT=medium
DEEP_FALLBACK_MODEL=opencode-go/kimi-k2.7-code

# quick: 高速応答。gpt-5.4-mini を優先。
QUICK_MODEL=openai/gpt-5.4-mini
QUICK_VARIANT=default
QUICK_FALLBACK_MODEL=opencode-go/minimax-m3

# writing: 文章作成。Kimi-K2.7 を活用。
WRITING_MODEL=opencode-go/kimi-k2.7-code
WRITING_VARIANT=default
WRITING_FALLBACK_MODEL=sakura/preview/Kimi-K2.6

# visual-engineering: UI/UX 解析。GLM / Kimi。
VISUAL_ENGINEERING_MODEL=opencode-go/glm-5.1
VISUAL_ENGINEERING_VARIANT=default
VISUAL_ENGINEERING_FALLBACK_MODEL=sakura/preview/Kimi-K2.6

# artistry: 創造性。GPT / Kimi。
ARTISTRY_MODEL=openai/gpt-5.5
ARTISTRY_VARIANT=high
ARTISTRY_FALLBACK_MODEL=opencode-go/kimi-k2.7-code

# unspecified-high: 高負荷汎用。Claude / GPT / Kimi。
UNSPECIFIED_HIGH_MODEL=anthropic/claude-fable-5
UNSPECIFIED_HIGH_VARIANT=high
UNSPECIFIED_HIGH_FALLBACK_MODEL="anthropic/claude-opus-4-8\", \"anthropic/claude-opus-4-7\", \"openai/gpt-5.5\", \"opencode-go/kimi-k2.7-code"

# unspecified-low: 低負荷汎用。Kimi-K2.7。
UNSPECIFIED_LOW_MODEL=opencode-go/kimi-k2.7-code
UNSPECIFIED_LOW_VARIANT=default
UNSPECIFIED_LOW_FALLBACK_MODEL=sakura/preview/Kimi-K2.6

# ------------------------------------------------------------------------------
# 5. Extra Modes
# ------------------------------------------------------------------------------

# ULTRA_WORK: 最大負荷作業。GPT-5.5 (max) と Kimi。
ULTRA_WORK_MODEL=openai/gpt-5.5
ULTRA_WORK_VARIANT=max
ULTRA_WORK_FALLBACK_MODEL=opencode-go/kimi-k2.7-code
