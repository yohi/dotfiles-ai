# OpenCode Environment Variables for Work (Amazon Bedrock - Claude Focused)
# Configured based on Claude Best Practices (Bedrock Version)

# ==============================================================================
# Claude (Anthropic) モデル活用ベストプラクティス (Bedrock)
# ==============================================================================
# 「指示遂行能力（Opus）」、「コストと速度のバランス（Sonnet）」、「速度と単純作業（Haiku）」を、
# エージェントの役割とタスクの複雑さに応じて適切に配分するのが鍵です。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. エージェントの割り当て (Agent Settings)
# ------------------------------------------------------------------------------
# sisyphus   (Opus): 司令塔。巨大なプロンプトを正確に理解し指示を出す司令塔。
# prometheus (Opus): 戦略プランナー。多角的な推論が最も活きる役割。
# oracle     (Opus): 設計・レビュー。深い洞察が必要。
# momus      (Opus): 計画検証。厳格なレビューが必要。
# atlas      (Sonnet): Todo管理・小規模調整。高速なSonnetで快適に動作。
# explore    (Haiku): 高速探索。知能よりも速度とコストを優先。
# librarian  (Haiku): 証拠調査。速度重視。
# hephaestus (N/A): GPT-5.5専用プロンプトのため、Claude環境では原則非推奨。
# ------------------------------------------------------------------------------

HEPHAESTUS_DISABLED=true
HEPHAESTUS_MODEL=amazon-bedrock/global.anthropic.claude-sonnet-4-6
HEPHAESTUS_VARIANT=default
HEPHAESTUS_FALLBACK_MODEL=amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0

SISYPHUS_MODEL=amazon-bedrock/global.anthropic.claude-opus-4-8
SISYPHUS_VARIANT=max
SISYPHUS_FALLBACK_MODEL=amazon-bedrock/global.anthropic.claude-sonnet-4-6

PROMETHEUS_MODEL=amazon-bedrock/global.anthropic.claude-opus-4-8
PROMETHEUS_VARIANT=max
PROMETHEUS_FALLBACK_MODEL=amazon-bedrock/global.anthropic.claude-sonnet-4-6

ATLAS_MODEL=amazon-bedrock/global.anthropic.claude-sonnet-4-6
ATLAS_VARIANT=default
ATLAS_FALLBACK_MODEL=amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0

ORACLE_MODEL=amazon-bedrock/global.anthropic.claude-opus-4-8
ORACLE_VARIANT=max
ORACLE_FALLBACK_MODEL=amazon-bedrock/global.anthropic.claude-sonnet-4-6

EXPLORE_MODEL=amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0
EXPLORE_VARIANT=default
EXPLORE_FALLBACK_MODEL=amazon-bedrock/global.anthropic.claude-sonnet-4-6

LIBRARIAN_MODEL=amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0
LIBRARIAN_VARIANT=default
LIBRARIAN_FALLBACK_MODEL=amazon-bedrock/global.anthropic.claude-sonnet-4-6

MOMUS_MODEL=amazon-bedrock/global.anthropic.claude-opus-4-8
MOMUS_VARIANT=max
MOMUS_FALLBACK_MODEL=amazon-bedrock/global.anthropic.claude-sonnet-4-6

METIS_MODEL=amazon-bedrock/global.anthropic.claude-opus-4-8
METIS_VARIANT=max
METIS_FALLBACK_MODEL=amazon-bedrock/global.anthropic.claude-sonnet-4-6

MULTIMODAL_LOOKER_MODEL=amazon-bedrock/global.anthropic.claude-opus-4-8
MULTIMODAL_LOOKER_VARIANT=max
MULTIMODAL_LOOKER_FALLBACK_MODEL=amazon-bedrock/global.anthropic.claude-sonnet-4-6

# ------------------------------------------------------------------------------
# 2. カテゴリの割り当て (Category Settings)
# ------------------------------------------------------------------------------
# ultrabrain         (Opus): 最高の知能を割り当て。
# deep               (Opus): 自律的な長時間探索。文脈理解の深いOpusが適任。
# unspecified-high   (Opus): 標準的な高難易度タスク用。
# unspecified-low    (Sonnet): 一般的な実装作業用。コスパ重視。
# writing            (Sonnet): 文章作成。表現力と速度の両立。
# quick              (Haiku): タイポ修正や単純置換。瞬時に完了。
# visual-engineering (Opus): 画像認識能力の高いOpusでUIデバッグ等を安全に遂行。
# ------------------------------------------------------------------------------

ULTRABRAIN_MODEL=amazon-bedrock/global.anthropic.claude-opus-4-8
ULTRABRAIN_VARIANT=max
ULTRABRAIN_FALLBACK_MODEL=amazon-bedrock/global.anthropic.claude-sonnet-4-6

DEEP_MODEL=amazon-bedrock/global.anthropic.claude-opus-4-8
DEEP_VARIANT=max
DEEP_FALLBACK_MODEL=amazon-bedrock/global.anthropic.claude-sonnet-4-6

UNSPECIFIED_HIGH_MODEL=amazon-bedrock/global.anthropic.claude-opus-4-8
UNSPECIFIED_HIGH_VARIANT=max
UNSPECIFIED_HIGH_FALLBACK_MODEL=amazon-bedrock/global.anthropic.claude-sonnet-4-6

UNSPECIFIED_LOW_MODEL=amazon-bedrock/global.anthropic.claude-sonnet-4-6
UNSPECIFIED_LOW_VARIANT=default
UNSPECIFIED_LOW_FALLBACK_MODEL=amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0

WRITING_MODEL=amazon-bedrock/global.anthropic.claude-sonnet-4-6
WRITING_VARIANT=default
WRITING_FALLBACK_MODEL=amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0

QUICK_MODEL=amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0
QUICK_VARIANT=default
QUICK_FALLBACK_MODEL=amazon-bedrock/global.anthropic.claude-sonnet-4-6

VISUAL_ENGINEERING_MODEL=amazon-bedrock/global.anthropic.claude-opus-4-8
VISUAL_ENGINEERING_VARIANT=max
VISUAL_ENGINEERING_FALLBACK_MODEL=amazon-bedrock/global.anthropic.claude-sonnet-4-6

ARTISTRY_MODEL=amazon-bedrock/global.anthropic.claude-sonnet-4-6
ARTISTRY_VARIANT=default
ARTISTRY_FALLBACK_MODEL=amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0

# ------------------------------------------------------------------------------
# 3. 特殊モード / その他 (Special Modes)
# ------------------------------------------------------------------------------
ULTRA_WORK_MODEL=amazon-bedrock/global.anthropic.claude-opus-4-8
ULTRA_WORK_FALLBACK_MODEL=amazon-bedrock/global.anthropic.claude-sonnet-4-6

# Cloudflare API Token to bypass opencode provider check
CLOUDFLARE_API_TOKEN=dummy_token

