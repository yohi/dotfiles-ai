{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/refs/heads/dev/dist/oh-my-opencode.schema.json",

  /**
   * [1] 知能カテゴリー (Categories)
   * モデルの実体とフォールバック、特性を一括管理します。
   */
  "categories": {
    // 【最上位知能】複雑な論理、設計、監査
    "ultrabrain": {
      "model": "${ULTRABRAIN_MODEL}",
      "fallback_models": [
        "openai/gpt-5.4-thinking",
        "anthropic/claude-sonnet-4-6",
        "opencode/big-pickle"
      ],
      "temperature": 0.2
    },
    // 【実装職人】高品質なコード生成、既存パターンの模倣
    "craftsman": {
      "model": "${CRAFTSMAN_MODEL}",
      "fallback_models": [
        "anthropic/claude-opus-4-6",
        "opencode/nemotron-3-super-free"
      ],
      "temperature": 0.1
    },
    // 【自律調査】大規模検索、並列探索、Agent Swarm
    "deep": {
      "model": "${DEEP_MODEL}",
      "fallback_models": [
        "opencode/mimo-v2-pro-free",
        "google/gemini-3.1-pro"
      ],
      "parallel": 5 // 並列エージェントの同時稼働数
    },
    // 【視覚・UI】マルチモーダル検証、デザイン確認
    "visual": {
      "model": "${VISUAL_MODEL}",
      "fallback_models": [
        "anthropic/claude-sonnet-4-6"
      ]
    },
    // 【高速定型】単純修正、テスト量産、タイポ修正
    "quick": {
      "model": "${QUICK_MODEL}",
      "fallback_models": [
        "opencode/mimo-v2-omni-free",
        "google/gemini-3.1-flash-lite"
      ],
      "temperature": 0.5
    }
  },

  /**
   * [2] 規律あるエージェント (Agents)
   * 11種類の専門家をカテゴリーにマッピングします。
   */
  "agents": {
    // 司令塔
    "sisyphus": { "category": "ultrabrain" },
    "prometheus": { "category": "ultrabrain" },
    "metis": { "category": "ultrabrain" },
    "momus": { "category": "ultrabrain" },

    // 実装
    "hephaestus": { "category": "craftsman" },
    "sisyphus-junior": { "category": "quick" },

    // リサーチ
    "oracle": { "category": "deep" },
    "librarian": { "category": "deep" },
    "explore": { "category": "deep" },
    "atlas": { "category": "deep" },

    // 視覚
    "multimodal-looker": { "category": "visual" }
  },

  /**
   * [3] 高度な機能設定 (Features)
   */
  "features": {
    // ハッシュベースの精密編集 (Hashline)
    "hashline_edit": {
      "enabled": true,
      "strict_verification": true
    },
    // 意図分析と自動ルーティング (Intent Gate)
    "intent_gate": {
      "enabled": true,
      "verbose": true,
      "routing_map": {
        "research": "deep",
        "implementation": "craftsman",
        "ui_design": "visual",
        "fix": "quick",
        "architecture": "ultrabrain"
      }
    },
    // 並列バックグラウンド実行
    "background_agent": {
      "enabled": true,
      "max_parallel": 5,
      "auto_start": true
    },
    // Tmux 統合
    "tmux": {
      "enabled": true,
      "layout": "main-vertical"
    }
  },

  "claude_code": {
    "use_standard_tools": true,
    "theme": "dark"
  }
}
