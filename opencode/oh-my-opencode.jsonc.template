// vim: ft=jsonc
{
  // Config Modernized: 2026-04-21
  // Based on oh-my-opencode v3.17.4

  // スキーマ定義：エディタでの補完とバリデーションを有効化
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/master/assets/oh-my-opencode.schema.json",

  // --------------------------------------------------------------------------
  // 1. Sisyphus Agent: オーケストレーションの中核
  // --------------------------------------------------------------------------
  "sisyphus_agent": {
    "disabled": false,                // Sisyphus自律オーケストレーションを有効化
    "planner_enabled": true,          // Prometheus (Planner) を有効化。タスク分解と並列戦略の要
    "replace_plan": true,             // 標準の計画エージェントを高度なプランナーに置き換え
    "default_builder_enabled": true   // 新規製造時にディレクトリ構造を自動構築するビルダーを有効化
  },

  // --------------------------------------------------------------------------
  // 2. Agents: 4大コア + 専門家エージェントの定義
  // --------------------------------------------------------------------------
  "agents": {
    // 【司令塔: Sisyphus】 全体の品質管理と最終意思決定
    "sisyphus": {
      // "model": "anthropic/claude-opus-4-7",
      "model": "openai/gpt-5.4",
      "ultrawork": {
        // "model": "anthropic/claude-opus-4-7", 
        "model": "openai/gpt-5.4",
        "variant": "max",
        "effort": "high" // 推論深度を最大化
      }
    },

    // 【戦略家: Prometheus】 並列タスク（Agent Swarm）の分解と割り当て
    "prometheus": {
      // "model": "minimax/m2-7",
      "model": "openai/gpt-5.4",
      "prompt_append": "Strategy: Maximize parallel backend file edits. Partition tasks to avoid merge conflicts."
    },

    // 【現場監督: Atlas】 環境管理・ツール操作・コンテキスト維持
    "atlas": {
      // "model": "google/gemini-3-1-pro",
      "model": "openai/gpt-5.4",
      "variant": "medium",
      "description": "Orchestrates Tmux, Playwright, and server states. Ensures environment consistency."
    },

    // 【製造担当: Hephaestus】 ロジックの実装、リファクタリング
    "hephaestus": {
      "model": "openai/gpt-5.4",
      "prompt_append": "Code: High-performance logic. Prioritize error handling, type safety, and modularity.",
      "permission": { 
        "edit": "allow", 
        "bash": { 
          "git": "allow",
          "test": "allow",
          "npm": "allow"
        } 
      }
    },

    // 【視覚アナリスト: Multimodal-Looker】 デザイン分析とUIデバッグ
    "multimodal-looker": {
      "model": "openai/gpt-5.4",
      "variant": "medium",
      "description": "Visual Intelligence. Analyzes UI designs for API generation and debugs browser test failures."
    },

    // 【高速プロトタイプ: Explore】 Big Pickle
    // 自律ウェブ検索を活用し、最新のAPI仕様に基づいた足場固めを爆速で実行
    "explore": {
      "model": "opencode/big-pickle",
      "description": "Rapid scaffolding using autonomous web search for latest technical specs."
    },

    // 【超高速補助: Librarian】 Nemotron 3 Super
    // $0.10/1M の低コストと MTP 技術により、バックグラウンドでの調査を「思考税」なしで実行
    "librarian": {
      "model": "nvidia/nemotron-3-super",
      "temperature": 0.1,
      "description": "Ultra-fast background research with minimal token cost."
    },

    // 【大規模解析・監査: Oracle】 MiniMax M2.7
    // 200K超のコンテキストで、大規模リポジトリの全容把握や膨大なログ解析を担当
    "oracle": {
      // "model": "open-code/big-pickle",
      "model": "opencode/big-pickle",
      "prompt_append": "Audit: Trace dependencies across the entire repository. Provide high-density, professional summaries."
    }
  },

  // --------------------------------------------------------------------------
  // 3. Categories: タスクの種類に応じたモデルの自動ルーティング
  // --------------------------------------------------------------------------
  "categories": {
    "ultrabrain": { 
      "model": "openai/gpt-5.4",
      "variant": "xhigh"
    }, // 難解なアルゴリズム・設計
    "deep": {
      "model": "opencode/big-pickle"
    },                     // 新規製造・プロトタイプ
    "quick": {

      "model": "opencode/nemotron-3-super-free"
    },                // 単純修正・型定義
    "writing": {
      "model": "opencode/minimax-m2.5-free"
    },                         // 仕様書・長文ドキュメント
    "unspecified-low": { 
      "model": "opencode/qwen3.6-plus-free"
    },        // 保守・補助タスク
    "visual-engineering": {
      "model": "openai/gpt-5.4"
    }             // デザインからのAPI生成
  },

  // --------------------------------------------------------------------------
  // 4. Experimental: 最新・実験的機能の最適化
  // --------------------------------------------------------------------------
  "experimental": {
    "task_system": true,                // セッションを跨いだタスク管理
    "hashline_edit": true,              // ハッシュ検証付きの安全なファイル編集 (v3.7.0+)
    "hashline_diff_enhancer": true,     // 編集差分の可視化強化
    "aggressive_truncation": true,      // コンテキスト溢れ防止
    "auto_resume": true,                // エラー時の自動リトライ
    "preemptive_compaction_threshold": 0.85 // 85%でコンテキスト圧縮を開始
  },

  // --------------------------------------------------------------------------
  // 5. Features: 外部ツール・連携機能
  // --------------------------------------------------------------------------

  // [Tmux] ターミナル多重化連携：エージェントの動きを別ペインでリアルタイム監視
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 65
  },

  // [Browser Automation] 軽量CLIプロバイダを使用してブラウザテストを実行
  "browser_automation_engine": {
    "provider": "playwright-cli"
  },

  // [Background Task] 並列実行のスループット制御
  "background_task": {
    "defaultConcurrency": 10,
    "providerConcurrency": {
      "openai": 5,                // 4大コア + Looker 用
      "nvidia": 10,               // 補助エージェントはフル回転
      "minimax": 5,
      "google": 20,
      "anthropic": 5
    }
  },

  // [Ralph Loop] 自律改善ループ：一度の指示で最大20回の修正・テストを繰り返す
  "ralph_loop": {
    "enabled": true,
    "default_max_iterations": 20
  },

  // [Boulder State] 作業状態の保存と再開
  "boulder_state": {
    "enabled": true,
    "storage_path": ".sisyphus/boulder_state.json"
  },

  // [Session Recovery] クラッシュ時等の会話復元
  "session_recovery": {
    "enabled": true,
    "max_age_minutes": 1440       // 24時間以内のセッションを復元
  },

  // [Interactive Bash] cd等の状態を保持する持続的シェル
  "interactive_bash": {
    "enabled": true,
    "timeout_ms": 300000
  },

  "git_master": {
    "commit_footer": false,
    "include_co_authored_by": false
  },

  "comment_checker": {
    "enabled": true               // AIによるコード品質の自動チェックを有効化
  },

  // --------------------------------------------------------------------------
  // 6. Security & Hooks: 挙動の微調整
  // --------------------------------------------------------------------------
  "disabled_hooks": [
    "auto-update-checker"         // 起動時の更新チェックを停止して初速を改善
  ],

  "rules_injector": {
    "enabled": true               // .cursorrules 等の自動読み込み
  },

  "auto_slash_command": {
    "enabled": true               // スラッシュなしでもコマンドを解釈
  },

  // [Custom Commands] 独自のショートカットコマンド
  "commands": {
    "git-pr-flow": {
      "description": "Git PR Flow with full-skill access",
      "prompt": "./commands/git-pr-flow.md",
      "skills": { "git-master": { "enabled": true } }
    },
    "build-skill": {
      "description": "Agent Skill Builder",
      "prompt": "./commands/build-skill.md",
      "skills": { "agent-skill-architect": { "enabled": true } }
    }
  }
}

