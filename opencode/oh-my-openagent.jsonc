{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/master/assets/oh-my-opencode.schema.json",
  "team_mode": {
    "enabled": false,
    "base_dir": ".sisyphus/team",
    "auto_sync": true
  },
  "sisyphus_agent": {
    "disabled": false,
    "planner_enabled": true,
    "replace_plan": true,
    "default_builder_enabled": true
  },
  "agents": {
    "sisyphus": {
      "model": "opencode/big-pickle",
      "fallback_models": [
        "openai/gpt-5.5"
      ],
      "ultrawork": {
        "model": "opencode/big-pickle",
        "fallback_models": [
          "openai/gpt-5.5"
        ],
        "variant": "max",
        "effort": "high"
      }
    },
    "hephaestus": {
      "model": "openai/gpt-5.5",
      "variant": "low",
      "permission": {
        "edit": "allow",
        "bash": {
          "git": "allow",
          "test": "allow",
          "npm": "allow"
        }
      }
    },
    "oracle": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        "nvidia/z-ai/glm4.7"
      ]
    },
    "librarian": {
      "model": "nvidia/minimaxai/minimax-m2.7",
      "fallback_models": [
        "opencode/minimax-m2.5-free"
      ],
      "description": "Ultra-fast background research with minimal token cost."
    },
    "explore": {
      "model": "nvidia/minimaxai/minimax-m2.7",
      "fallback_models": [
        "opencode/minimax-m2.5-free"
      ],
      "description": "Rapid scaffolding using autonomous web search for latest technical specs."
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.5",
      "fallback_models": [
        "nvidia/z-ai/glm4.7"
      ],
      "description": "Visual Intelligence. Analyzes UI designs for API generation and debugs browser test failures."
    },
    "prometheus": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        "nvidia/z-ai/glm4.7"
      ]
    },
    "metis": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        "nvidia/z-ai/glm4.7"
      ]
    },
    "momus": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        "nvidia/z-ai/glm4.7"
      ]
    },
    "atlas": {
      "model": "opencode/big-pickle",
      "fallback_models": [
        "nvidia/minimaxai/minimax-m2.7"
      ],
      "description": "Orchestrates Tmux, Playwright, and server states. Ensures environment consistency."
    }
  },
  "categories": {
    "ultrabrain": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [
        "nvidia/z-ai/glm4.7"
      ]
    },
    "deep": {
      "model": "openai/gpt-5.5"
    },
    "quick": {
      "model": "openai/gpt-5.4-mini",
      "fallback_models": [
        "nvidia/minimaxai/minimax-m2.7"
      ]
    },
    "writing": {
      "model": "opencode/minimax-m2.5-free"
    },
    "unspecified-low": {
      "model": "cloudflare-workers-ai/@cf/moonshotai/kimi-k2.6",
      "fallback_models": [
        "opencode/minimax-m2.5-free"
      ]
    },
    "unspecified-high": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        "opencode/big-pickle"
      ]
    },
    "visual-engineering": {
      "model": "nvidia/z-ai/glm4.7"
    },
    "artistry": {
      "model": "openai/gpt-5.5"
    }
  },
  "experimental": {
    "task_system": true,
    "hashline_diff_enhancer": true,
    "aggressive_truncation": true,
    "auto_resume": true,
    "preemptive_compaction_threshold": 0.85
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 65
  },
  "browser_automation_engine": {
    "provider": "playwright-cli"
  },
  "background_task": {
    "defaultConcurrency": 10,
    "providerConcurrency": {
      "openai": 5,
      "nvidia": 10,
      "minimax": 5,
      "google": 20,
      "opencode": 5
    }
  },
  "ralph_loop": {
    "enabled": true,
    "default_max_iterations": 20
  },
  "boulder_state": {
    "enabled": true,
    "storage_path": ".sisyphus/boulder_state.json"
  },
  "session_recovery": {
    "enabled": true,
    "max_age_minutes": 1440
  },
  "interactive_bash": {
    "enabled": true,
    "timeout_ms": 300000
  },
  "git_master": {
    "commit_footer": false,
    "include_co_authored_by": false
  },
  "comment_checker": {
    "enabled": true
  },
  "disabled_hooks": [
    "auto-update-checker"
  ],
  "rules_injector": {
    "enabled": true
  },
  "auto_slash_command": {
    "enabled": true
  },
  "commands": {
    "git-pr-flow": {
      "description": "Git PR Flow with full-skill access",
      "prompt": "./commands/git-pr-flow.md",
      "skills": {
        "git-master": {
          "enabled": true
        }
      }
    },
    "build-skill": {
      "description": "Agent Skill Builder",
      "prompt": "./commands/build-skill.md",
      "skills": {
        "agent-skill-architect": {
          "enabled": true
        }
      }
    }
  },
  "hashline_edit": true
}
