{
  "_comment": "Config Modernized: 2026-05-09, Target oh-my-openagent Version: v3.17.15",
  "_comment_schema": "スキーマ定義：エディタでの補完とバリデーションを有効化",
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/master/assets/oh-my-opencode.schema.json",
  "_comment_team_mode": "Team Mode: チーム開発・マルチエージェント連携 (v4.0.0 強化)\n【チーム開発の心臓部】\nv4.0.0 では、複数のバックグラウンドエージェントが同一プロジェクトで動作する際の「状態の不一致」を極限まで減らすための同期メカニズムが強化されました。\nエージェントたちが一つの Todo 計画を共有し、互いの作業を妨げずに並列走行するための設定です。",
  "team_mode": {
    "enabled": false,
    "_comment_base_dir": "エージェント間の共有データ、Todoリスト、作業進捗の永続化先",
    "base_dir": ".sisyphus/team",
    "_comment_auto_sync": "実行計画やタスク状態のリアルタイム同期。tmux ペイン間での情報共有を加速。",
    "auto_sync": true
  },
  "_comment_sisyphus_agent": "Sisyphus Agent: オーケストレーションの中核\nデフォルトのオーケストレーター。複雑なタスクの計画、委譲、実行を担当。\nサブエージェントを活用した積極的な並列実行と、Todo駆動型ワークフロー(Atlas統合)が特徴。",
  "sisyphus_agent": {
    "disabled": false,
    "_comment_planner_enabled": "Prometheus/Metis/Momus を使用した高度な計画立案を有効化",
    "planner_enabled": true,
    "_comment_replace_plan": "実行中に計画を動的に修正・更新することを許可",
    "replace_plan": true,
    "_comment_default_builder": "デフォルトのビルド/デプロイフローの有効化",
    "default_builder_enabled": true
  },
  "_comment_agents": "Agents: 4大コア + 専門家エージェントの定義",
  "agents": {
    "sisyphus": {
      "_comment": "--- Core Agents ---\n【司令塔: Sisyphus】 全体の品質管理と最終意思決定",
      // "category": "ultrabrain"
    },
    "hephaestus": {
      "_comment": "【製造担当: Hephaestus】 「正当な職人」。ロジックの実装、リファクタリング。\nAmpCode of the deep mode にインスパイアされ、徹底的な調査の後に一気に書き上げます。",
      // "category": "deep",
      "permission": {
        "edit": "allow",
        "bash": {
          "git": "allow",
          "test": "allow",
          "npm": "allow"
        }
      }
    },
    "oracle": {
      "_comment": "【大規模解析・監査: Oracle】 読み取り専用のコンサルタント。\nアーキテクチャ決定、深い論理的推論、コードレビュー、難解なバグのデバッグを担当。",
      // "category": "ultrabrain"
    },
    "librarian": {
      "_comment": "【超高速補助: Librarian】 証拠に基づいた調査の専門家。\nマルチリポジトリ分析、ドキュメント検索、OSS実装例の調査を低コスト・高精度で行います。\nv4.0.0 でプロンプトが刷新され、GitHubパーマリンクの発見能力が向上。",
      // "category": "quick",
      "description": "Ultra-fast background research with minimal token cost."
    },
    "explore": {
      "_comment": "【高速探索: Explore】 高速なコードベース探索とプロトタイピング。\n自律的なweb searchを組み合わせ、最新の技術仕様に基づいたスキャフォールディングを行います。",
      // "category": "quick",
      "description": "Rapid scaffolding using autonomous web search for latest technical specs."
    },
    "multimodal-looker": {
      "_comment": "【視覚アナリスト: Multimodal-Looker】 視覚コンテンツ・UI分析。\nPDF、画像、図解、UIデザインを分析。ブラウザテストの失敗時のUIデバッグにも威力を発揮。",
      // "category": "ultrabrain",
      "description": "Visual Intelligence. Analyzes UI designs for API generation and debugs browser test failures."
    },
    "prometheus": {
      "_comment": "--- Planning Agents ---\n【戦略家: Prometheus】 インタビューモードを備えたプランナー。\n対話を通じてタスクを分解し、並列実行可能な「Agent Swarm」用の作業計画を作成します。",
      // "category": "ultrabrain"
    },
    "metis": {
      "_comment": "【計画コンサル: Metis】 計画前の分析とリスク特定。\n隠れた意図や曖昧さ、AIが失敗しやすいポイントを事前に特定し、計画の精度を高めます。\nv4.0.0 では意図の自動分類機能が大幅に強化されています。",
      // "category": "ultrabrain"
    },
    "momus": {
      "_comment": "【計画レビュアー: Momus】 計画の検証と品質保証。\n明確さ、検証可能性、完全性の基準に照らして、Prometheusが作成した計画を厳格にレビュー。",
      // "category": "ultrabrain"
    },
    "atlas": {
      "_comment": "--- Orchestration Agents ---\n【現場監督: Atlas】 Todo駆動型実行エンジン。\nTmux, Playwrightなどの環境管理、Todo項目の体系的な管理・調整・維持を担当。",
      // "category": "ultrabrain",
      "description": "Orchestrates Tmux, Playwright, and server states. Ensures environment consistency."
    }
  },
  "_comment_experimental": "Experimental: 最新・実験的機能の最適化",
  "experimental": {
    "_comment_task_system": "Todo駆動タスク管理(blockedBy対応)。 .sisyphus/tasks/ に永続化",
    "task_system": true,
    "_comment_hashline_edit": "LINE#ID形式のハッシュアンカー編集。行ずれエラーをゼロに",
    "hashline_diff_enhancer": true,
    "aggressive_truncation": true,
    "_comment_auto_resume": "セッション中断・失敗からの自動復旧",
    "auto_resume": true,
    "_comment_compaction": "トークン限界前のプロアクティブな圧縮 (85% で発動)",
    "preemptive_compaction_threshold": 0.85
  },
  "_comment_tmux": "TMUX統合: バックグラウンドエージェントを別ペインでリアルタイム監視",
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 65
  },
  "_comment_browser": "ブラウザ自動化エンジン: スクリーンショット、フォーム入力、ネットワーク監視をサポート",
  "browser_automation_engine": {
    "_comment_provider": "デフォルト: playwright-cli",
    "provider": "playwright-cli"
  },
  "_comment_background_task": "バックグラウンドタスクの並列実行制御",
  "background_task": {
    "defaultConcurrency": 10,
    "providerConcurrency": {
      "openai": 5,
      "nvidia": 10,
      "minimax": 5,
      "google": 20,
      "opencode": 5,
      "sakura": 5
    }
  },
  "_comment_ralph_loop": "Ralph Loop: タスク完了まで自律的に試行を繰り返す自己参照型開発ループ。\nv4.0.0 で実行時エラーのガードとリトライ戦略が強化。",
  "ralph_loop": {
    "enabled": true,
    "default_max_iterations": 20
  },
  "_comment_boulder_state": "Boulder State: セッションを跨いでエージェントの状態を維持する永続化機構",
  "boulder_state": {
    "enabled": true,
    "storage_path": ".sisyphus/boulder_state.json"
  },
  "_comment_session_recovery": "セッションリカバリ: エラーやコンテキスト上限からの透明な復旧",
  "session_recovery": {
    "enabled": true,
    "max_age_minutes": 1440
  },
  "_comment_interactive_bash": "Interactive Bash: tmuxベースの永続ターミナル(vim/htopなどのTUI対応)",
  "interactive_bash": {
    "enabled": true,
    "timeout_ms": 300000
  },
  "_comment_git_master": "Git Master: コミット分割、スタイル自動検出を行うGit専門機能",
  "git_master": {
    "commit_footer": false,
    "include_co_authored_by": false
  },
  "_comment_comment_checker": "過剰なコメントを削減・整理する提案機能",
  "comment_checker": {
    "enabled": true
  },
  "disabled_hooks": [
    "auto-update-checker"
  ],
  "_comment_rules_injector": "Rules Injector: .claude/rules/ 内のルールをglob条件で自動注入",
  "rules_injector": {
    "enabled": true
  },
  "_comment_auto_slash": "Auto Slash Command: プロンプトからのスラッシュコマンド自動実行",
  "auto_slash_command": {
    "enabled": true
  },
  "commands": {
    "git-pr-flow": {
      "description": "Git PR Flow with full-skill access",
      "prompt": "./commands/git-pr-flow.md",
      "skills": {
        "git-master": {
          "enabled": true
        }
      }
    },
    "build-skill": {
      "description": "Agent Skill Builder",
      "prompt": "./commands/build-skill.md",
      "skills": {
        "agent-skill-architect": {
          "enabled": true
        }
      }
    }
  },
  "hashline_edit": true
}
