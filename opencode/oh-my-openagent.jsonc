// vim: ft=jsonc
// Config Modernized: 2026-05-09
// Target oh-my-openagent Version: v3.17.15

/**
 * OhMyOpenagent Core Configuration
 */
{
  // スキーマ定義：エディタでの補完とバリデーションを有効化
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/master/assets/oh-my-opencode.schema.json",

  // --------------------------------------------------------------------------
  // 0. Team Mode: チーム開発・マルチエージェント連携 (v4.0.0 強化)
  // --------------------------------------------------------------------------
  // 【チーム開発の心臓部】
  // v4.0.0 では、複数のバックグラウンドエージェントが同一プロジェクトで動作する際の
  // 「状態の不一致」を極限まで減らすための同期メカニズムが強化されました。
  // エージェントたちが一つの Todo 計画を共有し、互いの作業を妨げずに並列走行するための設定です。
  "team_mode": {
    "enabled": false,
    "base_dir": ".sisyphus/team", // エージェント間の共有データ、Todoリスト、作業進捗の永続化先
    "auto_sync": true            // 実行計画やタスク状態のリアルタイム同期。tmux ペイン間での情報共有を加速。
  },

  // --------------------------------------------------------------------------
  // 1. Sisyphus Agent: オーケストレーションの中核
  // --------------------------------------------------------------------------
  "sisyphus_agent": {
    // デフォルトのオーケストレーター。複雑なタスクの計画、委譲、実行を担当。
    // サブエージェントを活用した積極的な並列実行と、Todo駆動型ワークフロー(Atlas統合)が特徴。
    "disabled": false,
    "planner_enabled": true, // Prometheus/Metis/Momus を使用した高度な計画立案を有効化
    "replace_plan": true,    // 実行中に計画を動的に修正・更新することを許可
    "default_builder_enabled": true // デフォルトのビルド/デプロイフローの有効化
  },

  // --------------------------------------------------------------------------
  // 2. Agents: 4大コア + 専門家エージェントの定義
  // --------------------------------------------------------------------------
  "agents": {
    // --- Core Agents ---

    // 【司令塔: Sisyphus】 全体の品質管理と最終意思決定
    "sisyphus": {
      "model": "opencode/big-pickle",
      "fallback_models": [
        "openai/gpt-5.5"
      ],
      "ultrawork": {
        // Ultrawork: 長時間自律駆動モード。リファクタリングや巨大なログ解析など、
        "model": "opencode/big-pickle",
        "fallback_models": [
          "openai/gpt-5.5"
        ],
        "variant": "max",
        "effort": "high"
      }
    },

    // 【製造担当: Hephaestus】 「正当な職人」。ロジックの実装、リファクタリング
    // AmpCodeのディープモードにインスパイアされ、徹底的な調査の後に一気に書き上げます。
    "hephaestus": {
      "model": "openai/gpt-5.5",
      "variant": "low",
      "permission": {
        "edit": "allow",
        "bash": {
          "git": "allow",
          "test": "allow",
          "npm": "allow"
        }
      }
    },

    // 【大規模解析・監査: Oracle】 読み取り専用のコンサルタント
    // アーキテクチャ決定、深い論理的推論、コードレビュー、難解なバグのデバッグを担当。
    // 論理推論の頂点である gpt-5.5 を採用。
    "oracle": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        // "google/gemini-3.1-pro-preview"
        "nvidia/z-ai/glm4.7"
      ]
    },

    // 【超高速補助: Librarian】 証拠に基づいた調査の専門家
    // マルチリポジトリ分析、ドキュメント検索、OSS実装例の調査を低コスト・高精度で行います。
    // v4.0.0 でプロンプトが刷新され、GitHubパーマリンクの発見能力が向上。
    "librarian": {
      "model": "nvidia/minimaxai/minimax-m2.7",
      "fallback_models": [
        "opencode/minimax-m2.5-free",
      ],
      "description": "Ultra-fast background research with minimal token cost."
    },

    // 【高速探索: Explore】 高速なコードベース探索とプロトタイピング
    // 自律的なweb searchを組み合わせ、最新の技術仕様に基づいたスキャフォールディングを行います。
    "explore": {
      "model": "nvidia/minimaxai/minimax-m2.7",
      "fallback_models": [
        "opencode/minimax-m2.5-free",
      ],
      "description": "Rapid scaffolding using autonomous web search for latest technical specs."
    },

    // 【視覚アナリスト: Multimodal-Looker】 視覚コンテンツ・UI分析
    // PDF、画像、図解、UIデザインを分析。ブラウザテストの失敗時のUIデバッグにも威力を発揮。
    "multimodal-looker": {
      "model": "openai/gpt-5.5",
      "fallback_models": [
        "nvidia/z-ai/glm4.7"
      ],
      "description": "Visual Intelligence. Analyzes UI designs for API generation and debugs browser test failures."
    },

    // --- Planning Agents ---

    // 【戦略家: Prometheus】 インタビューモードを備えたプランナー
    // 対話を通じてタスクを分解し、並列実行可能な「Agent Swarm」用の作業計画を作成します。
    "prometheus": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        "nvidia/z-ai/glm4.7",
      ]
    },

    // 【計画コンサル: Metis】 計画前の分析とリスク特定
    // 隠れた意図や曖昧さ、AIが失敗しやすいポイントを事前に特定し、計画の精度を高めます。
    // v4.0.0 では意図の自動分類機能が大幅に強化されています。
    "metis": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        "nvidia/z-ai/glm4.7"
      ]
    },

    // 【計画レビュアー: Momus】 計画の検証と品質保証
    // 明確さ、検証可能性、完全性の基準に照らして、Prometheusが作成した計画を厳格にレビュー。
    "momus": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        "nvidia/z-ai/glm4.7"
      ]
    },

    // --- Orchestration Agents ---

    // 【現場監督: Atlas】 Todo駆動型実行エンジン
    // Tmux, Playwrightなどの環境管理、Todo項目の体系的な管理・調整・維持を担当。
    "atlas": {
      "model": "opencode/big-pickle",
      "fallback_models": [
        "nvidia/minimaxai/minimax-m2.7",
      ],
      "description": "Orchestrates Tmux, Playwright, and server states. Ensures environment consistency."
    }
  },

  // --------------------------------------------------------------------------
  // 3. Categories: タスクの性質に応じたモデルの自動ルーティング
  // --------------------------------------------------------------------------
  "categories": {
    "ultrabrain": {
      "model": "openai/gpt-5.5", // 最強の論理推論 (xhigh)
      "variant": "xhigh",
      "fallback_models": [
        "nvidia/z-ai/glm4.7"
      ]
    },
    "deep": {
      "model": "openai/gpt-5.5" // 自律的解決・難解なタスク
    },
    "quick": {
      "model": "openai/gpt-5.5-mini", // 些細な修正・高速レスポンス
      "fallback_models": [
        "nvidia/minimaxai/minimax-m2.7"
      ]
    },
    "writing": {
      "model": "opencode/minimax-m2.5-free" // テクニカルライティング・散文
    },
    "unspecified-low": {
      "model": "cloudflare-workers-ai/@cf/moonshotai/kimi-k2.6",
      "fallback_models": [
        "opencode/minimax-m2.5-free"
      ]
    },
    "unspecified-high": {
      "model": "openai/gpt-5.5", // 自律的解決・難解なタスク
      "variant": "high",
      "fallback_models": [
        "opencode/big-pickle",
      ]
    },
    "visual-engineering": {
      "model": "nvidia/z-ai/glm4.7" // UI/UX, デザイン, アニメーション
    },
    "artistry": {
      "model": "openai/gpt-5.5",
    }
    
  },

  // --------------------------------------------------------------------------
  // 4. Experimental: 最新・実験的機能の最適化
  // --------------------------------------------------------------------------
  "experimental": {
    "task_system": true, // Todo駆動タスク管理(blockedBy対応)。 .sisyphus/tasks/ に永続化
    "hashline_edit": true, // LINE#ID形式のハッシュアンカー編集。行ずれエラーをゼロに
    "hashline_diff_enhancer": true,
    "aggressive_truncation": true,
    "auto_resume": true, // セッション中断・失敗からの自動復旧
    "preemptive_compaction_threshold": 0.85 // トークン限界前のプロアクティブな圧縮
  },

  // TMUX統合: バックグラウンドエージェントを別ペインでリアルタイム監視
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 65
  },

  // ブラウザ自動化エンジン: スクリーンショット、フォーム入力、ネットワーク監視をサポート
  "browser_automation_engine": {
    "provider": "playwright-cli" // デフォルト: playwright
  },

  // バックグラウンドタスクの並列実行制御
  "background_task": {
    "defaultConcurrency": 10,
    "providerConcurrency": {
      "openai": 5,
      "nvidia": 10,
      "minimax": 5,
      "google": 20,
      "opencode": 5
    }
  },

  // Ralph Loop: タスク完了まで自律的に試行を繰り返す自己参照型開発ループ
  "ralph_loop": {
    "enabled": true,
    "default_max_iterations": 20 // v4.0.0 で実行時エラーのガードとリトライ戦略が強化
  },

  // Boulder State: セッションを跨いでエージェントの状態を維持する永続化機構
  "boulder_state": {
    "enabled": true,
    "storage_path": ".sisyphus/boulder_state.json"
  },

  // セッションリカバリ: エラーやコンテキスト上限からの透明な復旧
  "session_recovery": {
    "enabled": true,
    "max_age_minutes": 1440
  },

  // Interactive Bash: tmuxベースの永続ターミナル(vim/htopなどのTUI対応)
  "interactive_bash": {
    "enabled": true,
    "timeout_ms": 300000
  },

  // Git Master: コミット分割、スタイル自動検出を行うGit専門機能
  "git_master": {
    "commit_footer": false,
    "include_co_authored_by": false
  },

  // 過剰なコメントを削減・整理する提案機能
  "comment_checker": {
    "enabled": true
  },

  "disabled_hooks": [
    "auto-update-checker"
  ],

  // Rules Injector: .claude/rules/ 内のルールをglob条件で自動注入
  "rules_injector": {
    "enabled": true
  },

  // Auto Slash Command: プロンプトからのスラッシュコマンド自動実行
  "auto_slash_command": {
    "enabled": true
  },

  "commands": {
    "git-pr-flow": {
      "description": "Git PR Flow with full-skill access",
      "prompt": "./commands/git-pr-flow.md",
      "skills": {
        "git-master": {
          "enabled": true
        }
      }
    },
    "build-skill": {
      "description": "Agent Skill Builder",
      "prompt": "./commands/build-skill.md",
      "skills": {
        "agent-skill-architect": {
          "enabled": true
        }
      }
    }
  }
}
