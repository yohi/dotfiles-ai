// vim: ft=jsonc
{
  // Config Modernized: 2026-04-22
  // Based on oh-my-opencode v3.17.4

  // スキーマ定義：エディタでの補完とバリデーションを有効化
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/master/assets/oh-my-opencode.schema.json",

  // --------------------------------------------------------------------------
  // 1. Sisyphus Agent: オーケストレーションの中核
  // --------------------------------------------------------------------------
  "sisyphus_agent": {
    "disabled": false,
    "planner_enabled": true,
    "replace_plan": true,
    "default_builder_enabled": true
  },

  // --------------------------------------------------------------------------
  // 2. Agents: 4大コア + 専門家エージェントの定義
  // --------------------------------------------------------------------------
  "agents": {
    // 【司令塔: Sisyphus】 全体の品質管理と最終意思決定
    "sisyphus": {
      "model": "opencode/kimi-k2.5-free",
      "fallback_models": [
        "nvidia/z-ai/glm-5.1"
      ],
      "ultrawork": {
        // Ultrawork: 長時間自律駆動。リファクタリングやログ解析など、
        // 巨大なコンテキストを読み込む重労働。Kimiের圧倒的な文脈窓を活用します。
        "model": "opencode/kimi-k2.5-free",
        "fallback_models": [
          "nvidia/z-ai/glm-5.1"
        ],
        "variant": "max",
        "effort": "high"
      }
    },

    "momus": {
      "model": "nvidia/minimaxai/minimax-m2.7"
    },

    // 【戦略家: Prometheus】 並列タスク（Agent Swarm）の分解と割り当て
    "prometheus": {
      "model": "opencode/kimi-k2.5-free",
      "fallback_models": [
        "nvidia/z-ai/glm-5.1"
      ],
      "prompt_append": "Strategy: Maximize parallel backend file edits. Partition tasks to avoid merge conflicts."
    },

    // 【現場監督: Atlas】 環境管理・ツール操作・コンテキスト維持
    "atlas": {
      "model": "openai/gpt-5.4",
      "variant": "medium",
      "description": "Orchestrates Tmux, Playwright, and server states. Ensures environment consistency."
    },

    // 【製造担当: Hephaestus】 ロジックの実装、リファクタリング
    "hephaestus": {
      "model": "openai/gpt-5.3-codex",
      "prompt_append": "Code: High-performance logic. Prioritize error handling, type safety, and modularity.",
      "permission": {
        "edit": "allow",
        "bash": {
          "git": "allow",
          "test": "allow",
          "npm": "allow"
        }
      }
    },

    // 【視覚アナリスト: Multimodal-Looker】 デザイン分析とUIデバッグ
    "multimodal-looker": {
      "model": "openai/gpt-5.4",
      "fallback_models": [
        "openai/gpt-5.4-mini"
      ],
      "variant": "medium",
      "description": "Visual Intelligence. Analyzes UI designs for API generation and debugs browser test failures."
    },

    // 【高速プロトタイプ: Explore】 Big Pickle
    "explore": {
      "model": "opencode/big-pickle",
      "fallback_models": [
        "openai/gpt-5.4-mini"
      ],
      "description": "Rapid scaffolding using autonomous web search for latest technical specs."
    },

    // 【超高速補助: Librarian】 Nemotron 3 Super
    "librarian": {
      "model": "opencode/nemotron-3-super-free",
      "fallback_models": [
        "openai/gpt-5.4-mini"
      ],
      "temperature": 0.1,
      "description": "Ultra-fast background research with minimal token cost."
    },

    // 【大規模解析・監査: Oracle】
    "oracle": {
      "model": "opencode/big-pickle",
      "fallback_models": [
        "opencode/minimax-m2.5-free"
      ],
      "prompt_append": "Audit: Trace dependencies across the entire repository. Provide high-density, professional summaries."
    }
  },

  // --------------------------------------------------------------------------
  // 3. Categories: タスクの種類に応じたモデルの自動ルーティング
  // --------------------------------------------------------------------------
  "categories": {
    "ultrabrain": {
      "model": "openai/gpt-5.4",
      "variant": "xhigh"
    },
    "deep": {
      "model": "nvidia/minimaxai/minimax-m2.7"
    },
    "quick": {
      "model": "opencode/ling-2.6-flash-free"
    },
    "writing": {
      "model": "nvidia/z-ai/glm-5.1"
    },
    "unspecified-low": {
      "model": "opencode/minimax-m2.5-free"
    },
    "visual-engineering": {
      "model": "openai/gpt-5.4-mini"
    }
  },

  // --------------------------------------------------------------------------
  // 4. Experimental: 最新・実験的機能の最適化
  // --------------------------------------------------------------------------
  "experimental": {
    "task_system": true,
    "hashline_edit": true,
    "hashline_diff_enhancer": true,
    "aggressive_truncation": true,
    "auto_resume": true,
    "preemptive_compaction_threshold": 0.85
  },

  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 65
  },

  "browser_automation_engine": {
    "provider": "playwright-cli"
  },

  "background_task": {
    "defaultConcurrency": 10,
    "providerConcurrency": {
      "openai": 5,
      "nvidia": 10,
      "minimax": 5,
      "google": 20,
      "anthropic": 5
    }
  },

  "ralph_loop": {
    "enabled": true,
    "default_max_iterations": 20
  },

  "boulder_state": {
    "enabled": true,
    "storage_path": ".sisyphus/boulder_state.json"
  },

  "session_recovery": {
    "enabled": true,
    "max_age_minutes": 1440
  },

  "interactive_bash": {
    "enabled": true,
    "timeout_ms": 300000
  },

  "git_master": {
    "commit_footer": false,
    "include_co_authored_by": false
  },

  "comment_checker": {
    "enabled": true
  },

  "disabled_hooks": [
    "auto-update-checker"
  ],

  "rules_injector": {
    "enabled": true
  },

  "auto_slash_command": {
    "enabled": true
  },

  "commands": {
    "git-pr-flow": {
      "description": "Git PR Flow with full-skill access",
      "prompt": "./commands/git-pr-flow.md",
      "skills": {
        "git-master": {
          "enabled": true
        }
      }
    },
    "build-skill": {
      "description": "Agent Skill Builder",
      "prompt": "./commands/build-skill.md",
      "skills": {
        "agent-skill-architect": {
          "enabled": true
        }
      }
    }
  }
}
