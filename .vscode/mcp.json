{
  "servers": {
    "docker-mcp": {
      "type": "sse",
      "url": "http://127.0.0.1:10888/sse",
      "headers": {
        "Authorization": "Bearer ${MCP_GATEWAY_TOKEN:-}"
      }
    },
    "chronos-graph": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/yohi/chronos-graph.git",
        "context-store"
      ],
      "env": {
        "OPENAI_API_KEY": "${OPENAI_API_KEY:-YOUR_API_KEY_HERE}",
        "LOG_LEVEL": "error",
        "STORAGE_BACKEND": "sqlite",
        "SQLITE_DB_PATH": "__HOME__/.context-store/memories.db",
        "GRAPH_ENABLED": "true",
        "DECAY_HALF_LIFE_DAYS": "30",
        "SIMILARITY_THRESHOLD": "0.70",
        "DEDUP_THRESHOLD": "0.90",
        "EMBEDDING_PROVIDER": "local-model",
        "LOCAL_MODEL_NAME": "cl-nagoya/ruri-v3-310m"
      }
    },
    "nexus": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "-p",
        "@yohi/nexus@latest",
        "-p",
        "typescript",
        "nexus"
      ],
      "env": {
        "NEXUS_STORAGE_ROOT_DIR": "__HOME__/.nexus",
        "NEXUS_WATCHER_IGNORE_PATHS": "node_modules,.git,.nexus,dist,gemini,.worktrees,.venv,target,.mypy_cache,.ruff_cache,build,.serena,.cache,__pycache__,*.db,*.sqlite,*.log,out,bundle,vendor,package-lock.json,yarn.lock,pnpm-lock.yaml",
        "CHOKIDAR_USEPOLLING": "false",
        "CHOKIDAR_INTERVAL": "2000",
        "NO_PROXY": "127.0.0.1,localhost"
      }
    },
    "skillport": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "skillport-mcp"
      ],
      "env": {
        "SKILLPORT_SKILLS_DIR": "__REPO_ROOT__/agent-skills"
      }
    },
    "atlassian": {
      "type": "sse",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "headers": {}
    }
  },
  "inputs": []
}