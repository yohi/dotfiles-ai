[Unit]
Description=Docker MCP Gateway
After=network.target docker.service

[Service]
Environment="PATH=/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin"
Type=simple
WorkingDirectory=__REPO_ROOT__
EnvironmentFile=__REPO_ROOT__/.env
ExecStartPre=/usr/bin/env bash _scripts/sync-mcp-configs.sh
ExecStart=/usr/bin/env docker mcp gateway run \
  --transport sse \
  --port 10888 \
  --config %h/.docker/mcp/config.yaml \
  --catalog %h/.docker/mcp/catalogs/bootstrap.yaml \
  --catalog %h/.docker/mcp/catalogs/custom.yaml \
  # chronos-graph is excluded here because it runs locally via 'uv' on each client.
  --servers __ENABLED_SERVERS__ \
  --secrets __REPO_ROOT__/.env
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
