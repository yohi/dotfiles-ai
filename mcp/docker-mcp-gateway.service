[Unit]
Description=Docker MCP Gateway
After=network.target docker.service

[Service]
Type=simple
WorkingDirectory=__REPO_ROOT__
EnvironmentFile=__REPO_ROOT__/.env
ExecStartPre=/usr/bin/env make mcp-render
ExecStart=/usr/bin/env docker mcp gateway run \
  --transport sse \
  --port 10888 \
  --servers SQLite,filesystem,sequentialthinking,skillport \
  --use-configured-catalogs \
  --catalog %h/.docker/mcp/catalogs/docker-mcp.yaml \
  --catalog %h/.docker/mcp/catalogs/bootstrap.yaml \
  --catalog %h/.docker/mcp/catalogs/custom.yaml \
  --secrets __REPO_ROOT__/.env \
  --watch=false

RestartSec=5

[Install]
WantedBy=default.target
