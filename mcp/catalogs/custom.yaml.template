version: 3
name: custom
displayName: Custom Servers
registry:
  SQLite:
    description: SQLite database access.
    title: SQLite
    type: server
    image: ghcr.io/yohi/mcp-sqlite:latest
    volumes:
      - "__HOME__/.mcp/sqlite:/mcp"
  filesystem:
    description: Local filesystem access.
    title: Filesystem
    type: server
    image: ghcr.io/yohi/mcp-filesystem:latest
    volumes:
      - "__HOME__:/home/y_ohi"
      - "__REPO_ROOT__:__REPO_ROOT__"
  github-official:
    description: Official GitHub MCP server.
    title: GitHub
    type: server
    image: mcp/github:latest
    env:
      - name: GITHUB_PERSONAL_ACCESS_TOKEN
        value: "${GITHUB_TOKEN}"
  sequentialthinking:
    description: Sequential thinking and problem solving.
    title: Sequential Thinking
    type: server
    image: mcp/sequentialthinking:latest
  skillport:
    description: Professional development and AI skill management.
    title: Skillport
    type: server
    image: ghcr.io/yohi/skillport:latest
    env:
      - name: SKILLPORT_SKILLS_DIR
        value: "__REPO_ROOT__/agent-skills"
      - name: SKILLS_DIR
        value: "__REPO_ROOT__/agent-skills"
      - name: SKILLPORT_DB_PATH
        value: "/mcp/db"
      - name: DB_PATH
        value: "/mcp/db"
    volumes:
      - "__HOME__/.skillport/db:/mcp/db"
      - "__HOME__/.skillport:__HOME__/.skillport"
      - "__REPO_ROOT__:__REPO_ROOT__:ro"
