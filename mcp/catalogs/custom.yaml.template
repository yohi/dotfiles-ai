version: 3
name: custom
displayName: Custom Servers
registry:
  skillport:
    description: Professional development and AI skill management.
    title: Skillport
    type: server
    image: ghcr.io/astral-sh/uv:python3.11-alpine
    command:
      - uvx
      - --from
      - skillport-mcp
      - skillport-mcp
    env:
      - name: SKILLPORT_SKILLS_DIR
        value: __HOME__/.skillport/skills
  magic:
    description: Magic MCP server.
    title: Magic
    type: server
    image: mcp/magic
  morphllm-fast-apply:
    description: Morph LLM Fast Apply MCP server.
    title: Morph LLM
    type: server
    image: mcp/morphllm-fast-apply
  serena:
    description: Serena MCP server.
    title: Serena
    type: server
    image: mcp/serena
  chrome-devtools:
    description: Chrome DevTools MCP server.
    title: Chrome DevTools
    type: server
    image: mcp/chrome-devtools
