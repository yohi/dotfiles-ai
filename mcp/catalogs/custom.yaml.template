version: 3
name: custom
displayName: Custom Servers
registry:
  SQLite:
    description: Database interaction and business intelligence capabilities.
    title: SQLite
    type: server
    image: mcp/sqlite@sha256:efbc05ccace18df122f26b674bd1730c76ece716551df2b3961d519909c34696
    tools:
      - name: append_insight
      - name: create_table
      - name: describe_table
      - name: list_tables
      - name: read_query
      - name: write_query
    command:
      - --db-path
      - /mcp/db.sqlite
    volumes:
      - mcp-sqlite:/mcp
  skillport:
    description: Professional development and AI skill management.
    title: Skillport
    type: server
    image: ghcr.io/yohi/skillport:latest
    tools:
      - name: search_skills
      - name: load_skill
    command:
      - --skip-auto-reindex
    env:
      - name: SKILLPORT_SKILLS_DIR
        value: __HOME__/.skillport/skills
      - name: SKILLPORT_DB_PATH
        value: __HOME__/.skillport/db
    volumes:
      - __HOME__/.skillport:__HOME__/.skillport
  playwright:
    description: Web browser automation and testing.
    title: Playwright
    type: server
    image: mcp/playwright
  github-official:
    description: Official GitHub MCP server.
    title: GitHub
    type: server
    image: mcp/github
  sequentialthinking:
    description: Dynamic and reflective problem-solving through thought sequences.
    title: Sequential Thinking
    type: server
    image: mcp/sequentialthinking@sha256:cd3174b2ecf37738654cf7671fb1b719a225c40a78274817da00c4241f465e5f
    tools:
      - name: sequentialthinking
  filesystem:
    description: Local filesystem access with configurable allowed paths.
    title: Filesystem
    type: server
    image: mcp/filesystem@sha256:35fcf0217ca0d5bf7b0a5bd68fb3b89e08174676c0e0b4f431604512cf7b3f67
    command:
      - __HOME__/dotfiles/components/dotfiles-ai
      - __HOME__
    volumes:
      - __HOME__/dotfiles/components/dotfiles-ai:__HOME__/dotfiles/components/dotfiles-ai
      - __HOME__:__HOME__
  tavily:
    description: Tavily search MCP server.
    title: Tavily
    type: server
    image: mcp/tavily
  magic:
    description: Magic MCP server.
    title: Magic
    type: server
    image: mcp/magic
  morphllm-fast-apply:
    description: Morph LLM Fast Apply MCP server.
    title: Morph LLM
    type: server
    image: mcp/morphllm-fast-apply
  serena:
    description: Serena MCP server.
    title: Serena
    type: server
    image: mcp/serena
  chrome-devtools:
    description: Chrome DevTools MCP server.
    title: Chrome DevTools
    type: server
    image: mcp/chrome-devtools
