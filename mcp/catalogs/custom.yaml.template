version: 3
name: custom
displayName: Custom Servers
registry:
  chronos-graph:
    title: "ChronosGraph"
    description: "Long-term memory and knowledge graph system."
    type: local
    command:
      - uv
      - run
      - --project
      - "__HOME__/program/chronos-graph"
      - -m
      - context_store
    env:
      - name: STORAGE_BACKEND
        value: "sqlite"
      - name: SQLITE_DB_PATH
        value: "__HOME__/.context-store/memories.db"
      - name: GRAPH_ENABLED
        value: "true"
      - name: DECAY_HALF_LIFE_DAYS
        value: "30"
      - name: SIMILARITY_THRESHOLD
        value: "0.70"
      - name: DEDUP_THRESHOLD
        value: "0.90"
      - name: EMBEDDING_PROVIDER
        value: "local-model"
      - name: LOCAL_MODEL_NAME
        value: "cl-nagoya/ruri-v3-310m"
  nexus:
    title: "Nexus"
    description: "Local knowledge base and indexer."
    type: local
    command:
      - node
      - "__HOME__/program/nexus/dist/bin/nexus.js"
    env:
      - name: NEXUS_STORAGE_ROOT_DIR
        value: "__HOME__/program/nexus/.nexus"
      - name: NEXUS_WATCHER_IGNORE_PATHS
        value: "node_modules,.git,.nexus,dist,gemini,.worktrees,.venv,target,.mypy_cache,.ruff_cache,build,.serena,.cache,__pycache__,*.db,*.sqlite,*.log"
      - name: CHOKIDAR_USEPOLLING
        value: "false"
      - name: CHOKIDAR_INTERVAL
        value: "2000"
      - name: NO_PROXY
        value: "127.0.0.1,localhost"
