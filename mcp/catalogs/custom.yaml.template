version: 3
name: custom
displayName: Custom Servers
registry:
  skillport:
    description: Professional development and AI skill management.
    title: Skillport
    type: server
    image: ghcr.io/yohi/skillport:latest
    env:
      - name: SKILLPORT_SKILLS_DIR
        value: "__REPO_ROOT__/agent-skills"
      - name: SKILLS_DIR
        value: "__REPO_ROOT__/agent-skills"
      - name: SKILLPORT_DB_PATH
        value: "/mcp/db"
      - name: DB_PATH
        value: "/mcp/db"
    volumes:
      - "__HOME__/.skillport/db:/mcp/db"
      - "__HOME__/.skillport:__HOME__/.skillport"
      - "__REPO_ROOT__:__REPO_ROOT__:ro"
