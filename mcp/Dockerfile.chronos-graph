FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends gosu git && rm -rf /var/lib/apt/lists/*
RUN groupadd -r -g 1000 chronos && useradd -r -u 1000 -g 1000 -m chronos
RUN uv pip install --system git+https://github.com/yohi/chronos-graph.git@v0.1.0
USER chronos
ENTRYPOINT ["context-store"]
