FROM node:22-slim
RUN apt-get update && apt-get install -y --no-install-recommends gosu git ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN git clone https://github.com/yohi/nexus.git .
RUN npm install
RUN npm run build
RUN npm link
RUN usermod -l nexus node && groupmod -n nexus node
RUN chown -R nexus:nexus /app
USER nexus
ENTRYPOINT ["nexus"]
