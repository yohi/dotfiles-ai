{
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "privacy": {
    "usageStatisticsEnabled": false
  },
  "mcpServers": {
    "docker-mcp-gateway": {
      "type": "sse",
      "httpUrl": "http://localhost:10888/sse?token=${MCP_AUTH_TOKEN}",
      "timeout": 60000
    },
    "atlassian": {
      "type": "sse",
      "httpUrl": "https://mcp.atlassian.com/v1/mcp",
      "timeout": 30000
    }
  },
  "customToolsDirectory": "~/.gemini/user-tools",
  "enableCustomTools": true,
  "general": {
    "previewFeatures": true,
    "sessionRetention": {
      "warningAcknowledged": true,
      "enabled": true,
      "maxAge": "120d"
    }
  },
  "ui": {
    "showMemoryUsage": true,
    "showCitations": true,
    "showModelInfoInChat": true
  },
  "experimental": {
    "plan": true
  }
}
