{
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "privacy": {
    "usageStatisticsEnabled": false
  },
  "mcpServers": {
    "docker-mcp-gateway": {
      "url": "http://127.0.0.1:10888/sse",
      "type": "sse",
      "headers": {
        "Authorization": "Bearer __MCP_GATEWAY_AUTH_TOKEN__"
      },
      "timeout": 30000
    },
    "atlassian": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.atlassian.com/v1/mcp"
      ],
      "env": {
        "PORT": "0"
      }
    }
  },
  "customToolsDirectory": "~/.gemini/user-tools",
  "enableCustomTools": true,
  "general": {
    "previewFeatures": true,
    "sessionRetention": {
      "warningAcknowledged": true,
      "enabled": true,
      "maxAge": "120d"
    }
  },
  "ui": {
    "showMemoryUsage": true,
    "showCitations": true,
    "showModelInfoInChat": true,
    "footer": {
      "items": [
        "workspace",
        "git-branch",
        "sandbox",
        "model-name",
        "quota",
        "context-used",
        "memory-usage",
        "session-id",
        "code-changes",
        "token-count"
      ]
    }
  },
  "experimental": {
    "plan": true
  }
}