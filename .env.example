# Atlassian Config
ATLASSIAN_DOMAIN=your-domain.atlassian.net
ATLASSIAN_EMAIL=your-email@example.com
ATLASSIAN_JIRA_URL=https://your-domain.atlassian.net
ATLASSIAN_JIRA_USERNAME=your-username
ATLASSIAN_JIRA_API_TOKEN=your-atlassian-api-token-here
ATLASSIAN_CONFLUENCE_URL=https://your-domain.atlassian.net/wiki
ATLASSIAN_CONFLUENCE_USERNAME=your-username
ATLASSIAN_CONFLUENCE_API_TOKEN=your-atlassian-api-token-here

# GitHub Config
GH_TOKEN=your-github-token-here
GITHUB_TOKEN=your-github-token-here

# Paths
NEXUS_PATH=$PWD/.nexus
CHRONOS_GRAPH_PATH=$PWD/.nexus/metadata.db

# Project
DOTFILES_AI_REPO_ROOT=$PWD

# MCP Config
MCP_AUTH_TOKEN=your-mcp-auth-token-here
MCP_GATEWAY_AUTH_TOKEN=your-mcp-gateway-auth-token-here
MCP_GATEWAY_TOKEN=your-mcp-gateway-token-here

# ChronosGraph Cloud Mode
OPENAI_API_KEY=your-openai-key-here
POSTGRES_HOST=your-supabase-host-here
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=your-postgres-user-here
POSTGRES_PASSWORD=your-postgres-password-here
POSTGRES_SSLMODE=require
NEO4J_URI=neo4j+s://your-neo4j-uri-here
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password-here
REDIS_URL=rediss://your-redis-url-here
