# ==============================================================================
# .env.example - Dotfiles AI Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in the values:
# cp .env.example .env
# ==============================================================================

# --- MCP (Model Context Protocol) Settings ---
# Tokens for Docker MCP Gateway authentication
MCP_AUTH_TOKEN=your_mcp_auth_token_here
MCP_GATEWAY_AUTH_TOKEN=your_mcp_gateway_auth_token_here
MCP_GATEWAY_TOKEN=your_mcp_gateway_token_here

# --- Atlassian Integration (Jira / Confluence) ---
ATLASSIAN_DOMAIN=https://your-domain.atlassian.net
ATLASSIAN_EMAIL=your-email@example.com

# Jira Settings
ATLASSIAN_JIRA_API_TOKEN=your_jira_api_token_here
ATLASSIAN_JIRA_URL=https://your-domain.atlassian.net
ATLASSIAN_JIRA_USERNAME=your-username

# Confluence Settings
ATLASSIAN_CONFLUENCE_API_TOKEN=your_confluence_api_token_here
ATLASSIAN_CONFLUENCE_URL=https://your-domain.atlassian.net
ATLASSIAN_CONFLUENCE_USERNAME=your-username

# --- Nexus Integration ---
# Path to Nexus executable and storage directory (default: ${HOME}/program/nexus)
# NEXUS_PATH=/path/to/nexus

# --- External API Tokens ---
# GitHub Token for skill installation and repository management
GH_TOKEN=your_github_token_here
GITHUB_TOKEN=your_github_token_here

# Context7 API Key
CONTEXT7_API_KEY=your_context7_api_key_here

# --- Path & Directory Settings ---
# Root directory of this repository (optional, defaults to current dir in some scripts)
# DOTFILES_AI_REPO_ROOT=/path/to/dotfiles-ai

# Codex Home Directory (default: ~/.codex)
# CODEX_HOME=/home/user/.codex

# Claude Configuration Directory
# CLAUDE_CONFIG_DIR=/path/to/claude/config

# --- Brainstorming Skill Settings ---
# BRAINSTORM_PORT=49152
# BRAINSTORM_HOST=127.0.0.1
# BRAINSTORM_URL_HOST=localhost
# BRAINSTORM_DIR=/tmp/brainstorm

# --- Execution & Debug Settings ---
# NODE_ENV=development # options: development, test, production
# SUPERCOPILOT_DEBUG=false
# OPENCODE_RUN=false
# OPENCODE_NON_INTERACTIVE=false
