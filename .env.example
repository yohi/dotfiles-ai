# ==============================================================================
# dotfiles-ai Environment Variables Template
# ==============================================================================
# このファイルは .env のテンプレートです。
# コピーして .env にリネームし、各項目を環境に合わせて設定してください。
# .env は絶対に Git にコミットしないでください。
# ==============================================================================

# --- Core API Keys & Credentials ---
# OS環境変数やキーチェーンから継承するか、個別に設定してください。
# ANTHROPIC_API_KEY=your_key_here
# GITHUB_TOKEN=your_token_here
# BRAVE_API_KEY=your_brave_api_key_here
# TAVILY_API_KEY=your_tavily_api_key_here

# --- Nexus (Vector Storage & Embedding) Settings ---
# STORAGE_BACKEND=postgres
# CACHE_BACKEND=redis
# EMBEDDING_PROVIDER=local-model
# LOCAL_MODEL_NAME=cl-nagoya/ruri-v3-310m
# EMBEDDING_DIMENSION=768
# POSTGRES_HOST=<your_postgres_host>
# POSTGRES_USER=<your_postgres_user>
# POSTGRES_PASSWORD=<your_password>
# POSTGRES_DB=<your_database>
# POSTGRES_PORT=6543
# POSTGRES_SSL=true
# POSTGRES_SSL_NO_VERIFY=true

# --- Chronos Graph Settings ---
# GRAPH_ENABLED=true
# NEO4J_URI=neo4j+s://<your_neo4j_host>
# NEO4J_USER=<your_neo4j_user>
# NEO4J_PASSWORD=<your_password>
# REDIS_URL=rediss://default:<your_password>@<your_redis_host>:6379
# REDIS_SSL=true
# DECAY_HALF_LIFE_DAYS=30
# ARCHIVE_THRESHOLD=0.1
# PURGE_RETENTION_DAYS=90
# DEFAULT_TOP_K=10
# SIMILARITY_THRESHOLD=0.70
# DEDUP_THRESHOLD=0.90
# DASHBOARD_PORT=8501

# --- MCP Gateway Settings ---
# MCP_GATEWAY_TOKEN=your_token_here
# MCP_GATEWAY_AUTH_TOKEN=your_token_here
# MCP_AUTH_TOKEN=your_mcp_auth_token_here

# --- Nexus Embedding Settings (OpenAI-Compat API) ---
# NEXUS_EMBEDDING_PROVIDER="openai-compat"
# NEXUS_EMBEDDING_MODEL="gemini-embedding-001"
# NEXUS_EMBEDDING_DIMENSIONS=768
# NEXUS_EMBEDDING_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# NEXUS_EMBEDDING_API_KEY="your_api_key_here"

# --- Cloudflare Settings ---
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
# CLOUDFLARE_ACCOUNT_ID=your-32-character-account-id
# CLOUDFLARE_GATEWAY_ID=your-gateway-id

# --- Atlassian Secrets (Personal) ---
# ATLASSIAN_API_TOKEN=your-atlassian-api-token-here
# ATLASSIAN_DOMAIN=https://your-domain.atlassian.net
# ATLASSIAN_EMAIL=your-email@example.com
# ATLASSIAN_JIRA_URL=https://your-domain.atlassian.net
# ATLASSIAN_JIRA_USERNAME=your-email@example.com
# ATLASSIAN_CONFLUENCE_URL=https://your-domain.atlassian.net
# ATLASSIAN_CONFLUENCE_USERNAME=your-email@example.com
# ATLASSIAN_AUTH_HEADER (Automatically generated by make if EMAIL & API_TOKEN are set)
# ATLASSIAN_AUTH_HEADER=

# --- External MCP Integration Settings (SonarQube, Semgrep, Greptile) ---
# GREPTILE_API_KEY=your_greptile_api_key_here
# SEMGREP_APP_TOKEN=your_semgrep_app_token_here
# SONARQUBE_TOKEN=your_sonarqube_token_here
# SONARQUBE_URL=https://your-sonarqube-instance.com
# SONARQUBE_ORG=your_organization_key_if_using_sonarcloud
