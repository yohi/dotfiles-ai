# Atlassian Config
ATLASSIAN_DOMAIN=your-domain.atlassian.net
ATLASSIAN_EMAIL=your-email@example.com
ATLASSIAN_JIRA_URL=https://your-domain.atlassian.net
ATLASSIAN_JIRA_USERNAME=your-username
ATLASSIAN_JIRA_API_TOKEN=your-atlassian-api-token-here
ATLASSIAN_CONFLUENCE_URL=https://your-domain.atlassian.net/wiki
ATLASSIAN_CONFLUENCE_USERNAME=your-username
ATLASSIAN_CONFLUENCE_API_TOKEN=your-atlassian-api-token-here

# GitHub Config
GH_TOKEN=your-github-token-here
GITHUB_TOKEN=your-github-token-here

# Paths
NEXUS_PATH=/home/y_ohi/dotfiles/components/dotfiles-ai/.nexus
CHRONOS_GRAPH_PATH=/home/y_ohi/dotfiles/components/dotfiles-ai/.nexus/metadata.db

# Project
DOTFILES_AI_REPO_ROOT=/home/y_ohi/dotfiles/components/dotfiles-ai

# MCP Config
MCP_AUTH_TOKEN=your-mcp-auth-token-here
MCP_GATEWAY_AUTH_TOKEN=your-mcp-gateway-auth-token-here
