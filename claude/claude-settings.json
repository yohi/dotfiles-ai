{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "alwaysThinkingEnabled": false,
  "output_language": "ja",
  "opt_out": true,
  "mcpServers": {
    "docker-mcp-gateway": {
      "command": "docker",
      "args": [
        "mcp",
        "gateway",
        "run",
        "--transport",
        "stdio",
        "--enable-all-servers"
      ]
    }
  }
}
