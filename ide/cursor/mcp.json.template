{
  "mcpServers": {
    "docker-mcp-gateway": {
      "command": "docker",
      "args": [
        "mcp",
        "gateway",
        "run",
        "--catalog",
        "${HOME}/.docker/mcp/catalogs/bootstrap.yaml",
        "--catalog",
        "${HOME}/.docker/mcp/catalogs/custom.yaml"
      ]
    }
  }
}
