{
  "mcpServers": {
    "docker-mcp-gateway": {
      "url": "http://127.0.0.1:10888/sse"
    },
    "chronos-graph": {
      "command": "uv",
      "args": [
        "--quiet",
        "tool",
        "run",
        "--from",
        "git+https://github.com/yohi/chronos-graph.git@37308f47837469d801abc1226ee65e4262093042",
        "context-store"
      ],
      "env": {
        "STORAGE_BACKEND": "sqlite",
        "SQLITE_DB_PATH": "__HOME__/.context-store/memories.db",
        "GRAPH_ENABLED": "true"
      }
    }
  }
}
